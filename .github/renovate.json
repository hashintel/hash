{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>hashintel/actions:renovate-config"],
  "description": "HASH public monorepo (hashintel/hash) Renovate configuration",
  "dependencyDashboardOSVVulnerabilitySummary": "none",
  "packageRules": [
    {
      "matchManagers": ["cargo"],
      "matchFileNames": ["libs/error-stack/Cargo.toml"],
      "matchPackageNames": ["anyhow"],
      "enabled": false
    },
    {
      "description": "Open mise bump PRs without requiring dependency-dashboard approval",
      "matchDepNames": ["jdx/mise"],
      "dependencyDashboardApproval": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update mise version pins annotated with a `# renovate:` comment (mise-action `version` input, mise `min_version`)",
      "managerFilePatterns": [
        ".github/actions/install-tools/action.yml",
        ".config/mise/config.toml"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>[^\\s]+)\\n\\s*(?:min_)?version\\s*[:=]\\s*\"?(?<currentValue>[0-9][^\\s\"]*)\"?"
      ],
      "extractVersionTemplate": "^v(?<version>.+)$"
    },
    {
      "customType": "regex",
      "description": "Update the MISE_VERSION pin annotated with a `# renovate:` comment in the mise install script",
      "managerFilePatterns": [".config/mise/install.sh"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>[^\\s]+)\\n\\s*(?:export )?MISE_VERSION=(?<currentValue>[0-9][^\\s]*)\\s"
      ],
      "extractVersionTemplate": "^v(?<version>.+)$"
    }
  ]
}
