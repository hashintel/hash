{
  "$schema": "../../node_modules/oxlint/configuration_schema.json",
  "jsPlugins": ["./react-compiler-plugin.mjs"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "error",
    "react-compiler/static-components": "warn",
    "react-compiler/use-memo": "warn",
    "react-compiler/void-use-memo": "warn",
    "react-compiler/component-hook-factories": "warn",
    "react-compiler/preserve-manual-memoization": "warn",
    "react-compiler/incompatible-library": "warn",
    "react-compiler/immutability": "warn",
    "react-compiler/globals": "warn",
    "react-compiler/refs": "warn",
    "react-compiler/set-state-in-effect": "warn",
    "react-compiler/error-boundaries": "warn",
    "react-compiler/purity": "warn",
    "react-compiler/set-state-in-render": "warn",
    "react-compiler/unsupported-syntax": "warn",
    "react-compiler/config": "warn",
    "react-compiler/gating": "warn",
    "react-compiler/todo": "error",
    "react-compiler/uncategorized": "warn"
  }
}
