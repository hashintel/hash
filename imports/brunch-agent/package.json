{
  "name": "brunch-lite",
  "private": true,
  "type": "module",
  "description": "Elicitation harness — agentic interviewing against pluggable elicitation targets",
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "lint": "oxlint --fix --deny-warnings .",
    "lint:check": "oxlint --deny-warnings .",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "linear:graph": "bun scripts/linear-project-graph.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "bun test",
    "build": "bun run --filter '@brunch/*' build",
    "smoke": "bun run lint:check && bun run fmt:check && bun run typecheck && bun test"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.116.0",
    "@types/bun": "^1.3.0",
    "oxfmt": "^0.5.0",
    "oxlint": "^1.42.0",
    "typescript": "^5.9.0",
    "vite": "^8"
  }
}
