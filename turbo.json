{
  "$schema": "https://turborepo.org/schema.json",
  "tasks": {
    // A task nothing implements, so depending on it runs nothing. Its hash still covers the
    // package's inputs, and the chain over `^manifest` carries those of every transitive
    // dependency, which is what a task needs from a crate it reads sources from rather than
    // artifacts.
    "manifest": {
      "dependsOn": ["^manifest"]
    },
    // Development commands
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["codegen"]
    },
    // Build commands
    "codegen": {
      "dependsOn": ["^build"]
    },
    "doc:dependency-diagram": {
      "cache": false,
      "dependsOn": ["@rust/hash-repo-chores#build"]
    },
    "//#sync:turborepo": {
      "cache": false
    },
    "//#doc:task-dependencies": {
      "cache": false,
      "dependsOn": ["//#sync:turborepo"]
    },
    "build": {
      "dependsOn": ["codegen"]
    },
    "build:docker": {
      "cache": false
    },
    "build:codspeed": {
      "cache": false
    },
    "compile": {
      "cache": false
    },
    "compile:release": {
      "cache": false
    },
    // Run commands
    "start:migrate": {
      "cache": false,
      "dependsOn": ["build", "^start:healthcheck"]
    },
    "start": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["start:migrate"]
    },
    "start:healthcheck": {
      "cache": false,
      "dependsOn": ["compile:release"]
    },
    "start:test:migrate": {
      "cache": false,
      "dependsOn": ["build", "^start:test:healthcheck"]
    },
    "start:test": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["start:test:migrate"]
    },
    "start:test:healthcheck": {
      "cache": false,
      "dependsOn": ["compile"]
    },
    // Test commands
    "test:unit": {
      "dependsOn": ["codegen", "^build"],
      "env": ["TEST_COVERAGE"]
    },
    "test:integration": {
      "dependsOn": ["codegen", "^start:test:healthcheck"],
      "env": ["TEST_COVERAGE"]
    },
    "test:codspeed": {
      "cache": false
    },
    "test:miri": {},
    // Benchmarks
    "bench:unit": {
      "dependsOn": ["codegen"],
      "cache": false
    },
    "bench:integration": {
      "dependsOn": ["codegen", "^start:healthcheck"],
      "cache": false
    },
    // Linting and formatting
    "lint": {
      "dependsOn": ["codegen"]
    },
    // The clippy invocation differs between pull requests (`--all-features`) and other runs
    // such as the merge queue (`cargo hack --feature-powerset`), selected via
    // `GITHUB_EVENT_NAME` in the `.justfile`. Include it in the hash so the two run modes
    // cannot share caches.
    "lint:clippy": {
      "env": ["GITHUB_EVENT_NAME"]
    },
    "lint:eslint": {
      "env": ["CHECK_TEMPORARILY_DISABLED_RULES"],
      "dependsOn": ["codegen", "@local/eslint#build"]
    },
    "lint:tsc": {
      "dependsOn": ["codegen"]
    },
    // Python linting and type checking. `uv run` syncs the package's
    // environment from its own lockfile, so neither needs a prior task.
    "lint:ruff": {},
    "lint:types": {},
    "fix:eslint": {
      "dependsOn": ["codegen", "@local/eslint#build"]
    },
    "fix:clippy": {},
    "sentry:sourcemaps": {
      "dependsOn": ["build"]
    }
  },
  "globalDependencies": [
    // Changing any `turbo.json` file will trigger a full rebuild
    "**/turbo.json",
    // Changing workflows should trigger a full rebuild so it's checked in CI
    ".github/actions/**",
    ".github/scripts/**",
    ".github/workflows/**",
    // Dot-files
    ".*",
    ".cargo/**",
    ".config/**",
    ".yarn/**",
    // Manifest files
    "*.lock",
    ".config/mise/**",
    "Cargo.toml",
    "package.json",
    "pyproject.toml",
    "rust-toolchain.toml",
    "yarn*"
  ],
  "globalPassThroughEnv": [
    "CARGO_TERM_PROGRESS_WHEN",
    "RUSTC_WRAPPER",
    "CARGO_INCREMENTAL"
  ]
}
