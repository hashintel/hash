{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "extends": ["../../.config/oxlint/brunch/react.json"],
  "categories": {
    "correctness": "error",
    "perf": "warn"
  },
  "env": {
    "builtin": true,
    "es2026": true,
    "browser": true,
    "node": true
  },
  "options": {
    "typeAware": true,
    "typeCheck": true
  },
  "rules": {
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "regex": "^(\\.\\./)+((apps|libs|tests|@[a-z0-9-]+)/|[^./][^/]*/(src|dist|test)/)",
            "message": "Import another workspace package by its package name, not a relative path into it."
          }
        ]
      }
    ]
  }
}
