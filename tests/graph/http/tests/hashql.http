# This file either runs with JetBrains' http requests or using httpYac (https://httpyac.github.io).
#
# Requires a running Kratos (public API on 4433, admin API on 4434) next to the Graph.

### Seed default policies
GET http://127.0.0.1:4000/policies/seed
Content-Type: application/json

> {%
  client.test("status", function() {
    client.assert(response.status === 204, "Response status is not 204");
  });
%}

### Get system user
GET http://127.0.0.1:4000/actors/machine/identifier/system/h
Content-Type: application/json

> {%
  client.test("status", function() {
    client.assert(response.status === 200, "Response status is not 200");
  });
  client.global.set("system_machine_id", response.body);
%}

### Create account
POST http://127.0.0.1:4000/actors/user
Content-Type: application/json
X-Authenticated-User-Actor-Id: {{system_machine_id}}

{
  "shortname": "alice",
  "registrationComplete": true
}

> {%
  client.test("status", function() {
    client.assert(response.status === 200, "Response status is not 200");
  });
  client.global.set("user_id", response.body.userId);
%}

### Create a Kratos identity provisioned for the account
POST http://127.0.0.1:4434/admin/identities
Content-Type: application/json

{
  "schema_id": "default",
  "traits": {
    "emails": ["hashql-{{$uuid}}@example.com"]
  },
  "metadata_public": {
    "graph_actor_id": "{{user_id}}"
  },
  "credentials": {
    "password": {
      "config": {
        "password": "hashql-test-pw!"
      }
    }
  }
}

> {%
  client.test("status", function() {
    client.assert(response.status === 201, "Response status is not 201");
  });
  client.global.set("session_email", response.body.traits.emails[0]);
%}

### Create a login flow
GET http://127.0.0.1:4433/self-service/login/api
Content-Type: application/json

> {%
  client.test("status", function() {
    client.assert(response.status === 200, "Response status is not 200");
  });
  client.global.set("login_flow_id", response.body.id);
%}

### Log in to obtain a session token
POST http://127.0.0.1:4433/self-service/login?flow={{login_flow_id}}
Content-Type: application/json

{
  "method": "password",
  "identifier": "{{session_email}}",
  "password": "hashql-test-pw!"
}

> {%
  client.test("status", function() {
    client.assert(response.status === 200, "Response status is not 200");
  });
  client.global.set("session_token", response.body.session_token);
%}

### HashQL without credentials is rejected
POST http://127.0.0.1:4000/_api/hashql
Content-Type: application/json
Authorization: <omit>

{}

> {%
  client.test("status", function() {
    client.assert(response.status === 401, "Response status is not 401");
  });
%}

### HashQL: filter-false returns empty list
POST http://127.0.0.1:4000/_api/hashql
Content-Type: application/json
Authorization: <omit>
X-Session-Token: {{session_token}}

{
  "query": ["let", "axes",
    ["::graph::temporal::PinnedTransactionTimeTemporalAxes",
      {"#struct": {
        "pinned": ["::graph::temporal::TransactionTime",
          ["::graph::temporal::Timestamp", {"#literal": 4102444800000}]
        ],
        "variable": ["::graph::temporal::DecisionTime",
          ["::graph::temporal::Interval", {"#struct": {
            "start": ["::graph::temporal::UnboundedTemporalBound"],
            "end": ["::graph::temporal::ExclusiveTemporalBound",
              ["::graph::temporal::Timestamp", {"#literal": 4102444800000}]
            ]
          }}]
        ]
      }}
    ],
    ["::graph::tail::collect",
      ["::graph::body::filter",
        ["::graph::head::entities", "axes"],
        ["fn", {"#tuple": []}, {"#struct": {"vertex": "_"}}, "_",
          {"#literal": false}
        ]
      ]
    ]
  ],
  "inputs": {}
}

> {%
  client.test("status", function() {
    client.assert(response.status === 200, "Response status is not 200");
  });
  client.test("empty list", function() {
    client.assert(response.body.value !== undefined, "Expected 'value' field");
    client.assert(response.body.value.List !== undefined, "Expected 'List' in value");
    client.assert(response.body.value.List.length === 0, "Expected empty list for filter-false");
    client.assert(response.body.advisories !== undefined, "Expected 'advisories' field");
  });
%}

### HashQL: parse error returns 400 with diagnostics
POST http://127.0.0.1:4000/_api/hashql
Content-Type: application/json
Authorization: <omit>
X-Session-Token: {{session_token}}

{
  "query": {"not": "a valid query"},
  "inputs": {}
}

> {%
  client.test("status", function() {
    client.assert(response.status === 400, "Expected 400 for invalid query");
  });
  client.test("problem details", function() {
    var contentType = response.headers.valueOf("content-type");
    client.assert(contentType.includes("application/problem+json"), "Expected problem details, got: " + contentType);
  });
  client.test("has diagnostic", function() {
    client.assert(Array.isArray(response.body.diagnostics), "Expected diagnostics");
    client.assert(response.body.diagnostics[0].category !== undefined, "Expected diagnostic category");
  });
%}

### HashQL: an input takes its value from the request
POST http://127.0.0.1:4000/_api/hashql
Content-Type: application/json
Authorization: <omit>
X-Session-Token: {{session_token}}

{
  "query": ["input", "limit", "Integer"],
  "inputs": {"limit": {"#literal": 3}}
}

> {%
  client.test("status", function() {
    client.assert(response.status === 200, "Response status is not 200");
  });
  client.test("value", function() {
    client.assert(response.body.value !== undefined, "Expected 'value' field");
  });
%}

### HashQL: a value of another type than its input returns 400 with diagnostics
POST http://127.0.0.1:4000/_api/hashql
Content-Type: application/json
Authorization: <omit>
X-Session-Token: {{session_token}}

{
  "query": ["input", "limit", "Integer"],
  "inputs": {"limit": {"#literal": "three"}}
}

> {%
  client.test("status", function() {
    client.assert(response.status === 400, "Expected 400 for a mistyped value");
  });
  client.test("span names the input", function() {
    var span = response.body.diagnostics[0].labels.labels[0].span;
    client.assert(span.location === "inputs.limit", "Expected the span to name the input, got: " + span.location);
  });
%}

### HashQL: json-compat wraps result in envelope with advisories
POST http://127.0.0.1:4000/_api/hashql
Content-Type: application/json
Authorization: <omit>
X-Session-Token: {{session_token}}
Json-Compat: true

{
  "query": ["let", "axes",
    ["::graph::temporal::PinnedTransactionTimeTemporalAxes",
      {"#struct": {
        "pinned": ["::graph::temporal::TransactionTime",
          ["::graph::temporal::Timestamp", {"#literal": 4102444800000}]
        ],
        "variable": ["::graph::temporal::DecisionTime",
          ["::graph::temporal::Interval", {"#struct": {
            "start": ["::graph::temporal::UnboundedTemporalBound"],
            "end": ["::graph::temporal::ExclusiveTemporalBound",
              ["::graph::temporal::Timestamp", {"#literal": 4102444800000}]
            ]
          }}]
        ]
      }}
    ],
    ["::graph::tail::collect",
      ["::graph::body::filter",
        ["::graph::head::entities", "axes"],
        ["fn", {"#tuple": []}, {"#struct": {"vertex": "_"}}, "_",
          {"#literal": false}
        ]
      ]
    ]
  ],
  "inputs": {}
}

> {%
  client.test("status", function() {
    client.assert(response.status === 200, "Response status is not 200");
  });
  client.test("envelope shape", function() {
    client.assert(response.body.value !== undefined, "Expected 'value' field in envelope");
    client.assert(response.body.advisories !== undefined, "Expected 'advisories' field in envelope");
    client.assert(Array.isArray(response.body.value), "Expected value to be an array");
    client.assert(response.body.value.length === 0, "Expected empty list for filter-false");
  });
%}

### HashQL: interactive header returns HTML on error
POST http://127.0.0.1:4000/_api/hashql
Content-Type: application/json
Authorization: <omit>
X-Session-Token: {{session_token}}
Interactive: true

{
  "query": {"not": "a valid query"},
  "inputs": {}
}

> {%
  client.test("status", function() {
    client.assert(response.status === 400, "Expected 400 for invalid query");
  });
  client.test("html response", function() {
    var contentType = response.headers.valueOf("content-type");
    client.assert(contentType.includes("text/html"), "Expected HTML content type, got: " + contentType);
  });
%}
