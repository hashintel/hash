{
  "package": "@rust/hash-graph-benches",
  "dependencies": [
    "@apps/hash-graph",
    "@blockprotocol/type-system-rs",
    "@rust/error-stack",
    "@rust/hash-graph-api",
    "@rust/hash-graph-authorization",
    "@rust/hash-graph-postgres-store",
    "@rust/hash-graph-store",
    "@rust/hash-graph-temporal-versioning",
    "@rust/hash-graph-test-data",
    "@rust/hash-graph-type-fetcher",
    "@rust/hash-repo-chores",
    "@rust/hash-telemetry"
  ],
  "tasks": {
    "bench:integration": {
      "dependsOn": [
        "@apps/hash-graph#start:healthcheck"
      ],
      "cache": false
    },
    "fix:clippy": {
      "dependsOn": []
    },
    "lint:clippy": {
      "dependsOn": [],
      "env": [
        "GITHUB_EVENT_NAME"
      ]
    },
    "test:integration": {
      "dependsOn": [
        "@apps/hash-graph#start:test:healthcheck"
      ],
      "env": [
        "TEST_COVERAGE"
      ]
    }
  }
}
