{
  "package": "hash-graph-benches",
  "dependencies": [
    "error-stack",
    "hash-graph-api",
    "hash-graph-authorization",
    "hash-graph-postgres-store",
    "hash-graph-store",
    "hash-graph-temporal-versioning",
    "hash-graph-test-data",
    "hash-graph-type-fetcher",
    "hash-repo-chores",
    "hash-telemetry",
    "type-system"
  ],
  "tasks": {
    "bench:integration": {
      "dependsOn": [
        "hash-graph#start:healthcheck"
      ],
      "cache": false,
      "affectedBy": [
        "darwin-kperf-codegen",
        "error-stack-macros",
        "hash-graph"
      ]
    },
    "bench:integration:manual": {
      "dependsOn": [],
      "cache": false
    },
    "fix:clippy": {
      "dependsOn": []
    },
    "lint:clippy": {
      "dependsOn": [],
      "env": [
        "GITHUB_EVENT_NAME"
      ],
      "affectedBy": [
        "darwin-kperf-codegen",
        "error-stack-macros"
      ]
    },
    "test:integration": {
      "dependsOn": [
        "hash-graph#start:test:healthcheck"
      ],
      "env": [
        "TEST_COVERAGE"
      ],
      "affectedBy": [
        "darwin-kperf-codegen",
        "error-stack-macros",
        "hash-graph"
      ]
    },
    "test:integration:manual": {
      "dependsOn": [],
      "cache": false
    }
  }
}
