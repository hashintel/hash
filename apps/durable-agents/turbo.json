{
  "extends": ["//"],
  "tasks": {
    "start": {
      "passThroughEnv": [
        "PORT",
        "DURABLE_AGENTS_TRUST_PROXY",
        "API_ORIGIN",
        "BRUNCH_HASH_CORS_ALLOWED_ORIGINS",
        "DURABLE_AGENTS_MODEL",
        "OPENAI_API_KEY",
        "ANTHROPIC_API_KEY",
        "DURABLE_AGENTS_MAX_TURNS",
        "DURABLE_AGENTS_MAX_CONCURRENT_REQUESTS",
        "DURABLE_AGENTS_ABANDONED_TURN_MS",
        "DURABLE_AGENTS_CRASH_LOOP_RESTARTS",
        "DURABLE_AGENTS_PG_POOL_MAX",
        "DURABLE_AGENTS_PG_POOL_WAIT_MS",
        "DURABLE_AGENTS_POSTGRES_HOST",
        "DURABLE_AGENTS_POSTGRES_PORT",
        "DURABLE_AGENTS_POSTGRES_USER",
        "DURABLE_AGENTS_POSTGRES_PASSWORD",
        "DURABLE_AGENTS_POSTGRES_DATABASE",
        "POSTGRES_PORT",
        "POSTGRES_USER",
        "POSTGRES_PASSWORD"
      ]
    },
    "test:integration": {
      "dependsOn": ["^build"],
      "passThroughEnv": [
        "DURABLE_AGENTS_POSTGRES_HOST",
        "DURABLE_AGENTS_POSTGRES_PORT",
        "DURABLE_AGENTS_POSTGRES_USER",
        "DURABLE_AGENTS_POSTGRES_PASSWORD",
        "DURABLE_AGENTS_POSTGRES_DATABASE",
        "POSTGRES_PORT",
        "POSTGRES_USER",
        "POSTGRES_PASSWORD"
      ]
    },
    "test:unit": {
      "dependsOn": ["^build"],
      "env": ["TEST_COVERAGE"]
    },
    "proof:restart-turn": {
      "dependsOn": ["^build"],
      "cache": false,
      "passThroughEnv": [
        "DURABLE_AGENTS_POSTGRES_HOST",
        "DURABLE_AGENTS_POSTGRES_PORT",
        "DURABLE_AGENTS_POSTGRES_USER",
        "DURABLE_AGENTS_POSTGRES_PASSWORD",
        "DURABLE_AGENTS_POSTGRES_DATABASE",
        "POSTGRES_PORT",
        "POSTGRES_USER",
        "POSTGRES_PASSWORD"
      ]
    },
    "proof:browser-call": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "probe:async-browser-call": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "probe:hash-session": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "probe:postgres-viewer": {
      "dependsOn": ["^build"],
      "cache": false,
      "passThroughEnv": [
        "DURABLE_AGENTS_POSTGRES_HOST",
        "DURABLE_AGENTS_POSTGRES_PORT",
        "DURABLE_AGENTS_POSTGRES_USER",
        "DURABLE_AGENTS_POSTGRES_PASSWORD",
        "DURABLE_AGENTS_POSTGRES_DATABASE",
        "POSTGRES_PORT",
        "POSTGRES_USER",
        "POSTGRES_PASSWORD"
      ]
    },
    "probe:load": {
      "dependsOn": ["^build"],
      "cache": false,
      "passThroughEnv": [
        "DURABLE_AGENTS_POSTGRES_HOST",
        "DURABLE_AGENTS_POSTGRES_PORT",
        "DURABLE_AGENTS_POSTGRES_USER",
        "DURABLE_AGENTS_POSTGRES_PASSWORD",
        "DURABLE_AGENTS_POSTGRES_DATABASE",
        "POSTGRES_PORT",
        "POSTGRES_USER",
        "POSTGRES_PASSWORD"
      ]
    },
    "probe:ownership-unit": {
      "dependsOn": ["^build"],
      "cache": false,
      "passThroughEnv": [
        "DURABLE_AGENTS_POSTGRES_HOST",
        "DURABLE_AGENTS_POSTGRES_PORT",
        "DURABLE_AGENTS_POSTGRES_USER",
        "DURABLE_AGENTS_POSTGRES_PASSWORD",
        "DURABLE_AGENTS_POSTGRES_DATABASE",
        "POSTGRES_PORT",
        "POSTGRES_USER",
        "POSTGRES_PASSWORD"
      ]
    },
    "probe:two-writers": {
      "dependsOn": ["^build"],
      "cache": false,
      "passThroughEnv": [
        "DURABLE_AGENTS_POSTGRES_HOST",
        "DURABLE_AGENTS_POSTGRES_PORT",
        "DURABLE_AGENTS_POSTGRES_USER",
        "DURABLE_AGENTS_POSTGRES_PASSWORD",
        "DURABLE_AGENTS_POSTGRES_DATABASE",
        "POSTGRES_PORT",
        "POSTGRES_USER",
        "POSTGRES_PASSWORD"
      ]
    }
  }
}
