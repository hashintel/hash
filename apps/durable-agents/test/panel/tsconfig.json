  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "noImplicitReturns": false,
    "rootDir": "../../../.."
  },
  "include": [
    ".",
    "../../../../libs/@hashintel/brunch-agent/src/ui/markdown-raw.d.ts"
  ],
  "exclude": []
}
