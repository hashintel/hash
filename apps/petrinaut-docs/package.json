{
  "name": "@apps/petrinaut-docs",
  "version": "0.0.0-private",
  "private": true,
  "description": "Builds and serves the Petrinaut architecture docs with archinaut; the Vercel project for docs.petrinaut.org",
  "license": "(MIT OR Apache-2.0)",
  "type": "module",
  "scripts": {
    "build": "archinaut build --config ../../libs/@local/petrinaut-arch-docs/archinaut.config.ts --out dist",
    "dev": "archinaut dev --config ../../libs/@local/petrinaut-arch-docs/archinaut.config.ts --port ${PORT:-4322}"
  },
  "devDependencies": {
    "@local/archinaut": "workspace:*",
    "@local/petrinaut-arch-docs": "workspace:*"
  },
  "engines": {
    "node": "22.x"
  }
}
