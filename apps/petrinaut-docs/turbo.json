{
  "extends": ["//"],
  "tasks": {
    // Copies the bundle into `src/content/`. Generating it is the generator's
    // job, declared here as a dependency so Turborepo orders the two — the sync
    // script used to shell out and run the generator itself, which put a
    // cross-package build step outside the task graph.
    "sync:bundle": {
      "cache": false,
      "dependsOn": ["@local/petrinaut-arch-docs#doc:architecture"]
    },
    // `build`, `lint:tsc` and `dev` all need the synced content. Depending on one
    // shared `sync:bundle` rather than each running it keeps them from racing on
    // the same directories when Turborepo runs them concurrently.
    "build": {
      "dependsOn": ["sync:bundle", "@local/petrinaut-arch-docs#doc:architecture"],
      // `astro build` also writes the gitignored `.astro/` sync directory, which
      // `lint:tsc` (`astro check`) reads.
      "outputs": ["dist/**", ".astro/**"],
      // `astro.config.mjs` derives a diff context from these and inlines it into
      // the pages as `__PND_DIFF_COMPARE__`, so a `dist` built for one preview
      // must never be restored for another. Mirrors the list in
      // `src/diff-context.ts`; keep the two identical.
      //
      // `src/diff-context.ts` also asks api.github.com whether the base ref has
      // an open pull request, which no hash can cover. That call is reached only
      // on a diff build — `manifest.diff` is set only when
      // PETRINAUT_ARCH_DOCS_DIFF_BASE is — where VERCEL_GIT_COMMIT_SHA is in the
      // hash and so every commit builds fresh. The most a hit can carry over is
      // a header badge naming a branch where a pull request has since opened.
      // The `git rev-parse` fallback beside it runs only when the VERCEL_GIT_*
      // pair is unset, which a deployed diff build never is.
      "env": [
        "PETRINAUT_ARCH_DOCS_DIFF_BASE",
        "VERCEL_GIT_COMMIT_REF",
        "VERCEL_GIT_COMMIT_SHA",
        "VERCEL_GIT_PULL_REQUEST_ID",
        "VERCEL_GIT_REPO_OWNER",
        "VERCEL_GIT_REPO_SLUG"
      ],
      // The build consumes the architecture bundle, which is generated and
      // gitignored, so it is hashed through the generating task's outputs
      // rather than as files in this package.
      "inputs": [
        "$TURBO_DEFAULT$",
        {
          "mode": "dependencyOutputs",
          "globs": ["bundle/**"],
          "from": ["@local/petrinaut-arch-docs#doc:architecture"]
        }
      ]
    },
    "lint:tsc": {
      "cache": false,
      "dependsOn": ["sync:bundle"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["sync:bundle"],
      // The Claude Code preview passes the port to serve on.
      "env": ["PORT"]
    }
  }
}
