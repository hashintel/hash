{
  "extends": ["@tsconfig/bases/node22", "@local/tsconfig/policy.json"],
  "compilerOptions": {
    "isolatedModules": true,
    "jsx": "react-jsx",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "noEmit": true,
    // The components import their stylesheets, which the site's Vite resolves.
    "noUncheckedSideEffectImports": false
  },
  "include": ["archinaut.config.ts", "content/components"]
}
