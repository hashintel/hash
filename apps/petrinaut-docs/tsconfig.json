{
  // The components run in a browser: no Node types. What runs in Node is
  // checked by `tsconfig.node.json`.
  "extends": "@local/tsconfig/policy.json",
  "compilerOptions": {
    "isolatedModules": true,
    "jsx": "react-jsx",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "types": []
  },
  "include": ["content/components", "stylesheets.d.ts"],
  "exclude": ["content/components/**/*.test.ts"]
}
