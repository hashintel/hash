{
  "package": "@apps/petrinaut-docs",
  "dependencies": [
    "@local/petrinaut-arch-docs"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "sync:bundle"
      ],
      "cache": false,
      "affectedBy": [
        "petrinaut-optimization",
        "petrinaut-optimizer-core",
        "petrinaut-python"
      ]
    },
    "dev": {
      "dependsOn": [
        "sync:bundle"
      ],
      "cache": false,
      "persistent": true,
      "env": [
        "PORT"
      ],
      "affectedBy": [
        "petrinaut-optimization",
        "petrinaut-optimizer-core",
        "petrinaut-python"
      ]
    },
    "lint:tsc": {
      "dependsOn": [
        "sync:bundle"
      ],
      "cache": false,
      "affectedBy": [
        "petrinaut-optimization",
        "petrinaut-optimizer-core",
        "petrinaut-python"
      ]
    },
    "sync:bundle": {
      "dependsOn": [
        "@local/petrinaut-arch-docs#doc:architecture"
      ],
      "cache": false,
      "affectedBy": [
        "petrinaut-optimization",
        "petrinaut-optimizer-core",
        "petrinaut-python"
      ]
    }
  }
}
