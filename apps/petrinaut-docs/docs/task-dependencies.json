{
  "package": "@apps/petrinaut-docs",
  "dependencies": [
    "@apps/petrinaut-website",
    "@hashintel/petrinaut",
    "@hashintel/petrinaut-cli",
    "@hashintel/petrinaut-core",
    "@local/archinaut",
    "@local/tsconfig"
  ],
  "tasks": {
    "build": {
      "dependsOn": [],
      "cache": false,
      "env": [
        "ARCHINAUT_CACHE_DIR",
        "ARCHINAUT_DIFF_BASE",
        "ARCHINAUT_SOURCE_REF",
        "GITHUB_HEAD_REF",
        "GITHUB_REF_NAME",
        "GITHUB_SHA",
        "VERCEL_GIT_COMMIT_REF",
        "VERCEL_GIT_COMMIT_SHA",
        "VERCEL_GIT_PULL_REQUEST_ID",
        "VERCEL_GIT_REPO_OWNER",
        "VERCEL_GIT_REPO_SLUG"
      ],
      "affectedBy": [
        "petrinaut-optimization",
        "petrinaut-optimizer-core",
        "petrinaut-python"
      ]
    },
    "dev": {
      "dependsOn": [],
      "cache": false,
      "persistent": true,
      "env": [
        "PORT"
      ]
    },
    "doc:architecture": {
      "dependsOn": [],
      "cache": false,
      "env": [
        "ARCHINAUT_CACHE_DIR",
        "ARCHINAUT_DIFF_BASE",
        "ARCHINAUT_SOURCE_REF",
        "GITHUB_HEAD_REF",
        "GITHUB_REF_NAME",
        "GITHUB_SHA",
        "VERCEL_GIT_COMMIT_REF",
        "VERCEL_GIT_COMMIT_SHA",
        "VERCEL_GIT_REPO_OWNER",
        "VERCEL_GIT_REPO_SLUG"
      ],
      "affectedBy": [
        "petrinaut-optimization",
        "petrinaut-optimizer-core",
        "petrinaut-python"
      ]
    },
    "lint:arch-docs": {
      "dependsOn": [],
      "cache": false,
      "affectedBy": [
        "petrinaut-optimization",
        "petrinaut-optimizer-core",
        "petrinaut-python"
      ]
    },
    "lint:tsc": {
      "dependsOn": [
        "@apps/petrinaut-website#build",
        "@hashintel/petrinaut#build",
        "@hashintel/petrinaut-cli#build",
        "@hashintel/petrinaut-core#build"
      ],
      "affectedBy": [
        "petrinaut-optimization",
        "petrinaut-optimizer-core",
        "petrinaut-python"
      ]
    }
  }
}
