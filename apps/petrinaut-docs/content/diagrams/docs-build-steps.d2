# Hand-written; rendered by the arch-docs build. Its colours are ones
# libs/@local/archinaut/src/bundle/shared/palette.ts themes for dark mode.
# Its step classes play it on the page; see "Stepping a figure" in
# maintaining/declaring-layers.mdx.
direction: right

packages: "annotated packages" {style.fill: "#f2f2f2"; style.stroke: "#777777"}
generator: "generator" {class: at-1; style.fill: "#fdeedc"; style.stroke: "#b5762f"}
bundle: "bundle\npages, diagrams, model" {class: at-2; style.fill: "#dcecff"; style.stroke: "#3676b8"}
site: "site" {class: at-3; style.fill: "#dcecff"; style.stroke: "#3676b8"}

packages -> generator: annotations and imports
generator -> bundle
bundle -> site: {class: token-4}
