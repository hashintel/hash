# Hand-written; rendered by the arch-docs build. The editor's parts use the
# purple palette, the core the blue one, the host the grey one.
direction: down

host: "Host application\nhandle, plugins, navigation" {style.fill: "#f2f2f2"; style.stroke: "#777777"}
core: "Core instance\ndocument, stores, workers" {style.fill: "#dcecff"; style.stroke: "#3676b8"}

petrinaut: "Petrinaut component\none core instance per handle" {style.fill: "#e8e0ff"; style.stroke: "#7051b5"}
react: "React layer\nproviders and hooks" {style.fill: "#e8e0ff"; style.stroke: "#7051b5"}
plugins: "Plugins provider\none host per plugin" {style.fill: "#f7f4ff"; style.stroke: "#7051b5"}
shell: "Editor view\nbars, panels, dialogs" {style.fill: "#f7f4ff"; style.stroke: "#7051b5"}
panels: "Panels and the Simulate view" {style.fill: "#f7f4ff"; style.stroke: "#7051b5"}
canvas: "Canvas" {style.fill: "#f7f4ff"; style.stroke: "#7051b5"}
notebook: "Notebook" {style.fill: "#f7f4ff"; style.stroke: "#7051b5"}
sub-views: "Sub-view containers\nsections and tabs" {style.fill: "#f7f4ff"; style.stroke: "#7051b5"}
monaco: "Monaco\ncode editors" {style.fill: "#f7f4ff"; style.stroke: "#7051b5"}
preview: "Preview" {style.fill: "#f7f4ff"; style.stroke: "#7051b5"}

host -> petrinaut: mounts
host -> preview: mounts
petrinaut -> core: creates
petrinaut -> react: "mounts the providers of"
react -> core: "subscribes to"
petrinaut -> plugins: mounts
plugins -> shell: "renders after its hosts"
shell -> panels: arranges
shell -> canvas: mounts
shell -> notebook: mounts
panels -> sub-views: "list descriptors for"
panels -> monaco: "edit code in"
preview -> canvas: mounts
