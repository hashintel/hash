{
  "extends": [
    "@local/tsconfig/legacy-base-tsconfig-to-refactor.json",
    "@tsconfig/bases/recommended"
  ],
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowJs": false,
    "checkJs": false,
    "allowSyntheticDefaultImports": true,
    "jsx": "react-jsx",
    "lib": ["dom", "dom.iterable", "esnext"],
    "noEmit": false,
    "target": "ES2021"
  },
  "include": [
    "src",
    "assets.d.ts",
    "theme-override.d.ts",
    "webpack-injected-env.d.ts",
    "codegen.config.ts",
    "eslint.config.js"
  ],
  "exclude": ["build", "node_modules"]
}
