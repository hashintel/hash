{
  "extends": ["@tsconfig/bases/recommended", "@local/tsconfig/policy.json"],
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["dom", "esnext"],
    "module": "ESNext",
    "rootDir": "../..",
    "target": "ES2021"
  },
  "include": [
    "src",
    "assets.d.ts",
    "theme-override.d.ts",
    "webpack-injected-env.d.ts",
    "codegen.config.ts",
    "eslint.config.js"
  ],
  "exclude": ["build", "node_modules"]
}
