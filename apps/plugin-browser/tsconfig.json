{
  "extends": ["@tsconfig/bases/recommended", "@local/tsconfig/policy.json"],
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["dom", "dom.iterable", "esnext"],
    "module": "ESNext",
    "noEmit": false,
    "rootDir": "../..",
    "target": "ES2021",
    // Implicit returns remain in src/scripts/background.ts, flow-metadata-cell-contents.tsx and
    // the @hashintel/design-system sources this program checks (TS7030).
    "noImplicitReturns": false
  },
  "include": [
    "src",
    "assets.d.ts",
    "theme-override.d.ts",
    "webpack-injected-env.d.ts",
    "codegen.config.ts",
    "eslint.config.js"
  ],
  "exclude": ["build", "node_modules"]
}
