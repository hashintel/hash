{
  "package": "@apps/plugin-browser",
  "dependencies": [
    "@blockprotocol/graph",
    "@blockprotocol/type-system",
    "@hashintel/block-design-system",
    "@hashintel/design-system",
    "@local/advanced-types",
    "@local/eslint",
    "@local/hash-graph-client",
    "@local/hash-graph-sdk",
    "@local/hash-isomorphic-utils",
    "@local/status"
  ],
  "tasks": {
    "build": [
      "@blockprotocol/graph#build",
      "@blockprotocol/type-system#build",
      "@local/advanced-types#build",
      "@local/eslint#build",
      "@local/hash-graph-client#build",
      "@local/hash-graph-sdk#build",
      "@local/hash-isomorphic-utils#build",
      "@local/status#build",
      "codegen"
    ],
    "build:firefox": [
      "@blockprotocol/graph#build",
      "@blockprotocol/type-system#build",
      "@local/advanced-types#build",
      "@local/eslint#build",
      "@local/hash-graph-client#build",
      "@local/hash-graph-sdk#build",
      "@local/hash-isomorphic-utils#build",
      "@local/status#build",
      "codegen"
    ],
    "build:test": [
      "@blockprotocol/graph#build",
      "@blockprotocol/type-system#build",
      "@local/advanced-types#build",
      "@local/eslint#build",
      "@local/hash-graph-client#build",
      "@local/hash-graph-sdk#build",
      "@local/hash-isomorphic-utils#build",
      "@local/status#build",
      "codegen"
    ],
    "codegen": [
      "@local/hash-isomorphic-utils#build"
    ],
    "dev": [
      "@blockprotocol/graph#build",
      "@blockprotocol/type-system#build",
      "@local/advanced-types#build",
      "@local/eslint#build",
      "@local/hash-graph-client#build",
      "@local/hash-graph-sdk#build",
      "@local/hash-isomorphic-utils#build",
      "@local/status#build",
      "codegen"
