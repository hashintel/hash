            "minLength": 1,
            "title": "Identifier",
            "type": "string"
          }
        },
        "required": [
          "identifier",
          "domain"
        ],
        "title": "OptimizationVariable",
        "type": "object"
      },
      "Phase": {
        "enum": [
          "idle",
          "running",
          "done",
          "error"
        ],
        "title": "Phase",
        "type": "string"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
