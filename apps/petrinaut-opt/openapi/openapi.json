            "type": "integer"
          }
        },
        "required": [
          "kind",
          "minimum",
          "maximum",
          "step"
        ],
        "title": "IntegerDomain",
        "type": "object"
      },
      "OptimizationBest": {
        "additionalProperties": false,
        "properties": {
          "objective": {
            "title": "Objective",
            "type": "number"
          },
          "parameters": {
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "integer"
                },
