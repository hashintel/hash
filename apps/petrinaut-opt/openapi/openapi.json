            ],
            "title": "Sampler",
            "type": "string"
          },
          "trials": {
            "maximum": 1000.0,
            "minimum": 1.0,
            "title": "Trials",
            "type": "integer"
          }
        },
        "required": [
          "trials",
          "sampler"
        ],
        "title": "OptimizationOptions",
        "type": "object"
      },
      "OptimizationScenario": {
        "additionalProperties": false,
        "properties": {
          "id": {
