          },
          "parameterValues": {
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "number"
                },
                {
                  "type": "boolean"
                }
              ]
            },
            "title": "Parametervalues",
            "type": "object"
          }
        },
        "required": [
          "id",
          "parameterValues"
        ],
        "title": "OptimizationScenario",
        "type": "object"
      },
      "OptimizationSearchSpace": {
        "additionalProperties": false,
        "properties": {
          "variables": {
            "items": {
              "$ref": "#/components/schemas/OptimizationVariable"
            },
            "minItems": 1,
            "title": "Variables",
            "type": "array"
          },
          "version": {
            "const": 1,
            "title": "Version",
            "type": "integer"
          }
        },
        "required": [
          "version",
          "variables"
        ],
        "title": "OptimizationSearchSpace",
        "type": "object"
      },
      "OptimizationStartedEvent": {
        "additionalProperties": false,
        "properties": {
          "requestedTrials": {
            "exclusiveMinimum": 0.0,
            "title": "Requestedtrials",
            "type": "integer"
          },
          "type": {
            "const": "started",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "type",
          "requestedTrials"
        ],
        "title": "OptimizationStartedEvent",
        "type": "object"
      },
      "OptimizationTrialEvent": {
        "additionalProperties": false,
        "properties": {
          "best": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/OptimizationBest"
              },
              {
                "type": "null"
              }
            ]
          },
          "objective": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Objective"
          },
          "parameters": {
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "number"
                },
                {
                  "type": "boolean"
                }
              ]
            },
            "title": "Parameters",
            "type": "object"
          },
          "state": {
            "enum": [
              "complete",
              "pruned",
              "failed"
            ],
            "title": "State",
            "type": "string"
          },
          "trial": {
            "minimum": 0.0,
            "title": "Trial",
            "type": "integer"
          },
          "type": {
            "const": "trial",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "type",
          "trial",
          "parameters",
          "objective",
          "state",
          "best"
        ],
        "title": "OptimizationTrialEvent",
        "type": "object"
      },
      "OptimizationVariable": {
        "additionalProperties": false,
        "properties": {
          "domain": {
            "discriminator": {
              "mapping": {
                "categorical": "#/components/schemas/CategoricalDomain",
                "continuous": "#/components/schemas/ContinuousDomain",
                "integer": "#/components/schemas/IntegerDomain"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/components/schemas/ContinuousDomain"
              },
              {
                "$ref": "#/components/schemas/IntegerDomain"
              },
              {
                "$ref": "#/components/schemas/CategoricalDomain"
              }
            ],
            "title": "Domain"
          },
