  },
  "info": {
    "title": "Petrinaut optimization Python API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/optimize": {
      "post": {
        "description": "Optimize flat parameters of one selected scenario.",
        "operationId": "optimize_optimize_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OptimizationInput"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/x-ndjson": {
                "schema": {
                  "discriminator": {
                    "mapping": {
                      "complete": "#/components/schemas/OptimizationCompleteEvent",
                      "error": "#/components/schemas/OptimizationErrorEvent",
                      "started": "#/components/schemas/OptimizationStartedEvent",
                      "trial": "#/components/schemas/OptimizationTrialEvent"
                    },
                    "propertyName": "type"
                  },
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/OptimizationStartedEvent"
                    },
                    {
                      "$ref": "#/components/schemas/OptimizationTrialEvent"
                    },
                    {
                      "$ref": "#/components/schemas/OptimizationCompleteEvent"
                    },
                    {
                      "$ref": "#/components/schemas/OptimizationErrorEvent"
                    }
                  ]
                }
              }
            },
            "description": "One OptimizationEvent per NDJSON line"
          },
          "413": {
            "description": "The request body exceeds 8 MiB"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "429": {
            "description": "The service is already at its study limit"
          }
        },
        "summary": "Optimize"
      }
    },
    "/status": {
      "get": {
        "description": "Return process-level status for container and infrastructure checks.",
        "operationId": "get_status_status_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AppStatus"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Get Status"
      }
    }
  }
}
