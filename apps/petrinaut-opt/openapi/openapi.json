            "minLength": 1,
            "title": "Metricid",
            "type": "string"
          }
        },
        "required": [
          "metricId",
          "direction"
        ],
        "title": "OptimizationObjective",
        "type": "object"
      },
      "OptimizationOptions": {
        "additionalProperties": false,
        "properties": {
