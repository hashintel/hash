{
  "package": "petrinaut-optimization",
  "dependencies": [
    "petrinaut-optimizer-core",
    "petrinaut-python"
  ],
  "tasks": {
    "build:docker": {
      "dependsOn": [],
      "cache": false
    },
    "codegen": {
      "dependsOn": [
        "@hashintel/petrinaut-cli#codegen"
      ],
      "affectedBy": [
        "@hashintel/petrinaut-cli",
        "@hashintel/petrinaut-core"
      ]
    },
    "start": {
      "dependsOn": [
        "@hashintel/petrinaut-cli#codegen"
      ],
      "cache": false,
      "persistent": true,
      "affectedBy": [
        "@hashintel/petrinaut-cli",
        "@hashintel/petrinaut-core"
      ]
    },
    "start:dev": {
      "dependsOn": [
        "@hashintel/petrinaut-cli#codegen"
      ],
      "cache": false,
      "persistent": true,
      "affectedBy": [
        "@hashintel/petrinaut-cli",
        "@hashintel/petrinaut-core"
      ]
    },
    "test:unit": {
      "dependsOn": [
        "codegen"
      ],
      "env": [
        "TEST_COVERAGE"
      ],
      "affectedBy": [
        "@hashintel/petrinaut-cli",
        "@hashintel/petrinaut-core"
      ]
    }
  }
}
