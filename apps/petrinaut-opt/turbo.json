{
  "extends": ["//"],
  "tasks": {
    "check:ty": { "dependsOn": ["petrinaut-python#codegen"] },
    "lint:deptry": {
      "command": [
        "uv",
        "run",
        "--active",
        "--frozen",
        "--all-packages",
        "deptry",
        "src",
        "scripts"
      ],
      "passThroughEnv": ["UV_CACHE_DIR"]
    },
    "build:docker": {
      "command": [
        "docker",
        "buildx",
        "build",
        "--tag",
        "petrinaut-opt",
        "--file",
        "docker/Dockerfile",
        "../../",
        "--load"
      ]
    },
    "codegen": {
      "command": ["uv", "run", "python", "-m", "scripts.generate_openapi"],
      // The schema is generated from the app, which imports the models that
      // `petrinaut-python` generates.
      "dependsOn": [
        "petrinaut-python#codegen",
        "petrinaut-optimizer-core#manifest",
        "petrinaut-python#manifest"
      ],
      "inputs": ["scripts/generate_openapi.py", "src/**/*.py"],
      "outputs": ["openapi/openapi.json"],
      "passThroughEnv": ["UV_CACHE_DIR"]
    },
    "start": {
      "command": ["uv", "run", "uvicorn", "petrinaut_optimization.api:app"],
      "dependsOn": ["petrinaut-python#codegen"]
    },
    "start:dev": {
      "command": [
        "uv",
        "run",
        "uvicorn",
        "petrinaut_optimization.api:app",
        "--reload"
      ],
      "cache": false,
      "persistent": true,
      "dependsOn": ["petrinaut-python#codegen"]
    },
    "check:openapi": {
      "command": [
        "uv",
        "run",
        "python",
        "-m",
        "scripts.generate_openapi",
        "--check"
      ],
      "cache": false,
      "dependsOn": ["petrinaut-python#codegen"]
    },
    "test": {
      "dependsOn": ["check:openapi", "^manifest"]
    },
    "test:unit": {
      "dependsOn": ["test"]
    }
  }
}
