{
  "extends": ["//"],
  "tasks": {
    "lint:types": {
      "command": [
        "uv",
        "run",
        "--active",
        "--frozen",
        "--all-packages",
        "basedpyright"
      ],
      "passThroughEnv": ["UV_CACHE_DIR"],
      "dependsOn": ["petrinaut-python#codegen"]
    },
    "lint:ruff": {
      "command": [
        "uv",
        "run",
        "--active",
        "--frozen",
        "--all-packages",
        "ruff",
        "check",
        "."
      ],
      "passThroughEnv": ["UV_CACHE_DIR"]
    },
    "format:ruff": {
      "command": [
        "uv",
        "run",
        "--active",
        "--frozen",
        "--all-packages",
        "ruff",
        "format",
        "."
      ],
      "passThroughEnv": ["UV_CACHE_DIR"]
    },
    "build:docker": {
      "command": [
        "docker",
        "buildx",
        "build",
        "--tag",
        "petrinaut-opt",
        "--file",
        "docker/Dockerfile",
        "../../",
        "--load"
      ]
    },
    "codegen": {
      "command": ["uv", "run", "python", "-m", "scripts.generate_openapi"],
      // The schema is generated from the app, which imports the models that
      // `petrinaut-python` generates.
      "dependsOn": [
        "petrinaut-python#codegen",
        "petrinaut-optimizer-core#manifest",
        "petrinaut-python#manifest"
      ],
      "inputs": ["scripts/generate_openapi.py", "src/**/*.py"],
      "outputs": ["openapi/openapi.json"],
      "passThroughEnv": ["UV_CACHE_DIR"]
    },
    "start": {
      "command": ["uv", "run", "uvicorn", "src.optimization_api:app"],
      "dependsOn": ["petrinaut-python#codegen"]
    },
    "start:dev": {
      "command": [
        "uv",
        "run",
        "uvicorn",
        "src.optimization_api:app",
        "--reload"
      ],
      "cache": false,
      "persistent": true,
      "dependsOn": ["petrinaut-python#codegen"]
    },
    "check:openapi": {
      "command": ["git", "diff", "--exit-code", "--", "openapi/openapi.json"],
      "cache": false,
      "dependsOn": ["codegen"]
    },
    "test:unit": {
      "dependsOn": ["check:openapi", "^manifest"],
      "env": [
        "$TURBO_EXTENDS$",
        "PYTHONHOME",
        "PYTHONPATH",
        "UV_BUILD_CONSTRAINT",
        "UV_COMPILE_BYTECODE",
        "UV_CONFIG_FILE",
        "UV_CONSTRAINT",
        "UV_ENV_FILE",
        "UV_EXCLUDE",
        "UV_FORK_STRATEGY",
        "UV_GIT_LFS",
        "UV_ISOLATED",
        "UV_LINK_MODE",
        "UV_NO_BINARY",
        "UV_NO_BINARY_PACKAGE",
        "UV_NO_BUILD",
        "UV_NO_BUILD_ISOLATION",
        "UV_NO_BUILD_ISOLATION_PACKAGE",
        "UV_NO_BUILD_PACKAGE",
        "UV_NO_CONFIG",
        "UV_NO_DEFAULT_GROUPS",
        "UV_NO_DEV",
        "UV_NO_EDITABLE",
        "UV_NO_ENV_FILE",
        "UV_NO_GROUP",
        "UV_NO_PROJECT",
        "UV_NO_SOURCES",
        "UV_NO_SOURCES_PACKAGE",
        "UV_NO_SYNC",
        "UV_NO_SYSTEM_CONFIG",
        "UV_OFFLINE",
        "UV_OVERRIDE",
        "UV_PROJECT",
        "UV_PROJECT_ENVIRONMENT",
        "UV_WORKING_DIR",
        "VIRTUAL_ENV"
      ],
      "passThroughEnv": [
        "$TURBO_EXTENDS$",
        "PIP_EXTRA_INDEX_URL",
        "PIP_INDEX_URL",
        "UV_CACHE_DIR",
        "UV_DEFAULT_INDEX",
        "UV_EXCLUDE_NEWER",
        "UV_EXTRA_INDEX_URL",
        "UV_FIND_LINKS",
        "UV_INDEX",
        "UV_INDEX_STRATEGY",
        "UV_INDEX_URL",
        "UV_INSECURE_HOST",
        "UV_MANAGED_PYTHON",
        "UV_NO_MANAGED_PYTHON",
        "UV_PRERELEASE",
        "UV_PYTHON",
        "UV_PYTHON_DOWNLOADS",
        "UV_PYTHON_PREFERENCE",
        "UV_RESOLUTION",
        "UV_SYSTEM_CERTS",
        "XDG_CONFIG_HOME"
      ],
      "command": [
        "uv",
        "run",
        "--active",
        "--frozen",
        "--all-packages",
        "pytest",
        "."
      ]
    }
  }
}
