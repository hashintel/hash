{
  "extends": ["//"],
  "tasks": {
    "codegen": {
      "inputs": [
        "pyproject.toml",
        "uv.lock",
        "scripts/generate_openapi.py",
        "src/**/*.py",
        "../../libs/@local/petrinaut-optimizer-core/src/**/*.py",
        "../../libs/@local/petrinaut-python/src/**/*.py"
      ],
      "outputs": ["openapi/openapi.json"],
      "passThroughEnv": ["UV_CACHE_DIR"]
    }
  }
}
