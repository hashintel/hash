{
  "extends": ["//"],
  "tasks": {
    "build:docker": {
      "command": [
        "docker",
        "buildx",
        "build",
        "--tag",
        "petrinaut-opt",
        "--file",
        "docker/Dockerfile",
        "../../",
        "--load"
      ]
    },
    "codegen": {
      "command": ["uv", "run", "python", "-m", "scripts.generate_openapi"],
      // The schema is generated from the app, which imports the models that
      // `petrinaut-python` generates.
      "dependsOn": ["petrinaut-python#codegen"],
      "inputs": [
        "pyproject.toml",
        "$TURBO_ROOT$/uv.lock",
        "scripts/generate_openapi.py",
        "src/**/*.py",
        "../../libs/@local/petrinaut-optimizer-core/python/src/**/*.py",
        "../../libs/@local/petrinaut-python/src/**/*.py"
      ],
      "outputs": ["openapi/openapi.json"],
      "passThroughEnv": ["UV_CACHE_DIR"]
    },
    "start": {
      "command": ["uv", "run", "uvicorn", "src.optimization_api:app"],
      "dependsOn": ["petrinaut-python#codegen"]
    },
    "start:dev": {
      "command": [
        "uv",
        "run",
        "uvicorn",
        "src.optimization_api:app",
        "--reload"
      ],
      "cache": false,
      "persistent": true,
      "dependsOn": ["petrinaut-python#codegen"]
    },
    "check:openapi": {
      "command": ["git", "diff", "--exit-code", "--", "openapi/openapi.json"],
      "cache": false,
      "dependsOn": ["codegen"]
    },
    "test": {
      "dependsOn": ["check:openapi", "^manifest"]
    },
    "test:unit": {
      "dependsOn": ["test"]
    }
  }
}
