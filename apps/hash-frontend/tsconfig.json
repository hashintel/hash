{
  "extends": ["@tsconfig/bases/next", "@local/tsconfig/policy.json"],
  "compilerOptions": {
    "checkJs": true,
    "target": "ES2021",
    "types": ["gapi", "google.accounts", "google.picker"]
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "assets.d.ts",
    "codegen.config.ts",
    "instrumentation-client.ts",
    "next.config.js",
    "theme-override.d.ts",
    ".next/types/**/*.ts"
  ],
  "exclude": ["node_modules", "panda.config.ts"]
}
