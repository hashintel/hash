{
  "extends": [
    "@local/tsconfig/legacy-base-tsconfig-to-refactor.json",
    "@tsconfig/bases/next"
  ],
  "compilerOptions": {
    "rootDir": "../..",
    "target": "ES2021",
    "types": ["gapi", "google.accounts", "google.picker"]
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "assets.d.ts",
    "codegen.config.ts",
    "instrumentation-client.ts",
    "next.config.js",
    "theme-override.d.ts",
    ".next/types/**/*.ts"
  ],
  "exclude": ["node_modules", ".next", "panda.config.ts"]
}
