{
  "extends": ["@tsconfig/bases/recommended", "@local/tsconfig/policy.json"],
  "compilerOptions": {
    "checkJs": true,
    "target": "ES2021",
    "types": ["gapi", "google.accounts", "google.picker"],
    "allowJs": true,
    "esModuleInterop": true,
    "incremental": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "lib": ["dom", "dom.iterable", "esnext"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "resolveJsonModule": true,
    "skipLibCheck": true
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "assets.d.ts",
    "codegen.config.ts",
    "instrumentation-client.ts",
    "next.config.js",
    "theme-override.d.ts",
    ".next/types/**/*.ts"
  ],
  "exclude": ["node_modules", "panda.config.ts"]
}
