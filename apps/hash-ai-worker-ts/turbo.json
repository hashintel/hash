{
  "extends": ["//"],
  "tasks": {
    "build": {
      "outputs": ["./dist/**"],
      "dependsOn": ["^build"]
    },
    "dev": {
      "dependsOn": ["^build"]
    },
    "test:unit": {
      "dependsOn": ["^build"]
    },
    "start": {
      "dependsOn": ["build", "@apps/hash-graph#start:healthcheck"]
    },
    "start:test": {
      "dependsOn": ["build", "@apps/hash-graph#start:test:healthcheck"]
    }
  }
}
