{
  "extends": ["@tsconfig/bases/node22", "@local/tsconfig/policy.json"],
  "include": ["src", "scripts", "eslint.config.js", "vitest.config.ts"],
  "compilerOptions": {
    "checkJs": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2024", "ESNext.Collection"],
    // Implicit returns remain in src/shared/testing-utilities/mock-get-flow-context.ts (TS7030).
    "noImplicitReturns": false
  }
}
