{
  "extends": ["//"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "ANTHROPIC_API_KEY",
        "BRUNCH_CHAT_DB_PATH",
        "BRUNCH_CHAT_MODEL",
        "BRUNCH_CHAT_PORT",
        "BRUNCH_CHAT_THINKING",
        "BRUNCH_CORS_ALLOWED_ORIGINS",
        "BRUNCH_DB_KIND",
        "BRUNCH_DEV_DB_PATH",
        "BRUNCH_HASH_SERVICE_SECRET",
        "BRUNCH_PANEL_PORT",
        "BRUNCH_POSTGRES_AUTH_MODE",
        "BRUNCH_POSTGRES_AWS_REGION",
        "BRUNCH_POSTGRES_DATABASE",
        "BRUNCH_POSTGRES_HOST",
        "BRUNCH_POSTGRES_PASSWORD",
        "BRUNCH_POSTGRES_PORT",
        "BRUNCH_POSTGRES_TLS_CA_PATH",
        "BRUNCH_POSTGRES_USER",
        "BRUNCH_STEP_A_ACCOUNTING",
        "BRUNCH_TEST_KEEP_RECENT_TOKENS",
        "HASH_OTLP_ENDPOINT",
        "OPENAI_API_KEY",
        "OTEL_RESOURCE_ATTRIBUTES",
        "OTEL_SERVICE_NAME"
      ]
    },
    "petrinaut:dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "BRUNCH_CHAT_ORIGIN",
        "BRUNCH_CHAT_PORT",
        "BRUNCH_PANEL_PORT",
        "PETRINAUT_WEBSITE_ROOT",
        "VITE_BRUNCH_CHAT_ENDPOINT",
        "VITE_PETRINAUT_DEFAULT_ASSISTANT"
      ]
    },
    "start": {
      "dependsOn": ["build"]
    },
    "test:integration": {
      "dependsOn": ["build", "codegen", "^build"]
    },
    "test:unit": {
      "dependsOn": ["codegen", "^build", "@hashintel/petrinaut#manifest"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/libs/@hashintel/petrinaut/docs/**"
      ]
    }
  }
}
