{
  "name": "@apps/brunch-agent",
  "version": "0.0.0-private",
  "private": true,
  "description": "Remote Brunch server and local Petrinaut development loop.",
  "license": "AGPL-3.0",
  "type": "module",
  "exports": {
    "./testing/admission-controls": "./test/integration/run-admission-controls.ts",
    "./testing/load-built-application": "./test/load-built-application.ts"
  },
  "scripts": {
    "build": "vite build && vite build --config vite.client.config.ts",
    "build:docker": "docker buildx build --tag brunch-agent --file docker/Dockerfile ../../ --load",
    "dev": "vite dev",
    "fix:eslint": "oxlint --fix --type-aware --type-check --report-unused-disable-directives-severity=error .",
    "lint:eslint": "oxlint --type-aware --type-check --report-unused-disable-directives-severity=error .",
    "lint:tsc": "tsc --noEmit",
    "packet:run": "node --experimental-strip-types --disable-warning=ExperimentalWarning evals/petrinaut/run-packet-cli.ts",
    "persona": "node --experimental-strip-types evals/petrinaut/persona/launch.ts",
    "petrinaut:dev": "vite dev --config petrinaut-local.vite.config.ts",
    "probe:turn": "node --experimental-strip-types evals/petrinaut/turn-probe.ts",
    "proof:manifest": "node --experimental-strip-types evals/petrinaut/persona/refresh-proof-manifest.ts",
    "smoke:deployment": "node --experimental-strip-types src/server/deployment-smoke.ts",
    "start": "PORT=3002 node dist/server.mjs",
    "start:healthcheck": "wait-on --timeout 1200000 http-get://localhost:3002/health",
    "test:docker": "node --experimental-strip-types test/container-smoke.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:manual:browser": "VITE_BRUNCH_CHAT_ENDPOINT=/agents/petrinaut VITE_PETRINAUT_DEFAULT_ASSISTANT=brunch turbo run build --filter '@apps/brunch-agent...' --filter '@apps/petrinaut-website...' --env-mode=loose && node --experimental-strip-types test/browser-witness/petrinaut-panel.ts",
    "test:manual:browser:ledger-tab": "VITE_BRUNCH_CHAT_ENDPOINT=/agents/petrinaut VITE_PETRINAUT_DEFAULT_ASSISTANT=brunch turbo run build --filter '@apps/brunch-agent...' --filter '@apps/petrinaut-website...' --env-mode=loose && node --experimental-strip-types test/browser-witness/ledger-tab.ts",
    "test:manual:browser:persona": "VITE_BRUNCH_CHAT_ENDPOINT=${VITE_BRUNCH_CHAT_ENDPOINT:-/agents/petrinaut} VITE_PETRINAUT_DEFAULT_ASSISTANT=brunch turbo run build --filter '@apps/brunch-agent...' --filter '@apps/petrinaut-website...' --env-mode=loose && node --experimental-strip-types test/browser-witness/persona-turn.ts",
    "test:unit": "vitest run --config vitest.config.ts",
    "transcript": "node --experimental-strip-types src/server/transcript-cli.ts"
  },
  "dependencies": {
    "@aws-sdk/rds-signer": "3.1117.0",
    "@earendil-works/pi-ai": "1.2.0",
    "@flue/opentelemetry": "2.3.0",
    "@flue/postgres": "2.3.0",
    "@flue/react": "2.3.0",
    "@flue/runtime": "2.3.0",
    "@flue/sdk": "2.3.0",
    "@hashintel/brunch-agent": "workspace:*",
    "@hashintel/petrinaut-core": "workspace:*",
    "@local/flue-aisdk-transport": "workspace:*",
    "@local/hash-backend-utils": "workspace:*",
    "@opentelemetry/api": "1.9.1",
    "hono": "4.13.13",
    "pg": "8.23.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "valibot": "1.4.2"
  },
  "devDependencies": {
    "@flue/vite": "2.3.0",
    "@local/pi-faux-providers": "workspace:*",
    "@local/tsconfig": "workspace:*",
    "@playwright/test": "1.58.2",
    "@tsconfig/bases": "catalog:",
    "@types/node": "catalog:",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@valibot/to-json-schema": "1.7.1",
    "ai": "6.0.286",
    "dependency-cruiser": "18.0.0",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "wait-on": "9.0.1"
  }
}
