(version 1)
(allow default)
(deny network*)
; macOS sandbox-exec rejects numeric/hostname destination filters (only * or
; localhost). This is an OS PORT restriction, NOT an Anthropic hostname/IP gate.
; Parent must explicitly accept it together with exact endpoint + pinned-IP TLS
; transport. No builds/codegen run here. Chrome has a nested loopback-only policy.
(allow network-outbound (remote tcp "*:443"))
(allow network* (regex "^(/private)?/(tmp|var/folders/[^/]+/[^/]+/T)/com[.]google[.]Chrome[.][^/]+/SingletonSocket$"))
(allow network-inbound (local ip "localhost:*"))
(allow network-outbound (remote ip "localhost:*"))
(allow network-bind (local ip "localhost:*"))
