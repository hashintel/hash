{
  "extends": ["//"],
  "tasks": {
    "codegen": {
      // Outputs of GraphQL generation
      "outputs": ["./src/**/*.gen.*"],
      // graphql-codegen loads its config from the isomorphic utils' dist.
      "dependsOn": ["@local/hash-isomorphic-utils#build"]
    },
    // The service starts from its sources, so this runs nothing of its own and gathers the
    // generated code and the dependencies' builds a checkout needs to run it.
    "build": {
      "dependsOn": ["codegen", "^build"]
    },
    "dev": {
      "dependsOn": ["codegen", "^build"],
      "passThroughEnv": ["PORT"]
    },
    "test:unit": {
      "dependsOn": ["codegen", "^build"]
    },
    "start:migrate": {
      "dependsOn": ["codegen", "^build", "hash-graph#start:healthcheck"]
    },
    "start": {
      "dependsOn": ["start:migrate"]
    },
    "start:test:migrate": {
      "dependsOn": ["codegen", "^build", "hash-graph#start:test:healthcheck"]
    },
    "start:test": {
      "dependsOn": ["start:test:migrate"]
    }
  }
}
