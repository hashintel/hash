{
  "extends": ["@tsconfig/bases/node22", "@local/tsconfig/policy.json"],
  "compilerOptions": {
    "jsx": "react-jsx",
    // The API imports server modules from ../src that name DOM types (HeadersInit).
    "lib": ["DOM", "ESNext"],
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "rootDir": "..",
    "verbatimModuleSyntax": true,
    // Implicit returns remain in ../src/server/voice/voice-request-guard.ts (TS7030).
    "noImplicitReturns": false
  },
  "include": ["./**/*.ts"]
}
