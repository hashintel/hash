{
  "github": {
    "silent": true,
    "autoJobCancelation": true
  },
  "buildCommand": "./vercel-build.sh",
  "installCommand": "./vercel-install.sh",
  "devCommand": "turbo run build && yarn preview",
  "outputDirectory": "./dist",
  "rewrites": [
    {
      "source": "/((?!api(?:/|$)).*)",
      "destination": "/"
    }
  ],
  "functions": {
    "api/chat.ts": {
      "maxDuration": 300
    }
  }
}
