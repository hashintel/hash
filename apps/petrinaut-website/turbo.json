{
  "extends": ["//"],
  "tasks": {
    "brunch:fixture": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["HOST", "INTERVAL", "PORT", "RECORDING", "RUN_ID"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "cache": false
    },
    "lint:tsc": {
      "dependsOn": ["^build"]
    }
  }
}
