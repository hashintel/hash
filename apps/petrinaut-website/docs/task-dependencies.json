{
  "package": "@apps/petrinaut-website",
  "dependencies": [
    "@hashintel/brunch-agent",
    "@hashintel/ds-components",
    "@hashintel/ds-helpers",
    "@hashintel/ds-icons",
    "@hashintel/petrinaut",
    "@hashintel/petrinaut-core",
    "@local/flue-aisdk-transport",
    "@local/tsconfig"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "@hashintel/brunch-agent#build",
        "@hashintel/ds-components#build",
        "@hashintel/ds-components#codegen",
        "@hashintel/ds-icons#build",
        "@hashintel/petrinaut#build",
        "@hashintel/petrinaut-core#build",
        "@local/flue-aisdk-transport#build",
        "codegen",
        "examples:generate"
      ],
      "env": [
        "SENTRY_DSN",
        "VITE_BRUNCH_CHAT_ENDPOINT",
        "VITE_PETRINAUT_DEFAULT_ASSISTANT",
        "VITE_VERCEL_ENV"
      ],
      "affectedBy": [
        "@hashintel/petrinaut-cli",
        "petrinaut-optimization",
        "petrinaut-optimizer-core",
        "petrinaut-python"
      ]
    },
    "codegen": {
      "dependsOn": []
    },
    "dev": {
      "dependsOn": [
        "@hashintel/brunch-agent#build",
        "@hashintel/ds-components#build",
        "@hashintel/ds-components#codegen",
        "@hashintel/ds-icons#build",
        "@hashintel/petrinaut#build",
        "@hashintel/petrinaut-core#build",
        "@local/flue-aisdk-transport#build",
        "codegen",
        "examples:generate"
      ],
      "cache": false,
      "persistent": true,
      "affectedBy": [
        "@hashintel/petrinaut-cli",
        "petrinaut-optimization",
        "petrinaut-optimizer-core",
        "petrinaut-python"
      ]
    },
    "examples:generate": {
      "dependsOn": [
        "@hashintel/brunch-agent#build",
        "@hashintel/ds-components#build",
        "@hashintel/ds-components#codegen",
        "@hashintel/ds-icons#build",
        "@hashintel/petrinaut#build",
        "@hashintel/petrinaut-core#build",
        "@local/flue-aisdk-transport#build"
      ],
      "affectedBy": [
        "@hashintel/petrinaut-cli",
        "petrinaut-optimization",
        "petrinaut-optimizer-core",
        "petrinaut-python"
      ]
    },
    "fix:eslint": {
      "dependsOn": [
        "@hashintel/brunch-agent#build",
        "@hashintel/ds-components#build",
        "@hashintel/ds-components#codegen",
        "@hashintel/ds-icons#build",
        "@hashintel/petrinaut#build",
        "@hashintel/petrinaut-core#build",
        "@local/eslint#build",
        "@local/flue-aisdk-transport#build",
        "codegen"
      ],
      "affectedBy": [
        "@hashintel/petrinaut-cli",
        "petrinaut-optimization",
        "petrinaut-optimizer-core",
        "petrinaut-python"
      ]
    },
    "lint:eslint": {
      "dependsOn": [
        "@hashintel/brunch-agent#build",
        "@hashintel/ds-components#build",
        "@hashintel/ds-components#codegen",
        "@hashintel/ds-icons#build",
        "@hashintel/petrinaut#build",
        "@hashintel/petrinaut-core#build",
        "@local/eslint#build",
        "@local/flue-aisdk-transport#build",
        "codegen"
      ],
      "env": [
        "CHECK_TEMPORARILY_DISABLED_RULES"
      ],
      "affectedBy": [
        "@hashintel/petrinaut-cli",
        "petrinaut-optimization",
        "petrinaut-optimizer-core",
        "petrinaut-python"
      ]
    },
    "lint:tsc": {
      "dependsOn": [
        "@hashintel/brunch-agent#build",
        "@hashintel/ds-components#build",
        "@hashintel/ds-components#codegen",
        "@hashintel/ds-icons#build",
        "@hashintel/petrinaut#build",
        "@hashintel/petrinaut-core#build",
        "@local/flue-aisdk-transport#build",
        "codegen",
        "examples:generate"
      ],
      "affectedBy": [
        "@hashintel/petrinaut-cli",
        "petrinaut-optimization",
        "petrinaut-optimizer-core",
        "petrinaut-python"
      ]
    },
    "test:unit": {
      "dependsOn": [
        "@hashintel/brunch-agent#build",
        "@hashintel/ds-components#build",
        "@hashintel/ds-components#codegen",
        "@hashintel/ds-icons#build",
        "@hashintel/petrinaut#build",
        "@hashintel/petrinaut-core#build",
        "@local/flue-aisdk-transport#build",
        "codegen",
        "examples:generate"
      ],
      "env": [
        "TEST_COVERAGE"
      ],
      "affectedBy": [
        "@hashintel/petrinaut-cli",
        "petrinaut-optimization",
        "petrinaut-optimizer-core",
        "petrinaut-python"
      ]
    }
  }
}
