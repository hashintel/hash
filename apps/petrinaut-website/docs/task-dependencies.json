{
  "package": "@apps/petrinaut-website",
  "dependencies": [
    "@hashintel/brunch-agent",
    "@hashintel/brunch-agent-plugin-sdcpn",
    "@hashintel/brunch-agent-transport-aisdk",
    "@hashintel/ds-components",
    "@hashintel/ds-helpers",
    "@hashintel/petrinaut",
    "@hashintel/petrinaut-core",
    "@local/petrinaut-optimizer-client"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "@hashintel/brunch-agent#build",
        "@hashintel/brunch-agent-plugin-sdcpn#build",
        "@hashintel/brunch-agent-transport-aisdk#build",
        "@hashintel/ds-components#build",
        "@hashintel/petrinaut#build",
        "@hashintel/petrinaut-core#build",
        "@local/petrinaut-optimizer-client#build",
        "codegen",
        "examples:generate"
      ],
      "env": [
        "SENTRY_DSN",
        "VITE_BRUNCH_CHAT_ENDPOINT",
        "VITE_PETRINAUT_DEFAULT_ASSISTANT",
        "VITE_VERCEL_ENV"
      ]
    },
    "codegen": {
      "dependsOn": []
    },
    "dev": {
      "dependsOn": [
        "@hashintel/brunch-agent#build",
        "@hashintel/brunch-agent-plugin-sdcpn#build",
        "@hashintel/brunch-agent-transport-aisdk#build",
        "@hashintel/ds-components#build",
        "@hashintel/petrinaut#build",
        "@hashintel/petrinaut-core#build",
        "@local/petrinaut-optimizer-client#build",
        "codegen",
        "examples:generate"
      ],
      "cache": false,
      "persistent": true
    },
    "examples:generate": {
      "dependsOn": [
        "@hashintel/brunch-agent#build",
        "@hashintel/brunch-agent-plugin-sdcpn#build",
        "@hashintel/brunch-agent-transport-aisdk#build",
        "@hashintel/ds-components#build",
        "@hashintel/petrinaut#build",
        "@hashintel/petrinaut-core#build",
        "@local/petrinaut-optimizer-client#build"
      ]
    },
    "fix:eslint": {
      "dependsOn": [
        "@hashintel/brunch-agent#build",
        "@hashintel/brunch-agent-plugin-sdcpn#build",
        "@hashintel/brunch-agent-transport-aisdk#build",
        "@hashintel/ds-components#build",
        "@hashintel/petrinaut#build",
        "@hashintel/petrinaut-core#build",
        "@local/eslint#build",
        "@local/petrinaut-optimizer-client#build",
        "codegen"
      ]
    },
    "lint:eslint": {
      "dependsOn": [
        "@hashintel/brunch-agent#build",
        "@hashintel/brunch-agent-plugin-sdcpn#build",
        "@hashintel/brunch-agent-transport-aisdk#build",
        "@hashintel/ds-components#build",
        "@hashintel/petrinaut#build",
        "@hashintel/petrinaut-core#build",
        "@local/eslint#build",
        "@local/petrinaut-optimizer-client#build",
        "codegen"
      ],
      "env": [
        "CHECK_TEMPORARILY_DISABLED_RULES"
      ]
    },
    "lint:tsc": {
      "dependsOn": [
        "@hashintel/brunch-agent#build",
        "@hashintel/brunch-agent-plugin-sdcpn#build",
        "@hashintel/brunch-agent-transport-aisdk#build",
        "@hashintel/ds-components#build",
        "@hashintel/petrinaut#build",
        "@hashintel/petrinaut-core#build",
        "@local/petrinaut-optimizer-client#build",
        "codegen",
        "examples:generate"
      ]
    },
    "test:integration": {
      "dependsOn": [
        "@apps/brunch-agent#build",
        "@hashintel/brunch-agent#build",
        "@hashintel/brunch-agent-plugin-sdcpn#build",
        "@hashintel/brunch-agent-transport-aisdk#build",
        "@hashintel/ds-components#build",
        "@hashintel/petrinaut#build",
        "@hashintel/petrinaut-core#build",
        "@local/petrinaut-optimizer-client#build",
        "codegen",
        "examples:generate"
      ],
      "env": [
        "TEST_COVERAGE"
      ],
      "affectedBy": [
        "@apps/brunch-agent",
        "@blockprotocol/graph",
        "@blockprotocol/type-system",
        "@local/advanced-types",
        "@local/harpc-client",
        "@local/hash-backend-utils",
        "@local/hash-codec",
        "@local/hash-graph-authorization",
        "@local/hash-graph-client",
        "@local/hash-graph-sdk",
        "@local/hash-graph-store",
        "@local/hash-isomorphic-utils",
        "@local/internal-api-client",
        "@local/status",
        "darwin-kperf",
        "darwin-kperf-codegen",
        "darwin-kperf-criterion",
        "darwin-kperf-events",
        "darwin-kperf-sys",
        "error-stack",
        "error-stack-macros",
        "harpc-client",
        "harpc-codec",
        "harpc-net",
        "harpc-server",
        "harpc-system",
        "harpc-tower",
        "harpc-types",
        "harpc-wire-protocol",
        "hash-codec",
        "hash-codegen",
        "hash-graph-api",
        "hash-graph-authentication",
        "hash-graph-authorization",
        "hash-graph-embeddings",
        "hash-graph-migrations",
        "hash-graph-migrations-macros",
        "hash-graph-postgres-store",
        "hash-graph-store",
        "hash-graph-temporal-versioning",
        "hash-graph-test-data",
        "hash-graph-type-fetcher",
        "hash-graph-types",
        "hash-graph-validation",
        "hash-middleware",
        "hash-status",
        "hash-telemetry",
        "hash-temporal-client",
        "hashql-ast",
        "hashql-core",
        "hashql-diagnostics",
        "hashql-eval",
        "hashql-hir",
        "hashql-macros",
        "hashql-mir",
        "hashql-syntax-jexpr",
        "problematic",
        "type-system"
      ]
    },
    "test:unit": {
      "dependsOn": [
        "@hashintel/brunch-agent#build",
        "@hashintel/brunch-agent-plugin-sdcpn#build",
        "@hashintel/brunch-agent-transport-aisdk#build",
        "@hashintel/ds-components#build",
        "@hashintel/petrinaut#build",
        "@hashintel/petrinaut-core#build",
        "@local/petrinaut-optimizer-client#build",
        "codegen",
        "examples:generate"
      ],
      "env": [
        "TEST_COVERAGE"
      ]
    }
  }
}
