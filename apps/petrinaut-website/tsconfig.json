{
  "extends": ["@tsconfig/bases/vite-react", "@local/tsconfig/policy.json"],
  "compilerOptions": {
    "lib": ["DOM", "ESNext"],
    // Parameter properties remain in src/main/app/voice-interview/voice-audio-settings.ts
    // and two tests (TS1294).
    "erasableSyntaxOnly": false,
    // Implicit returns remain in src/main/app/plugins/brunch/chat/ai-assistant-panel.tsx, both
    // tool-summaries.ts files and src/server/voice/voice-request-guard.ts (TS7030).
    "noImplicitReturns": false
  },
  "include": ["src", "router-codegen-config.ts"]
}
