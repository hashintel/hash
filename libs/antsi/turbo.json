{
  "extends": ["//"],
  "tasks": {
    "fix:clippy": {
      "command": ["just", "clippy", "--fix"]
    },
    "lint:clippy": {
      "command": ["just", "clippy"]
    },
    "test:unit": {
      "command": [
        "mise",
        "run",
        "test:unit",
        "antsi",
        "--",
        "--no-tests",
        "warn"
      ]
    }
  }
}
