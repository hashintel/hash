{
  "package": "@blockprotocol/type-system",
  "dependencies": [
    "@local/eslint",
    "@local/hash-codec",
    "@local/tsconfig"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "@local/hash-codec#build",
        "codegen"
      ],
      "affectedBy": [
        "error-stack",
        "error-stack-macros",
        "harpc-types",
        "harpc-wire-protocol",
        "hash-codec",
        "hash-codegen",
        "hash-graph-temporal-versioning",
        "type-system"
      ]
    },
    "codegen": {
      "dependsOn": [
        "type-system#build:types",
        "type-system#build:wasm"
      ],
      "affectedBy": [
        "error-stack",
        "error-stack-macros",
        "harpc-types",
        "harpc-wire-protocol",
        "hash-codec",
        "hash-codegen",
        "hash-graph-temporal-versioning",
        "type-system"
      ]
    },
    "fix:eslint": {
      "dependsOn": [
        "@local/eslint#build",
        "@local/hash-codec#build",
        "codegen"
      ],
      "affectedBy": [
        "error-stack",
        "error-stack-macros",
        "harpc-types",
        "harpc-wire-protocol",
        "hash-codec",
        "hash-codegen",
        "hash-graph-temporal-versioning",
        "type-system"
      ]
    },
    "lint:eslint": {
      "dependsOn": [
        "@local/eslint#build",
        "@local/hash-codec#build",
        "codegen"
      ],
      "env": [
        "CHECK_TEMPORARILY_DISABLED_RULES"
      ],
      "affectedBy": [
        "error-stack",
        "error-stack-macros",
        "harpc-types",
        "harpc-wire-protocol",
        "hash-codec",
        "hash-codegen",
        "hash-graph-temporal-versioning",
        "type-system"
      ]
    },
    "lint:tsc": {
      "dependsOn": [
        "@local/eslint#build",
        "@local/hash-codec#build",
        "codegen"
      ],
      "affectedBy": [
        "error-stack",
        "error-stack-macros",
        "harpc-types",
        "harpc-wire-protocol",
        "hash-codec",
        "hash-codegen",
        "hash-graph-temporal-versioning",
        "type-system"
      ]
    },
    "test:unit": {
      "dependsOn": [
        "@local/hash-codec#build",
        "codegen"
      ],
      "env": [
        "TEST_COVERAGE"
      ],
      "affectedBy": [
        "error-stack",
        "error-stack-macros",
        "harpc-types",
        "harpc-wire-protocol",
        "hash-codec",
        "hash-codegen",
        "hash-graph-temporal-versioning",
        "type-system"
      ]
    }
  }
}
