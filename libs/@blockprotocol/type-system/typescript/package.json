{
  "name": "@blockprotocol/type-system",
  "version": "0.2.2",
  "description": "Definitions of types within the Block Protocol Type System",
  "homepage": "https://blockprotocol.org",
  "license": "MIT",
  "author": {
    "name": "HASH",
    "url": "https://hash.ai"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/hashintel/hash.git",
    "directory": "libs/@blockprotocol/type-system/typescript"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/es/main.js",
  "types": "./dist/es/main.d.ts",
  "typesVersions": {
    "*": {
      "*": [
        "./dist/es/main.d.ts"
      ],
      "slim": [
        "./dist/es-slim/main-slim.d.ts"
      ],
      "wasm": [
        "./dist/wasm/type-system.wasm.d.ts"
      ]
    }
  },
  "exports": {
    ".": "./dist/es/main.js",
    "./slim": "./dist/es-slim/main-slim.js",
    "./wasm": "./dist/wasm/type-system.wasm"
  },
  "scripts": {
    "build": "yarn clean && rolldown -c && tsc --project tsconfig.dist.json",
    "clean": "rimraf ./dist/",
    "codegen": "node scripts/copy-generated.ts",
    "compressed-size": "yarn build && find dist -iname '*.js' -exec npx terser@latest --compress --mangle --output {} -- {} \\;",
    "fix:eslint": "eslint --fix .",
    "lint:eslint": "eslint --report-unused-disable-directives .",
    "lint:tsc": "tsc --noEmit && tsc --noEmit --project tsconfig.generated.json",
    "postpublish": "PACKAGE_DIR=$(pwd) yarn workspace @local/repo-chores exe scripts/postpublish.ts",
    "prepack": "node ../../../../scripts/check-package-payload.mjs",
    "prepublishOnly": "turbo run build && tsx scripts/prepublish.ts && yarn build",
    "test:unit": "vitest --run"
  },
  "dependencies": {
    "semver": "7.7.3",
    "uuid": "14.0.0"
  },
  "devDependencies": {
    "@local/eslint": "workspace:*",
    "@local/hash-codec": "workspace:*",
    "@local/tsconfig": "workspace:*",
    "@rollup/plugin-wasm": "6.2.2",
    "@tsconfig/bases": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "19.2.14",
    "@types/semver": "7.7.1",
    "@vitest/coverage-istanbul": "catalog:",
    "eslint": "9.39.4",
    "react": "19.2.6",
    "rimraf": "6.1.3",
    "rolldown": "1.2.6",
    "rolldown-plugin-dts": "0.28.3",
    "tslib": "2.8.1",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-wasm-pack": "0.1.12",
    "vitest": "catalog:"
  }
}
