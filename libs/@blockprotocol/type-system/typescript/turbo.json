{
  "extends": ["//"],
  "tasks": {
    "codegen": {
      "dependsOn": [
        "^build",
        "@blockprotocol/type-system-rs#build:types",
        "@blockprotocol/type-system-rs#build:wasm",
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        {
          "mode": "dependencyOutputs",
          "globs": [
            "types/index.snap.d.ts",
            "pkg/type-system.d.ts",
          ],
          "from": [
            "@blockprotocol/type-system-rs#build:types",
            "@blockprotocol/type-system-rs#build:wasm",
          ]
        }
      ],
      "outputs": ["src/generated/**"]
    },
    "build": {
      "outputs": ["dist/**"]
    }
  }
}
