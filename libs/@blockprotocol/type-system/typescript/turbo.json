{
  "extends": ["//"],
  "tasks": {
    "manifest": {
      "dependsOn": ["^manifest", "type-system#manifest"]
    },
    "codegen": {
      "dependsOn": ["type-system#build:types", "type-system#build:wasm"],
      "outputs": ["src/generated/**"]
    },
    "build": {
      "dependsOn": ["codegen", "@local/hash-codec#build", "^manifest"],
      "outputs": ["dist/**"]
    },
    "test:unit": {
      "dependsOn": ["codegen", "@local/hash-codec#build", "^manifest"]
    }
  }
}
