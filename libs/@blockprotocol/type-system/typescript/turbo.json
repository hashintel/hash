{
  "extends": ["//"],
  "tasks": {
    "manifest": {
      "dependsOn": ["^manifest", "type-system#manifest"]
    },
    "codegen": {
      "dependsOn": ["type-system#build:types", "type-system#build:wasm"],
      "inputs": [
        "$TURBO_DEFAULT$",
        {
          "mode": "dependencyOutputs",
          "globs": ["types/index.snap.d.ts", "pkg/type-system.d.ts"],
          "from": ["type-system#build:types", "type-system#build:wasm"]
        }
      ],
      "outputs": ["src/generated/**"]
    },
    "build": {
      "dependsOn": ["codegen", "@local/hash-codec#build", "^manifest"],
      "outputs": ["dist/**"]
    },
    "test:unit": {
      "dependsOn": ["codegen", "@local/hash-codec#build", "^manifest"]
    }
  }
}
