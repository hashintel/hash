{
  "package": "@blockprotocol/type-system-rs",
  "dependencies": [
    "@rust/error-stack",
    "@rust/hash-codec",
    "@rust/hash-codegen",
    "@rust/hash-graph-temporal-versioning"
  ],
  "tasks": {
    "build:types": {
      "dependsOn": []
    },
    "build:wasm": {
