{
  "$schema": "https://turborepo.org/schema.json",
  "extends": ["//"],
  "tasks": {
    // Override the root `build -> codegen` dependency for this generated
    // artifact package. Without this, `ds-helpers#codegen ->
    // ds-components#codegen -> ds-helpers#build -> ds-helpers#codegen`
    // forms a cycle, because `ds-components#codegen` depends on `^build`.
    "build": {
      "dependsOn": []
    },
    "codegen": {
      // `ds-helpers` owns no source: `styled-system/` is generated by
      // `ds-components`' Panda config, into a directory private to that package,
      // and copied here by `scripts/sync-styled-system.mjs`. This task runs that
      // copy, which is what makes `turbo run codegen --filter
      // @hashintel/ds-helpers` (this package's `prepack`) materialize the
      // publishable payload before packing.
      "dependsOn": ["@hashintel/ds-components#codegen"],
      // Cache key inputs are this package's metadata and copy script plus the
      // source package files and scripts that determine the generated output.
      // The copy's actual source — `../ds-components/styled-system` — is itself
      // git-ignored generated output, so it cannot serve as an input; the inputs
      // that produce it stand in for it. The generated output here is likewise
      // git-ignored and is restored by Turbo from `outputs` below.
      "inputs": [
        "package.json",
        "turbo.json",
        "expected-payload.json",
        "scripts/sync-styled-system.mjs",
        "../ds-components/package.json",
        "../ds-components/panda.config.ts",
        "../ds-components/panda.local.config.ts",
        "../ds-components/scripts/**",
        "../ds-components/src/**"
      ],
      // `styled-system/**` is the only publishable artifact this package needs
      // to materialize before `npm pack`/`npm publish`.
      "outputs": ["styled-system/**"]
    }
  }
}
