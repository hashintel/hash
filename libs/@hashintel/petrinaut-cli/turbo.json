{
  "extends": ["//"],
  "tasks": {
    "codegen": {
      "dependsOn": ["@hashintel/petrinaut-core#build"],
      "outputs": ["schemas/**"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "test:unit": {
      "dependsOn": ["build", "codegen", "^build"],
      "env": ["TEST_COVERAGE"]
    }
  }
}
