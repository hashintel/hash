{
  "package": "@hashintel/petrinaut-cli",
  "dependencies": [
    "@hashintel/petrinaut-core"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "@hashintel/petrinaut-core#build"
      ],
      "affectedBy": [
        "petrinaut-optimizer-core"
      ]
    },
    "codegen": {
      "dependsOn": [
        "@hashintel/petrinaut-core#build"
      ],
      "affectedBy": [
        "petrinaut-optimizer-core"
      ]
    },
    "fix:eslint": {
      "dependsOn": [
        "@hashintel/petrinaut-core#build",
        "@local/eslint#build",
        "codegen"
      ],
      "affectedBy": [
        "petrinaut-optimizer-core"
      ]
    },
    "lint:eslint": {
      "dependsOn": [
        "@hashintel/petrinaut-core#build",
        "@local/eslint#build",
        "codegen"
      ],
      "env": [
        "CHECK_TEMPORARILY_DISABLED_RULES"
      ],
      "affectedBy": [
        "petrinaut-optimizer-core"
      ]
    },
    "lint:tsc": {
      "dependsOn": [
        "@hashintel/petrinaut-core#build",
        "codegen"
      ],
      "affectedBy": [
        "petrinaut-optimizer-core"
      ]
    },
    "test:unit": {
      "dependsOn": [
        "@hashintel/petrinaut-core#build",
        "build",
        "codegen"
      ],
      "env": [
        "TEST_COVERAGE"
      ],
      "affectedBy": [
        "petrinaut-optimizer-core"
      ]
    }
  }
}
