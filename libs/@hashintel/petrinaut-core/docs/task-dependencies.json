      "dependsOn": [
        "@local/petrinaut-optimizer-core#build"
      ],
      "affectedBy": [
        "petrinaut-optimizer-core"
      ]
    },
    "fix:eslint": {
      "dependsOn": [
        "@local/eslint#build",
        "@local/petrinaut-optimizer-core#build"
      ],
      "affectedBy": [
        "petrinaut-optimizer-core"
      ]
    },
    "lint:eslint": {
      "dependsOn": [
        "@local/eslint#build",
        "@local/petrinaut-optimizer-core#build"
      ],
      "env": [
        "CHECK_TEMPORARILY_DISABLED_RULES"
      ],
      "affectedBy": [
        "petrinaut-optimizer-core"
      ]
    },
    "lint:tsc": {
      "dependsOn": [
        "@local/petrinaut-optimizer-core#build"
      ],
      "affectedBy": [
        "petrinaut-optimizer-core"
      ]
    },
    "test:unit": {
      "dependsOn": [],
      "env": [
        "TEST_COVERAGE"
      ],
      "affectedBy": [
        "petrinaut-optimizer-core"
      ]
    }
  }
}
