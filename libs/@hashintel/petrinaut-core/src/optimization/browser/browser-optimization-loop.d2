# Hand-written; rendered by the arch-docs build.
shape: sequence_diagram

provider: Optimizations provider
capability: Browser capability
worker: Pyodide worker
optuna: Optuna (optimizer-core)
channel: Sweep evaluator (channel)
experiments: Experiments provider

one study: {
  provider -> capability: "createOptimizationRun(manifest, { parallelism })"
  capability -> capability: "started { requestedTrials } appended to the run log"
  capability -> worker: "start { runId, description, parallelism }"
  worker -> optuna: create_browser_study(description, parallelism), kept in a handle
  worker -> optuna: run_browser_study(handle, trials, evaluate, on_trial, is_cancelled), one segment
}

one trial, up to parallelism at a time: {
  optuna -> worker: ask and suggest values
  worker -> capability: "evaluate { runId, requestId, trial, suggestedValues }"
  capability -> channel: evaluateTrial(request) with the run's seeds and the segment's signal
  channel -> channel: "snap to the sweep's axes; an infeasible parameter constraint prunes here"
  channel -> experiments: "navigateSweep(experimentId, point, { runCap: seeds.length })"
  experiments -> provider: frames and progress stream into the followed selection
  experiments -> channel: "the visited cell's means once the point folded that many runs, or null when superseded"
  channel -> capability: "{ objective: mean, constraints } or { pruned, reason }"
  capability -> worker: "evaluated { requestId, outcome }"
  worker -> optuna: tell
  optuna -> worker: trial event with the running best
  worker -> capability: "trial { runId, event }"
  capability -> provider: trial event through attachOptimizationRun
}

segment end: {
  optuna -> worker: summary once the segment's trials are told
  worker -> capability: "complete { runId, summary }"
  capability -> provider: complete event through attachOptimizationRun
}

Stop: {
  provider -> capability: cancelOptimizationRun(runId)
  capability -> channel: the segment's signal aborts and the trials' runs cancel
  capability -> worker: "cancel { runId }"
  worker -> worker: pending evaluations resolve as pruned
  optuna -> worker: is_cancelled() is true at the next poll
  optuna -> optuna: trials in flight told failed, without an event
  optuna -> worker: summary with cancelled set
  worker -> capability: "cancelled { runId }"
  capability -> provider: cancelled error event through attachOptimizationRun
}

Extension (no editor surface calls it since the fold): {
  provider -> capability: extendOptimizationRun(runId, trials) after Complete or Stop
  capability -> capability: "started { requestedTrials } with the new total"
  capability -> worker: "extend { runId, trials }"
  worker -> optuna: run_browser_study on the kept handle, the next segment
}

Remove: {
  provider -> capability: releaseOptimizationRun(runId)
  capability -> worker: "release { runId }, nothing posted back"
  worker -> optuna: release_browser_study(handle)
}
