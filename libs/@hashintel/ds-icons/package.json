{
  "name": "@hashintel/ds-icons",
  "version": "0.0.3",
  "description": "HASH animated SVG icon set",
  "license": "(MIT OR Apache-2.0)",
  "repository": {
    "type": "git",
    "url": "https://github.com/hashintel/hash.git",
    "directory": "libs/@hashintel/ds-icons"
  },
  "files": [
    "assets/integrations",
    "CHANGELOG.md",
    "dist",
    "LICENSE",
    "LICENSE-APACHE.md",
    "LICENSE-MIT.md",
    "README.md",
    "THIRD-PARTY-NOTICES.md",
    "licenses"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./integrations": {
      "types": "./dist/integrations.d.ts",
      "default": "./dist/integrations.js"
    },
    "./integrations/svg/*": "./assets/integrations/*",
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./panda-preset": {
      "types": "./dist/panda-preset.d.ts",
      "default": "./dist/panda-preset.js"
    },
    "./panda.buildinfo.json": "./dist/panda.buildinfo.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "yarn build:lib && yarn build:buildinfo",
    "build:buildinfo": "panda ship --config panda.ship.config.ts --outfile dist/panda.buildinfo.json",
    "build:lib": "vite build",
    "build:pack": "node ../../../scripts/check-package-payload.mjs",
    "dev:lib": "vite build --watch",
    "fix:eslint": "oxlint --fix --type-aware --report-unused-disable-directives-severity=error .",
    "generate:integrations": "uv run --python python3 --script scripts/generate-integration-icons.py && oxfmt --write src/integration-icon-catalog.ts src/integration-icon/geometry.ts \"src/integration-icon/geometry/*.tsx\"",
    "lint:eslint": "oxlint --type-aware --report-unused-disable-directives-severity=error .",
    "lint:tsc": "tsc --noEmit",
    "prepack": "turbo run build:pack",
    "preview:integrations": "node scripts/preview-integrations.ts",
    "test:unit": "vitest run && uv run --python python3 --script scripts/test-generate-integration-icons.py"
  },
  "dependencies": {
    "@hashintel/ds-helpers": "workspace:^"
  },
  "devDependencies": {
    "@hashintel/ds-components": "workspace:*",
    "@pandacss/dev": "1.11.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "24.1.3",
    "oxc-transform-react": "0.152.0",
    "oxlint": "1.86.0",
    "oxlint-tsgolint": "7.0.2003",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "rolldown": "catalog:",
    "rolldown-plugin-dts": "0.28.3",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@hashintel/ds-helpers": "workspace:^",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
