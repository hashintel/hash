{
  "name": "@hashintel/ds-icons",
  "version": "0.0.0",
  "description": "HASH animated SVG icon set",
  "license": "(MIT OR Apache-2.0)",
  "repository": {
    "type": "git",
    "url": "https://github.com/hashintel/hash.git",
    "directory": "libs/@hashintel/ds-icons"
  },
  "files": [
    "CHANGELOG.md",
    "dist",
    "LICENSE",
    "LICENSE-APACHE.md",
    "LICENSE-MIT.md",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./panda-preset": {
      "types": "./dist/panda-preset.d.ts",
      "default": "./dist/panda-preset.js"
    },
    "./panda.buildinfo.json": "./dist/panda.buildinfo.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "yarn build:lib && yarn build:buildinfo",
    "build:buildinfo": "panda ship --config panda.ship.config.ts --outfile dist/panda.buildinfo.json",
    "build:lib": "vite build",
    "dev:lib": "vite build --watch",
    "fix:eslint": "oxlint --fix --type-aware --report-unused-disable-directives-severity=error .",
    "lint:eslint": "oxlint --type-aware --report-unused-disable-directives-severity=error .",
    "lint:tsc": "tsgo --noEmit",
    "prepack": "node ../../../scripts/check-package-payload.mjs",
    "prepublishOnly": "turbo run build",
    "test:unit": "vitest"
  },
  "dependencies": {
    "@hashintel/ds-helpers": "workspace:^"
  },
  "devDependencies": {
    "@hashintel/ds-components": "workspace:*",
    "@pandacss/dev": "1.11.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@typescript/native-preview": "7.0.0-dev.20260511.1",
    "@vitejs/plugin-react": "6.1.0",
    "jsdom": "24.1.3",
    "oxc-transform-react": "0.145.0",
    "oxlint": "1.63.0",
    "oxlint-tsgolint": "0.22.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "rolldown": "1.2.6",
    "rolldown-plugin-dts": "0.28.3",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  },
  "peerDependencies": {
    "@hashintel/ds-helpers": "workspace:^",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
