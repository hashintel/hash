{
  "extends": ["@tsconfig/bases/vite-react", "@local/tsconfig/policy.json"],
  "compilerOptions": {
    "lib": ["DOM", "ESNext"],
    // Parameter properties remain in src/ui/monaco/code-editor-activity.test.tsx and in
    // @local/petrinaut-optimizer-client, whose source this program checks (TS1294).
    "erasableSyntaxOnly": false,
    // Implicit returns remain in src/ui/views/Editor/panels/ai-assistant-panel.tsx and its
    // tool-summaries.ts (TS7030).
    "noImplicitReturns": false
  },
  "include": ["src", ".storybook/**/*"]
}
