{
  "package": "@hashintel/petrinaut",
  "dependencies": [
    "@hashintel/ds-components",
    "@hashintel/ds-helpers",
    "@hashintel/petrinaut-core",
    "@hashintel/refractive",
    "@local/petrinaut-optimizer-client"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "@hashintel/ds-components#build",
        "@hashintel/petrinaut-core#build",
        "@hashintel/refractive#build",
        "@local/petrinaut-optimizer-client#build"
      ],
      "affectedBy": [
        "petrinaut-optimization"
      ]
    },
    "dev": {
      "dependsOn": [
        "@hashintel/ds-components#build",
        "@hashintel/petrinaut-core#build",
        "@hashintel/refractive#build",
        "@local/petrinaut-optimizer-client#build"
      ],
      "cache": false,
      "persistent": true,
      "affectedBy": [
        "petrinaut-optimization"
      ]
    },
    "fix:eslint": {
      "dependsOn": [
        "@hashintel/ds-components#build",
        "@hashintel/petrinaut-core#build",
        "@hashintel/refractive#build",
        "@local/eslint#build",
        "@local/petrinaut-optimizer-client#build"
      ],
      "affectedBy": [
        "petrinaut-optimization"
      ]
    },
    "lint:eslint": {
      "dependsOn": [
        "@hashintel/ds-components#build",
        "@hashintel/petrinaut-core#build",
        "@hashintel/refractive#build",
        "@local/eslint#build",
        "@local/petrinaut-optimizer-client#build"
      ],
      "env": [
        "CHECK_TEMPORARILY_DISABLED_RULES"
      ],
      "affectedBy": [
        "petrinaut-optimization"
      ]
    },
    "lint:tsc": {
      "dependsOn": [
        "@hashintel/ds-components#build",
        "@hashintel/petrinaut-core#build",
        "@hashintel/refractive#build",
        "@local/petrinaut-optimizer-client#build"
      ],
      "affectedBy": [
        "petrinaut-optimization"
      ]
    },
    "test:unit": {
      "dependsOn": [
        "@hashintel/ds-components#build",
        "@hashintel/petrinaut-core#build",
        "@hashintel/refractive#build",
        "@local/petrinaut-optimizer-client#build"
      ],
      "env": [
        "TEST_COVERAGE"
      ],
      "affectedBy": [
        "petrinaut-optimization"
      ]
    }
  }
}
