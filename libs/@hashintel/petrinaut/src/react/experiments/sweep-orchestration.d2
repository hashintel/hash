# Hand-written; rendered by the arch-docs build. Palette matches src/emit/d2.ts.
direction: down

classes: {
  ui: {style.fill: "#e2f4e8"; style.stroke: "#3d8055"}
  react: {style.fill: "#e8e0ff"; style.stroke: "#7051b5"}
  core: {style.fill: "#dcecff"; style.stroke: "#3676b8"}
}

selection: "Navigator, surface pick" {class: ui}
optimizer: "Optimizer trial\nsweep trial evaluator" {class: react}
actions: "Actions context\nsetSweepSelection, navigateSweep" {class: react}
session: "Sweep session\nselection cache, at most 2 live rungs,\nvisited cells, run cap" {class: react}
batch: "instantiateBatch\nthe provider's" {class: react}
backend: "Chosen backend\nCPU worker pool or WebGPU" {class: core}
stores: "Experiment handle\nstatus, progress and metrics stores,\nevents stream" {class: core}
record: "Experiment record\nmetricFrames, sweep.visited, sweepBatches" {class: react}
views: "Metric charts, sweep surface,\nactivity list, top bar" {class: ui}

selection -> actions: "selects"
optimizer -> actions: "navigates to a point\nwith a run cap"
actions -> session: "restarts the ladder"
session -> batch: "asks for a rung's batch"
batch -> backend: "starts the batch on"
backend -> stores: "writes"
stores -> session: "stream frames\nand progress"
session -> record: "publishes frames and live batches,\nat most once per 100 ms"
record -> views: "renders"
session -> optimizer: "resolves the point's means\nonce they are cached" {style.stroke-dash: 4}
