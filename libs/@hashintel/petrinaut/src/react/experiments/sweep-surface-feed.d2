# Hand-written; rendered by the arch-docs build. Palette matches src/emit/d2.ts.
direction: right

selection: "a point is selected\n(navigator, plot click,\noptimizer trial)" {style.fill: "#e2f4e8"; style.stroke: "#3d8055"}
session: "sweep session\n(refine ladder, run cap)" {style.fill: "#e8e0ff"; style.stroke: "#7051b5"}
cache: "combination cache\n(finished batches per selection)" {style.fill: "#e8e0ff"; style.stroke: "#7051b5"}
visited: "visited cells\n(position, runs, means per metric)" {style.fill: "#e8e0ff"; style.stroke: "#7051b5"}
surface: "surface view\n(X, Y, metric picks;\nclick moves the navigator)" {style.fill: "#e2f4e8"; style.stroke: "#3d8055"}
contour: "contour raster\n(IDW + marching squares,\nBlues ramp)" {style.fill: "#e2f4e8"; style.stroke: "#3d8055"}

selection -> session: "restart the ladder there"
session -> cache: "fold a finished batch"
cache -> visited: "a point's means, on every fold"
visited -> surface: "record.sweep.visited"
session -> surface: "the point being computed,\nas a ring" {style.stroke-dash: 4}
surface -> contour: "dots, a ring, the field between"
