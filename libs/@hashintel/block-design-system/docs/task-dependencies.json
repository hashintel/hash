{
  "package": "@hashintel/block-design-system",
  "dependencies": [
    "@blockprotocol/graph",
    "@blockprotocol/type-system",
    "@hashintel/design-system",
    "@local/eslint",
    "@local/tsconfig"
  ],
  "tasks": {
    "fix:eslint": {
      "dependsOn": [
        "@blockprotocol/graph#build",
        "@blockprotocol/type-system#build",
        "@local/eslint#build"
      ],
      "affectedBy": [
        "error-stack",
        "error-stack-macros",
        "harpc-types",
        "harpc-wire-protocol",
        "hash-codec",
        "hash-codegen",
        "hash-graph-temporal-versioning",
        "type-system"
      ]
    },
    "lint:eslint": {
      "dependsOn": [
        "@blockprotocol/graph#build",
        "@blockprotocol/type-system#build",
        "@local/eslint#build"
      ],
      "env": [
        "CHECK_TEMPORARILY_DISABLED_RULES"
      ],
      "affectedBy": [
        "error-stack",
        "error-stack-macros",
        "harpc-types",
        "harpc-wire-protocol",
        "hash-codec",
        "hash-codegen",
        "hash-graph-temporal-versioning",
        "type-system"
      ]
    },
    "lint:tsc": {
      "dependsOn": [
        "@blockprotocol/graph#build",
        "@blockprotocol/type-system#build",
        "@local/eslint#build"
      ],
      "affectedBy": [
        "error-stack",
        "error-stack-macros",
        "harpc-types",
        "harpc-wire-protocol",
        "hash-codec",
        "hash-codegen",
        "hash-graph-temporal-versioning",
        "type-system"
      ]
    }
  }
}
