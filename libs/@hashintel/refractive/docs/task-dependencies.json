{
  "package": "@hashintel/refractive",
  "dependencies": [],
  "tasks": {
    "build": {
      "dependsOn": []
    },
    "build:pack": {
      "dependsOn": [
        "build"
      ],
      "cache": false
    },
    "dev": {
      "dependsOn": [],
      "cache": false,
      "persistent": true
    },
    "fix:eslint": {
      "dependsOn": [
        "@local/eslint#build"
      ]
    },
    "lint:eslint": {
      "dependsOn": [
        "@local/eslint#build"
      ],
      "env": [
        "CHECK_TEMPORARILY_DISABLED_RULES"
      ]
    },
    "lint:tsc": {
      "dependsOn": []
    },
    "test:unit": {
      "dependsOn": [],
      "env": [
        "TEST_COVERAGE"
      ]
    }
  }
}
