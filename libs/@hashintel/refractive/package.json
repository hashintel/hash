{
  "name": "@hashintel/refractive",
  "version": "0.0.4",
  "description": "HASH Refractive Filter Components",
  "license": "(MIT OR Apache-2.0)",
  "repository": {
    "type": "git",
    "url": "https://github.com/hashintel/hash.git",
    "directory": "libs/@hashintel/refractive"
  },
  "files": [
    "CHANGELOG.md",
    "dist",
    "LICENSE",
    "LICENSE-APACHE.md",
    "LICENSE-MIT.md",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "vite build",
    "build-storybook": "storybook build",
    "dev": "storybook dev -p ${PORT:-6007}",
    "dev:lib": "vite build --watch",
    "fix:eslint": "oxlint --fix --type-aware --report-unused-disable-directives-severity=error .",
    "lint:eslint": "oxlint --type-aware --report-unused-disable-directives-severity=error .",
    "lint:tsc": "tsc --noEmit",
    "prepack": "node ../../../scripts/check-package-payload.mjs",
    "prepublishOnly": "yarn build",
    "test:unit": "vitest"
  },
  "devDependencies": {
    "@local/tsconfig": "workspace:*",
    "@storybook/react-vite": "10.4.6",
    "@tsconfig/bases": "catalog:",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.0",
    "jsdom": "24.1.3",
    "oxc-transform-react": "0.145.0",
    "oxlint": "1.63.0",
    "oxlint-tsgolint": "0.22.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "rolldown": "1.2.6",
    "rolldown-plugin-dts": "0.28.3",
    "storybook": "10.4.6",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
