{
  "package": "@hashintel/design-system",
  "dependencies": [
    "@blockprotocol/type-system",
    "@local/eslint",
    "@local/tsconfig"
  ],
  "tasks": {
    "fix:eslint": {
      "dependsOn": [
        "@blockprotocol/type-system#build",
        "@local/eslint#build"
      ]
    },
    "lint:eslint": {
      "dependsOn": [
        "@blockprotocol/type-system#build",
        "@local/eslint#build"
      ],
      "env": [
        "CHECK_TEMPORARILY_DISABLED_RULES"
      ]
    },
    "lint:tsc": {
      "dependsOn": [
        "@blockprotocol/type-system#build",
        "@local/eslint#build"
      ]
    }
  }
}
