{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "extends": ["../../../.config/oxlint/brunch/base.json"],
  "categories": {
    "correctness": "error",
    "perf": "warn"
  },
  "env": {
    "builtin": true,
    "es2026": true,
    "node": true
  },
  "options": {
    "typeAware": true,
    "typeCheck": true
  },
  "rules": {
    "no-restricted-imports": [
      "error",
      {
        "paths": [
          {
            "name": "@hashintel/petrinaut",
            "message": "Brunch libraries must not depend on Petrinaut implementations."
          }
        ],
        "patterns": [
          {
            "group": ["@local/*"],
            "message": "Brunch libraries must remain independent of unpublished HASH packages."
          },
          {
            "group": ["@hashintel/petrinaut/*"],
            "message": "The Brunch library must not depend on Petrinaut implementations; it may consume published @hashintel/petrinaut-core contracts."
          },
          {
            "group": ["@earendil-works/*"],
            "message": "Lower-level Pi packages stay out of the Brunch library."
          }
        ]
      }
    ]
  },
  "ignorePatterns": [
    "dist/**",
    "build/**",
    "coverage/**",
    "*.gen.*",
    "*.tsbuildinfo",
    ".turbo/**"
  ]
}
