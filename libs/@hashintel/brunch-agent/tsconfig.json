{
  "extends": ["@tsconfig/bases/node22", "@local/tsconfig/policy.json"],
  "compilerOptions": {
    "isolatedModules": true,
    "jsx": "react-jsx",
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "noEmit": true,
    "types": ["node", "vite/client"]
  },
  "include": ["src"]
}
