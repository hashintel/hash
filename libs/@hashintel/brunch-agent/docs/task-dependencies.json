{
  "package": "@hashintel/brunch-agent",
  "dependencies": [
    "@hashintel/ds-components",
    "@hashintel/ds-helpers",
    "@hashintel/ds-icons",
    "@hashintel/petrinaut",
    "@hashintel/petrinaut-core",
    "@local/brunch-configs",
    "@local/flue-aisdk-transport",
    "@local/tsconfig"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "@hashintel/ds-components#build",
        "@hashintel/ds-components#codegen",
        "@hashintel/ds-icons#build",
        "@hashintel/petrinaut#build",
        "@hashintel/petrinaut-core#build",
        "@local/brunch-configs#build",
        "@local/flue-aisdk-transport#build"
      ],
      "affectedBy": [
        "petrinaut-optimizer-core"
      ]
    },
    "fix:eslint": {
      "dependsOn": [
        "@hashintel/ds-components#build",
        "@hashintel/ds-components#codegen",
        "@hashintel/ds-icons#build",
        "@hashintel/petrinaut#build",
        "@hashintel/petrinaut-core#build",
        "@local/brunch-configs#build",
        "@local/eslint#build",
        "@local/flue-aisdk-transport#build"
      ],
      "affectedBy": [
        "petrinaut-optimizer-core"
      ]
    },
    "lint:eslint": {
      "dependsOn": [
        "@hashintel/ds-components#build",
        "@hashintel/ds-components#codegen",
        "@hashintel/ds-icons#build",
        "@hashintel/petrinaut#build",
        "@hashintel/petrinaut-core#build",
        "@local/brunch-configs#build",
        "@local/eslint#build",
        "@local/flue-aisdk-transport#build"
      ],
      "env": [
        "CHECK_TEMPORARILY_DISABLED_RULES"
      ],
      "affectedBy": [
        "petrinaut-optimizer-core"
      ]
    },
    "lint:tsc": {
      "dependsOn": [
        "@hashintel/ds-components#build",
        "@hashintel/ds-components#codegen",
        "@hashintel/ds-icons#build",
        "@hashintel/petrinaut#build",
        "@hashintel/petrinaut-core#build",
        "@local/brunch-configs#build",
        "@local/flue-aisdk-transport#build"
      ],
      "affectedBy": [
        "petrinaut-optimizer-core"
      ]
    },
    "test:unit": {
      "dependsOn": [
        "@hashintel/ds-components#build",
        "@hashintel/ds-components#codegen",
        "@hashintel/ds-icons#build",
        "@hashintel/petrinaut#build",
        "@hashintel/petrinaut-core#build",
        "@local/brunch-configs#build",
        "@local/flue-aisdk-transport#build"
      ],
      "env": [
        "TEST_COVERAGE"
      ],
      "affectedBy": [
        "petrinaut-optimizer-core"
      ]
    }
  }
}
