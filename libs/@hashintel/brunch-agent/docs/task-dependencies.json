{
  "package": "@hashintel/brunch-agent",
  "dependencies": [
    "@hashintel/petrinaut-core",
    "@local/tsconfig"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "@hashintel/petrinaut-core#build"
      ]
    },
    "fix:eslint": {
      "dependsOn": [
        "@hashintel/petrinaut-core#build",
        "@local/eslint#build"
      ],
      "affectedBy": [
        "@local/eslint"
      ]
    },
    "lint:eslint": {
      "dependsOn": [
        "@hashintel/petrinaut-core#build",
        "@local/eslint#build"
      ],
      "env": [
        "CHECK_TEMPORARILY_DISABLED_RULES"
      ],
      "affectedBy": [
        "@local/eslint"
      ]
    },
    "lint:tsc": {
      "dependsOn": [
        "@hashintel/petrinaut-core#build"
      ]
    },
    "test:unit": {
      "dependsOn": [
        "@hashintel/petrinaut-core#build"
      ],
      "env": [
        "TEST_COVERAGE"
      ]
    }
  }
}
