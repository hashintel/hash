{
  "package": "@hashintel/brunch-agent-plugin-sdcpn",
  "dependencies": [
    "@hashintel/brunch-agent",
    "@hashintel/petrinaut-core"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "@hashintel/brunch-agent#build",
        "@hashintel/petrinaut-core#build"
      ]
    },
    "fix:eslint": {
      "dependsOn": [
        "@hashintel/brunch-agent#build",
        "@hashintel/petrinaut-core#build",
        "@local/eslint#build"
      ]
    },
    "lint:eslint": {
      "dependsOn": [
        "@hashintel/brunch-agent#build",
        "@hashintel/petrinaut-core#build",
        "@local/eslint#build"
      ],
      "env": [
        "CHECK_TEMPORARILY_DISABLED_RULES"
      ]
    },
    "lint:tsc": {
      "dependsOn": [
        "@hashintel/brunch-agent#build",
        "@hashintel/petrinaut-core#build"
      ]
    },
    "test:unit": {
      "dependsOn": [
        "@hashintel/brunch-agent#build",
        "@hashintel/petrinaut-core#build"
      ],
      "env": [
        "TEST_COVERAGE"
      ]
    }
  }
}
