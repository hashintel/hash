{
  "name": "@hashintel/brunch-agent-plugin-sdcpn",
  "version": "0.0.0-private",
  "private": true,
  "description": "The operational-process domain typology and SDCPN target formalism: Flue-native prompt, job skill, and Petrinaut construction tools.",
  "license": "AGPL-3.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "@dev/source": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./flue": {
      "types": "./src/flue.ts",
      "@dev/source": "./src/flue.ts",
      "import": "./dist/flue.js"
    },
    "./skills/sdcpn-modelling/SKILL.md": "./src/skills/sdcpn-modelling/SKILL.md"
  },
  "scripts": {
    "build": "vite build",
    "fix:eslint": "oxlint --fix --type-aware --type-check --report-unused-disable-directives-severity=error .",
    "lint:eslint": "oxlint --type-aware --type-check --report-unused-disable-directives-severity=error .",
    "lint:tsc": "tsc --noEmit",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@flue/runtime": "2.0.3",
    "@hashintel/brunch-agent": "workspace:*",
    "@hashintel/petrinaut-core": "workspace:*",
    "valibot": "1.4.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@local/tsconfig": "workspace:*",
    "@tsconfig/bases": "catalog:",
    "@types/node": "catalog:",
    "oxlint": "1.63.0",
    "oxlint-tsgolint": "0.22.1",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
