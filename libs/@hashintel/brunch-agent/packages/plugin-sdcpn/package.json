{
  "name": "@hashintel/brunch-agent-plugin-sdcpn",
  "version": "0.0.0-private",
  "private": true,
  "description": "The operational-process domain typology and SDCPN target formalism: Flue-native prompt, job skill, and Petrinaut construction tools.",
  "license": "AGPL-3.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "@dev/source": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./agent": {
      "types": "./src/agent.ts",
      "@dev/source": "./src/agent.ts",
      "import": "./dist/agent.js"
    },
    "./flue": {
      "types": "./src/flue.ts",
      "@dev/source": "./src/flue.ts",
      "import": "./dist/flue.js"
    },
    "./worked-model": {
      "types": "./src/worked-model-net-projection.ts",
      "@dev/source": "./src/worked-model-net-projection.ts",
      "import": "./dist/worked-model.js"
    },
    "./skills/sdcpn-modelling/SKILL.md": "./src/skills/sdcpn-modelling/SKILL.md"
  },
  "scripts": {
    "build": "vite build",
    "fix:eslint": "oxlint --fix --type-aware --type-check --report-unused-disable-directives-severity=error .",
    "lint:eslint": "oxlint --type-aware --type-check --report-unused-disable-directives-severity=error .",
    "lint:tsc": "tsgo --noEmit",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@flue/runtime": "2.0.3",
    "@hashintel/brunch-agent": "workspace:*",
    "@hashintel/petrinaut-core": "workspace:*",
    "valibot": "1.4.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@flue/vite": "2.0.3",
    "@types/node": "22.18.13",
    "@typescript/native-preview": "7.0.0-dev.20260511.1",
    "oxlint": "1.63.0",
    "oxlint-tsgolint": "0.22.1",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
