{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "extends": ["../../../../../.config/oxlint/brunch/base.json"],
  "categories": {
    "correctness": "error",
    "perf": "warn"
  },
  "env": {
    "builtin": true,
    "es2026": true,
    "node": true
  },
  "options": {
    "typeAware": true,
    "typeCheck": true
  },
  "rules": {
    "no-restricted-imports": [
      "error",
      {
        "paths": [
          {
            "name": "@hashintel/brunch-agent/storage",
            "message": "Plugins receive harness capabilities and must remain storage-blind."
          },
          {
            "name": "@hashintel/petrinaut",
            "message": "Brunch libraries must not depend on Petrinaut implementations."
          }
        ],
        "patterns": [
          {
            "group": ["@local/*"],
            "message": "Brunch libraries must remain independent of unpublished HASH packages."
          },
          {
            "group": ["@hashintel/petrinaut/*", "@hashintel/petrinaut-*"],
            "message": "Brunch libraries must not depend on Petrinaut implementations."
          },
          {
            "group": ["@flue/*", "@earendil-works/*"],
            "message": "Brunch plugins must remain substrate-independent."
          },
          {
            "group": ["@hashintel/brunch-agent-*"],
            "message": "A plugin may depend inward on the harness, not on Brunch extensions."
          }
        ]
      }
    ]
  },
  "ignorePatterns": [
    "dist/**",
    "build/**",
    "coverage/**",
    "*.gen.*",
    "*.tsbuildinfo",
    ".turbo/**"
  ]
}
