{
  "name": "@hashintel/brunch-agent-plugin-dafny",
  "version": "0.0.0-private",
  "private": true,
  "description": "The software-correctness domain typology and Dafny target formalism: a stubbed Flue-native contribution bundle that pressure-tests the core/plugin boundary.",
  "license": "AGPL-3.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "@dev/source": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./agent": {
      "types": "./src/agent.ts",
      "@dev/source": "./src/agent.ts",
      "import": "./dist/agent.js"
    },
    "./skills/dafny-verification/SKILL.md": "./src/skills/dafny-verification/SKILL.md"
  },
  "scripts": {
    "build": "vite build",
    "fix:eslint": "oxlint --fix --type-aware --type-check --report-unused-disable-directives-severity=error .",
    "lint:eslint": "oxlint --type-aware --type-check --report-unused-disable-directives-severity=error .",
    "lint:tsc": "tsgo --noEmit",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@flue/runtime": "2.0.3"
  },
  "devDependencies": {
    "@flue/vite": "2.0.3",
    "@types/node": "22.18.13",
    "@typescript/native-preview": "7.0.0-dev.20260511.1",
    "oxlint": "1.63.0",
    "oxlint-tsgolint": "0.22.1",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
