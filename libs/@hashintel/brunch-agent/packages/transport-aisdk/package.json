{
  "name": "@hashintel/brunch-agent-transport-aisdk",
  "version": "0.0.0-private",
  "private": true,
  "description": "AI SDK UI-message-stream transport for Flue-backed chat.",
  "license": "AGPL-3.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./client-tools": {
      "types": "./src/client-tools.ts",
      "import": "./dist/client-tools.js"
    },
    "./headers": {
      "types": "./src/headers.ts",
      "import": "./dist/headers.js"
    }
  },
  "scripts": {
    "build": "vite build",
    "fix:eslint": "oxlint --fix --type-aware --type-check --report-unused-disable-directives-severity=error .",
    "lint:eslint": "oxlint --type-aware --type-check --report-unused-disable-directives-severity=error .",
    "lint:tsc": "tsgo --noEmit",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@hashintel/brunch-agent": "workspace:*",
    "ai": "6.0.182",
    "valibot": "1.4.2"
  },
  "devDependencies": {
    "@types/node": "22.18.13",
    "@typescript/native-preview": "7.0.0-dev.20260511.1",
    "oxlint": "1.63.0",
    "oxlint-tsgolint": "0.22.1",
    "vite": "8.1.0",
    "vitest": "4.1.10"
  }
}
