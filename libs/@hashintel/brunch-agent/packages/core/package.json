{
  "name": "@hashintel/brunch-agent",
  "version": "0.0.0-private",
  "private": true,
  "description": "The Brunch harness client contracts and Flue-native core agent contribution.",
  "license": "AGPL-3.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "@dev/source": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./constants": {
      "types": "./src/constants.ts",
      "@dev/source": "./src/constants.ts",
      "import": "./dist/constants.js"
    },
    "./client-tools": {
      "types": "./src/client-tools.ts",
      "@dev/source": "./src/client-tools.ts",
      "import": "./dist/client-tools.js"
    },
    "./flue": {
      "types": "./src/flue.ts",
      "@dev/source": "./src/flue.ts",
      "import": "./dist/flue.js"
    },
    "./workpiece": {
      "types": "./src/workpiece.ts",
      "@dev/source": "./src/workpiece.ts",
      "import": "./dist/workpiece.js"
    },
    "./skills/elicitation/SKILL.md": "./src/skills/elicitation/SKILL.md"
  },
  "scripts": {
    "build": "vite build",
    "fix:eslint": "oxlint --fix --type-aware --type-check --report-unused-disable-directives-severity=error .",
    "lint:eslint": "oxlint --type-aware --type-check --report-unused-disable-directives-severity=error .",
    "lint:tsc": "tsgo --noEmit",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@flue/runtime": "2.0.3",
    "valibot": "1.4.2"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "0.74.0",
    "@types/node": "22.18.13",
    "@typescript/native-preview": "7.0.0-dev.20260511.1",
    "fast-check": "4.9.0",
    "oxlint": "1.63.0",
    "oxlint-tsgolint": "0.22.1",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
