(version 1)
(allow default)
(deny network*)
; Local tool IPC and the existing SSH signing agent only. No IP sockets.
(allow network* (regex "^(/private)?/(tmp|var/folders/[^/]+/[^/]+/T)/tsx-[0-9]+/[0-9]+[.]pipe$"))
(allow network-outbound (literal (param "SIGNING_SOCKET")))
(allow network-outbound (literal (param "SIGNING_SOCKET_REAL")))
