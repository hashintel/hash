{
  "name": "@hashintel/brunch-agent",
  "version": "0.0.0-private",
  "private": true,
  "description": "Brunch's shared contracts (the root entry) and its browser client: the runtime (./client), the React plugin, chat and cards (./ui), and Voice's web-standard handlers (./server). Used by the Brunch agent app (root only) and the Petrinaut website.",
  "license": "AGPL-3.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "@dev/source": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./src/client.ts",
      "@dev/source": "./src/client.ts",
      "import": "./dist/client.js"
    },
    "./ui": {
      "types": "./src/ui.ts",
      "@dev/source": "./src/ui.ts",
      "import": "./dist/ui.js"
    },
    "./server": {
      "types": "./src/server.ts",
      "@dev/source": "./src/server.ts",
      "import": "./dist/server.js"
    },
    "./interview-budget": {
      "types": "./src/petrinaut/interview-budget.ts",
      "@dev/source": "./src/petrinaut/interview-budget.ts",
      "import": "./dist/interview-budget.js"
    },
    "./words": {
      "types": "./src/petrinaut/words.ts",
      "@dev/source": "./src/petrinaut/words.ts",
      "import": "./dist/words.js"
    },
    "./panda.buildinfo.json": "./dist/panda.buildinfo.json"
  },
  "scripts": {
    "build": "vite build && yarn build:buildinfo",
    "build:buildinfo": "panda ship --outfile dist/panda.buildinfo.json",
    "fix:eslint": "oxlint --fix --type-aware --type-check --report-unused-disable-directives-severity=error .",
    "lint:eslint": "oxlint --type-aware --type-check --report-unused-disable-directives-severity=error .",
    "lint:tsc": "tsgo --noEmit",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@ai-sdk/react": "3.0.289",
    "@ark-ui/react": "5.38.1",
    "@flue/sdk": "2.3.0",
    "@hashintel/petrinaut-core": "workspace:*",
    "@local/flue-aisdk-transport": "workspace:*",
    "ai": "6.0.286",
    "md-pen": "1.2.0",
    "react-icons": "5.5.0",
    "react-markdown": "10.1.0",
    "valibot": "1.4.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@hashintel/ds-components": "workspace:*",
    "@hashintel/ds-helpers": "workspace:*",
    "@hashintel/ds-icons": "workspace:*",
    "@hashintel/petrinaut": "workspace:*",
    "@local/tsconfig": "workspace:*",
    "@pandacss/dev": "1.11.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@tsconfig/bases": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@typescript/native-preview": "7.0.0-dev.20260511.1",
    "@vitejs/plugin-react": "6.1.1",
    "@whatwg-node/server": "0.10.18",
    "jsdom": "24.1.3",
    "monaco-editor": "0.55.1",
    "oxc-transform-react": "0.152.0",
    "oxlint": "1.86.0",
    "oxlint-tsgolint": "7.0.2003",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@hashintel/ds-components": "workspace:*",
    "@hashintel/ds-helpers": "workspace:*",
    "@hashintel/ds-icons": "workspace:*",
    "@hashintel/petrinaut": "workspace:*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
