{
  "name": "@hashintel/brunch-agent",
  "version": "0.0.0-private",
  "private": true,
  "description": "Contracts the Brunch agent app and the Petrinaut website share: constants, conversation identity, the browser-tool and Petrinaut tool contracts, and the Ledger. Browser-safe; no Flue runtime.",
  "license": "AGPL-3.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "@dev/source": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./interview-budget": {
      "types": "./src/petrinaut/interview-budget.ts",
      "@dev/source": "./src/petrinaut/interview-budget.ts",
      "import": "./dist/interview-budget.js"
    },
    "./words": {
      "types": "./src/petrinaut/words.ts",
      "@dev/source": "./src/petrinaut/words.ts",
      "import": "./dist/words.js"
    }
  },
  "scripts": {
    "build": "vite build",
    "fix:eslint": "oxlint --fix --type-aware --type-check --report-unused-disable-directives-severity=error .",
    "lint:eslint": "oxlint --type-aware --type-check --report-unused-disable-directives-severity=error .",
    "lint:tsc": "tsgo --noEmit",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@flue/sdk": "2.3.0",
    "@hashintel/petrinaut-core": "workspace:*",
    "md-pen": "1.2.0",
    "valibot": "1.4.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@local/tsconfig": "workspace:*",
    "@tsconfig/bases": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native-preview": "7.0.0-dev.20260511.1",
    "oxlint": "1.86.0",
    "oxlint-tsgolint": "7.0.2003",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
