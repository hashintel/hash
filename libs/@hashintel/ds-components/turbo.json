{
  "$schema": "https://turborepo.org/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "dependsOn": ["codegen", "^build"],
      "outputs": ["dist/**"]
    },
    "build:buildinfo": {
      "dependsOn": ["codegen"],
      "outputs": ["dist/panda.buildinfo.json"]
    },
    "build:lib": {
      "dependsOn": ["codegen", "^build"],
      "outputs": ["dist/**"]
    },
    "build:storybook": {
      "dependsOn": ["codegen", "^build"],
      "outputs": [".build/storybook/**"]
    },
    "codegen": {
      "outputs": [
        "src/preset/**/*.gen.ts",
        "docs/blocks/props-table/*.gen.ts",
        "../ds-helpers/styled-system/**"
      ]
    },
    "dev": {
      "cache": false,
      "dependsOn": ["codegen", "^build"],
      "passThroughEnv": ["PORT"],
      "persistent": true
    },
    "dev:storybook": {
      "cache": false,
      "dependsOn": ["codegen", "^build"],
      "passThroughEnv": ["PORT"],
      "persistent": true
    },
    "fix": {
      "dependsOn": ["codegen"]
    },
    "lint": {
      "dependsOn": ["codegen"]
    },
    "preview:storybook": {
      "dependsOn": ["build:storybook"]
    },
    "test:snapshots": {
      "dependsOn": ["build:storybook"]
    },
    "test:snapshots:update": {
      "dependsOn": ["build:storybook"]
    },
    "test:unit": {
      "dependsOn": ["build:buildinfo"],
      "env": ["TEST_COVERAGE"]
    }
  }
}
