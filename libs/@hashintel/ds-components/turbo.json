{
  "$schema": "https://turborepo.org/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "dependsOn": ["codegen", "^build"],
      "outputs": ["dist/**"]
    },
    "build:buildinfo": {
      "dependsOn": ["codegen"],
      "outputs": ["dist/panda.buildinfo.json"]
    },
    "build:ladle": {
      "dependsOn": ["codegen", "^build"],
      "outputs": [".build/ladle/**"]
    },
    "build:lib": {
      "dependsOn": ["codegen", "^build"],
      "outputs": ["dist/**"]
    },
    "codegen": {
      "outputs": ["src/preset/**/*.gen.ts", "../ds-helpers/styled-system/**"]
    },
    "dev": {
      "cache": false,
      "dependsOn": ["codegen", "^build"],
      "persistent": true
    },
    "dev:ladle": {
      "cache": false,
      "dependsOn": ["codegen", "^build"],
      "persistent": true
    },
    "fix": {
      "dependsOn": ["codegen"]
    },
    "lint": {
      "dependsOn": ["codegen"]
    },
    "preview:ladle": {
      "dependsOn": ["build:ladle"]
    },
    "test:snapshots": {
      "dependsOn": ["build:ladle"]
    },
    "test:snapshots:update": {
      "dependsOn": ["build:ladle"]
    },
    "test:unit": {
      "dependsOn": ["build:buildinfo"],
      "env": ["TEST_COVERAGE"]
    }
  }
}
