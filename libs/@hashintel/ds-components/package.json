{
  "name": "@hashintel/ds-components",
  "version": "0.5.1",
  "description": "HASH Component Library built with React, Ark UI, and PandaCSS",
  "license": "(MIT OR Apache-2.0)",
  "repository": {
    "type": "git",
    "url": "https://github.com/hashintel/hash.git",
    "directory": "libs/@hashintel/ds-components"
  },
  "files": [
    "CHANGELOG.md",
    "dist",
    "LICENSE",
    "LICENSE-APACHE.md",
    "LICENSE-MIT.md",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/main.js",
  "module": "./dist/main.js",
  "types": "./dist/main.d.ts",
  "exports": {
    "./preset": {
      "types": "./dist/preset.d.ts",
      "import": "./dist/preset.js"
    },
    "./tokens": {
      "types": "./dist/tokens.d.ts",
      "import": "./dist/tokens.js"
    },
    "./panda.buildinfo.json": "./dist/panda.buildinfo.json",
    "./docs/panda.buildinfo.json": "./dist/docs/panda.buildinfo.json",
    "./docs/rehype-markdown-class": {
      "types": "./dist/docs/rehype-markdown-class.d.ts",
      "import": "./dist/docs/rehype-markdown-class.js"
    },
    "./docs/mdx/*": "./dist/docs/mdx/*",
    "./docs/blocks/*": {
      "types": "./dist/docs/blocks/*.d.ts",
      "import": "./dist/docs/blocks/*.js"
    },
    "./docs/demos/*": {
      "import": "./dist/docs/demos/*.js"
    },
    "./*": {
      "types": "./dist/components/*.d.ts",
      "import": "./dist/components/*.js"
    },
    ".": {
      "types": "./dist/main.d.ts",
      "import": "./dist/main.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "npm-run-all build:docs-demos build:lib build:docs-mdx build:buildinfo build:buildinfo:docs",
    "build:buildinfo": "panda ship --config panda.config.ts --outfile dist/panda.buildinfo.json",
    "build:buildinfo:docs": "panda ship --config panda.docs.config.ts --outfile dist/docs/panda.buildinfo.json",
    "build:docs-demos": "tsx scripts/generate-docs-demos.ts",
    "build:docs-mdx": "tsx scripts/generate-docs-mdx.ts",
    "build:lib": "npm-run-all build:lib:js build:lib:dts",
    "build:lib:dts": "tsc -p tsconfig.dts.json && tsx scripts/generate-flat-dts.ts",
    "build:lib:js": "tsup --config tsup.config.ts",
    "build:pack": "node ../../../scripts/check-package-payload.mjs",
    "build:storybook": "storybook build -o .build/storybook",
    "codegen": "yarn run codegen:colors && yarn run codegen:tokens && yarn run codegen:panda && yarn run codegen:docgen",
    "codegen:colors": "tsx scripts/generate-colors-radix.ts",
    "codegen:docgen": "tsx scripts/generate-docgen-registry.ts",
    "codegen:panda": "panda codegen --clean",
    "codegen:tokens": "tsx scripts/generate-tokens.ts",
    "dev": "yarn dev:storybook",
    "dev:lib": "tsup --config tsup.config.ts --watch",
    "dev:storybook": "NODE_OPTIONS=--dns-result-order=ipv4first storybook dev -p \"${PORT:-61000}\" --ci --no-version-updates",
    "fix": "npm-run-all --continue-on-error \"fix:*\"",
    "fix:eslint": "eslint --cache --fix .",
    "fix:format": "oxfmt --write",
    "lint": "npm-run-all --continue-on-error \"lint:*\"",
    "lint:eslint": "eslint --cache --report-unused-disable-directives .",
    "lint:tsc": "tsc --noEmit",
    "prepack": "turbo run build:pack",
    "preview:storybook": "yarn build:storybook && vite preview --outDir .build/storybook --strictPort --port \"${PORT:-61000}\"",
    "test:snapshots": "yarn build:storybook && playwright test",
    "test:snapshots:update": "yarn build:storybook && playwright test --update-snapshots",
    "test:unit": "yarn build:buildinfo && vitest run --exclude tests/snapshots.spec.ts",
    "test:unit:watch": "yarn build:buildinfo && vitest --exclude tests/snapshots.spec.ts"
  },
  "dependencies": {
    "@ark-ui/react": "5.38.1",
    "@deck.gl/core": "9.3.6",
    "@deck.gl/layers": "9.3.6",
    "@deck.gl/react": "9.3.6",
    "@deck.gl/widgets": "9.3.6",
    "@hashintel/ds-helpers": "workspace:^",
    "@loaders.gl/core": "4.4.3",
    "@luma.gl/core": "9.3.6",
    "@luma.gl/engine": "9.3.6",
    "@luma.gl/shadertools": "9.3.6",
    "@pandacss/dev": "1.11.1",
    "@pandacss/preset-panda": "1.11.1",
    "@zag-js/dom-query": "1.43.0",
    "colorjs.io": "0.6.1",
    "type-fest": "5.3.1",
    "use-callback-ref": "1.3.3"
  },
  "devDependencies": {
    "@fontsource-variable/geist-mono": "5.2.7",
    "@fontsource-variable/inter": "5.2.8",
    "@fontsource-variable/inter-tight": "5.2.7",
    "@local/eslint": "workspace:*",
    "@local/tsconfig": "workspace:*",
    "@mantine/hooks": "8.3.5",
    "@mdx-js/mdx": "^3.1.1",
    "@playwright/test": "1.58.2",
    "@radix-ui/colors": "3.0.0",
    "@storybook/addon-docs": "10.4.6",
    "@storybook/icons": "^2.1.0",
    "@storybook/react-vite": "10.4.6",
    "@tanstack/react-form": "1.29.0",
    "@tanstack/react-virtual": "3.13.24",
    "@tsconfig/bases": "catalog:",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/node": "catalog:",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/browser-playwright": "4.1.11",
    "case-anything": "3.1.0",
    "esbuild-plugin-svgr": "3.1.1",
    "eslint": "9.39.4",
    "lorem-ipsum": "2.0.8",
    "lucide-react": "0.544.0",
    "mdast-util-mdx-jsx": "^3.0.0",
    "npm-run-all2": "8.0.4",
    "oxc-transform-react": "0.152.0",
    "prism-react-renderer": "2.4.1",
    "react": "19.2.6",
    "react-docgen-typescript": "^2.2.2",
    "react-dom": "19.2.6",
    "react-markdown": "10.1.0",
    "remark-frontmatter": "5.0.0",
    "remark-gfm": "4.0.1",
    "remark-mdx": "^3.1.1",
    "remark-parse": "^11.0.0",
    "storybook": "10.6.2",
    "tsup": "^8.5.1",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "unified": "^11.0.5",
    "vfile": "^6.0.3",
    "vite": "catalog:",
    "vite-plugin-svgr": "5.2.0",
    "vitest": "catalog:",
    "vitest-browser-react": "^2.0.2",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "@ark-ui/react": "^5.38.1",
    "@hashintel/ds-helpers": "workspace:^",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  }
}
