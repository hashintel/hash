{
  "extends": ["@tsconfig/bases/recommended", "@local/tsconfig/policy.json"],
  "compilerOptions": {
    "jsx": "preserve",
    "lib": ["dom", "ESNext"],
    "module": "ESNext",
    "noEmit": true,
    // Implicit returns remain in src/entity-type-editor/shared/entity-type-table.tsx and
    // the @hashintel/design-system sources this program checks (TS7030).
    "noImplicitReturns": false
  },
  "include": ["assets.d.ts", "theme-override.d.ts", "./src/"]
}
