{
  "extends": ["//"],
  "tasks": {
    "lint:types": {
      "command": [
        "uv",
        "run",
        "--active",
        "--frozen",
        "--all-packages",
        "basedpyright"
      ],
      "passThroughEnv": ["UV_CACHE_DIR"]
    },
    "lint:ruff": {
      "command": [
        "uv",
        "run",
        "--active",
        "--frozen",
        "--all-packages",
        "ruff",
        "check",
        "."
      ],
      "passThroughEnv": ["UV_CACHE_DIR"]
    },
    "format:ruff": {
      "command": [
        "uv",
        "run",
        "--active",
        "--frozen",
        "--all-packages",
        "ruff",
        "format",
        "."
      ],
      "passThroughEnv": ["UV_CACHE_DIR"]
    },
    "test:unit": {
      "dependsOn": ["^manifest"],
      "passThroughEnv": ["UV_CACHE_DIR"],
      "command": [
        "uv",
        "run",
        "--active",
        "--frozen",
        "--all-packages",
        "pytest",
        "."
      ]
    }
  }
}
