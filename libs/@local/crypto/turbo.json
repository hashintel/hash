{
  "extends": ["//"],
  "tasks": {
    "doc:dependency-diagram": {
      "command": [
        "cargo",
        "run",
        "-p",
        "hash-repo-chores",
        "--",
        "dependency-diagram",
        "--output",
        "docs/dependency-diagram.mmd",
        "--root",
        "hash-crypto",
        "--root-deps-and-dependents",
        "--link-mode",
        "non-roots",
        "--include-dev-deps",
        "--include-build-deps",
        "--logging-console-level",
        "info"
      ]
    },
    "fix:clippy": {
      "command": ["just", "clippy", "--fix"]
    },
    "lint:clippy": {
      "command": ["just", "clippy"]
    },
    "test:miri": {
      "command": [
        "env",
        "MIRIFLAGS=-Zmiri-recursive-validation",
        "cargo",
        "miri",
        "nextest",
        "run",
        "--lib",
        "--test",
        "zeroing"
      ]
    },
    "test:unit": {
      "command": ["mise", "run", "test:unit", "hash-crypto"]
    },
    "test:unit:bless": {
      "cache": false,
      "command": [
        "env",
        "TRYBUILD=overwrite",
        "mise",
        "run",
        "test:unit",
        "hash-crypto"
      ]
    }
  }
}
