{
  "extends": ["//"],
  "tasks": {
    "doc:dependency-diagram": {
      "command": [
        "cargo",
        "run",
        "-p",
        "hash-repo-chores",
        "--",
        "dependency-diagram",
        "--output",
        "docs/dependency-diagram.mmd",
        "--root",
        "hash-codegen",
        "--root-deps-and-dependents",
        "--link-mode",
        "non-roots",
        "--include-dev-deps",
        "--include-build-deps",
        "--logging-console-level",
        "info"
      ]
    },
    "fix:clippy": {
      "command": ["just", "clippy", "--fix"]
    },
    "lint:clippy": {
      "command": ["just", "clippy"]
    },
    "test:unit": {
      "command": [
        "cargo",
        "hack",
        "nextest",
        "run",
        "--feature-powerset",
        "--all-targets"
      ],
      "dependsOn": ["^manifest", "test:unit:doc"]
    },
    "test:unit:doc": {
      "command": ["cargo", "test", "--all-features", "--doc"],
      "dependsOn": ["^manifest"]
    }
  }
}
