{
  "extends": [
    "@tsconfig/bases/recommended",
    "@local/tsconfig/policy.json"
  ],
  "compilerOptions": {
    "target": "ESNext",
    "lib": [
      "ESNext",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "preserve",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "allowJs": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [
      "vite/client",
      "node"
    ],
    "rootDir": "..",
    "allowImportingTsExtensions": true
  },
  "include": [
    "src",
    "vite.config.ts",
    "prerender.ts"
  ],
  "exclude": [
    "src/content",
    "dist"
  ]
}
