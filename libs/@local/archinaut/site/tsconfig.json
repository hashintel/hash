{
  "extends": ["@tsconfig/bases/recommended", "@local/tsconfig/policy.json"],
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "allowJs": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["vite/client", "node"],
    "rootDir": "..",
    "allowImportingTsExtensions": true,
    "paths": {
      "@archinaut/slides": ["./src/slides/index.ts"]
    }
  },
  "include": ["src", "examples", "vite.config.ts", "prerender.ts", "prerender"],
  "exclude": ["src/content", "dist"]
}
