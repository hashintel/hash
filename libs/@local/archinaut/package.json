{
  "name": "@local/archinaut",
  "version": "0.0.0-private",
  "private": true,
  "description": "Architecture model and docs generator: annotations in the source plus symbol facts from the compilers, checked on every build",
  "license": "(MIT OR Apache-2.0)",
  "bin": "./bin/archinaut.js",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/archinaut.ts",
      "default": "./src/archinaut.ts"
    }
  },
  "scripts": {
    "fix:eslint": "oxlint --fix --report-unused-disable-directives-severity=error .",
    "lint:eslint": "oxlint --report-unused-disable-directives-severity=error .",
    "lint:tsc": "tsc --noEmit && tsc --noEmit -p site/tsconfig.json",
    "test:unit": "vitest --run src"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.2.8",
    "@fontsource-variable/jetbrains-mono": "5.2.8",
    "@mdx-js/react": "3.1.1",
    "@mdx-js/rollup": "3.1.1",
    "@shikijs/rehype": "4.5.0",
    "@sourcegraph/scip-python": "0.6.6",
    "@tanstack/react-router": "1.170.31",
    "@vitejs/plugin-react": "6.1.1",
    "github-slugger": "2.0.0",
    "hast-util-from-html": "2.0.3",
    "js-yaml": "4.3.2",
    "katex": "0.19.1",
    "minisearch": "7.2.0",
    "oxc-transform-react": "0.152.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "rehype-slug": "6.0.0",
    "remark-directive": "4.0.0",
    "remark-frontmatter": "5.0.0",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "tsx": "catalog:",
    "typescript-7": "npm:typescript@7.1.0-dev.20261012.1",
    "unist-util-visit": "5.1.0",
    "vite": "catalog:",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@local/tsconfig": "workspace:*",
    "@tsconfig/bases": "catalog:",
    "@types/js-yaml": "^4",
    "@types/node": "catalog:",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "oxlint": "1.86.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": "22.x"
  }
}
