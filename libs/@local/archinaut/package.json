{
  "name": "@local/archinaut",
  "version": "0.0.0-private",
  "private": true,
  "description": "Architecture model and docs generator: annotations in the source plus SCIP symbol facts, checked on every build",
  "license": "(MIT OR Apache-2.0)",
  "bin": "./bin/archinaut.js",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "fix:eslint": "oxlint --fix --report-unused-disable-directives-severity=error .",
    "lint:eslint": "oxlint --report-unused-disable-directives-severity=error .",
    "lint:tsc": "tsc --noEmit",
    "test:unit": "vitest --run src"
  },
  "dependencies": {
    "@sourcegraph/scip-python": "0.6.6",
    "@sourcegraph/scip-typescript": "0.4.0",
    "js-yaml": "4.3.2",
    "tsx": "catalog:",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@local/tsconfig": "workspace:*",
    "@tsconfig/bases": "catalog:",
    "@types/js-yaml": "^4",
    "@types/node": "catalog:",
    "oxlint": "1.86.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
