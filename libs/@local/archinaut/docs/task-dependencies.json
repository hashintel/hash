{
  "package": "@local/archinaut",
  "dependencies": [
    "@hashintel/ds-icons",
    "@local/tsconfig"
  ],
  "tasks": {
    "fix:eslint": {
      "dependsOn": [
        "@hashintel/ds-icons#build",
        "@local/eslint#build"
      ]
    },
    "lint:eslint": {
      "dependsOn": [
        "@hashintel/ds-icons#build",
        "@local/eslint#build"
      ],
      "env": [
        "CHECK_TEMPORARILY_DISABLED_RULES"
      ]
    },
    "lint:tsc": {
      "dependsOn": [
        "@hashintel/ds-icons#build"
      ]
    },
    "test:unit": {
      "dependsOn": [],
      "env": [
        "TEST_COVERAGE"
      ]
    }
  }
}
