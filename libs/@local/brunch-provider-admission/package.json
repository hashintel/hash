{
  "name": "@local/brunch-provider-admission",
  "version": "0.0.0-private",
  "private": true,
  "description": "Brunch's model-stream admission: buffers tool proposals until they are admitted, and bounds idle model streams.",
  "license": "AGPL-3.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/provider-admission.ts",
      "@dev/source": "./src/provider-admission.ts",
      "import": "./dist/provider-admission.js"
    }
  },
  "scripts": {
    "build": "vite build",
    "fix:eslint": "oxlint --fix --type-aware --type-check --report-unused-disable-directives-severity=error .",
    "lint:eslint": "oxlint --type-aware --type-check --report-unused-disable-directives-severity=error .",
    "lint:tsc": "tsgo --noEmit",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.83.0",
    "@flue/runtime": "2.0.3"
  },
  "devDependencies": {
    "@types/node": "22.18.13",
    "@typescript/native-preview": "7.0.0-dev.20260511.1",
    "oxlint": "1.86.0",
    "oxlint-tsgolint": "7.0.2003",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
