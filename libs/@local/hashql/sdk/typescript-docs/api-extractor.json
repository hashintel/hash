{
  "$schema": "https://developer.microsoft.com/json-schemas/api-extractor/v7/api-extractor.schema.json",
  "projectFolder": ".",
  "mainEntryPointFilePath": "<projectFolder>/api-entry.d.ts",
  "compiler": {
    "overrideTsconfig": {
      "compilerOptions": {
        "strict": true,
        "target": "ES2024",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "skipLibCheck": true
      },
      "include": ["api-entry.d.ts"]
    },
    "skipLibCheck": true
  },
  "apiReport": {
    "enabled": false
  },
  "docModel": {
    "enabled": true,
    "apiJsonFilePath": "<projectFolder>/.generated/api-model/hashql.api.json"
  },
  "dtsRollup": {
    "enabled": false
  },
  "tsdocMetadata": {
    "enabled": false
  }
}
