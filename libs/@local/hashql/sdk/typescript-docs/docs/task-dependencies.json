{
  "package": "@local/hashql-typescript-docs",
  "dependencies": [
    "@local/hashql",
    "@local/oxlint",
    "@local/tsconfig"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "@local/hashql#build",
        "@local/oxlint#build",
        "codegen"
      ],
      "env": [
        "NEXT_TELEMETRY_DISABLED"
      ]
    },
    "codegen": {
      "dependsOn": [
        "doc:transform"
      ]
    },
    "dev": {
      "dependsOn": [
        "@local/hashql#build",
        "@local/oxlint#build",
        "codegen"
      ],
      "cache": false,
      "persistent": true,
      "env": [
        "NEXT_TELEMETRY_DISABLED",
        "PORT"
      ]
    },
    "doc:analyze": {
      "dependsOn": [
        "doc:declarations"
      ]
    },
    "doc:declarations": {
      "dependsOn": []
    },
    "doc:transform": {
      "dependsOn": [
        "doc:analyze"
      ]
    },
    "lint:oxlint": {
      "dependsOn": [
        "@local/hashql#build",
        "@local/oxlint#build",
        "codegen"
      ]
    },
    "lint:tsc": {
      "dependsOn": [
        "@local/hashql#build",
        "@local/oxlint#build",
        "codegen"
      ]
    },
    "start": {
      "dependsOn": [
        "build"
      ],
      "cache": false,
      "persistent": true,
      "env": [
        "NEXT_TELEMETRY_DISABLED",
        "PORT"
      ]
    },
    "test:unit": {
      "dependsOn": [],
      "env": [
        "TEST_COVERAGE"
      ]
    }
  }
}
