{
  "name": "@local/hashql-typescript-docs",
  "version": "0.0.0-private",
  "private": true,
  "description": "TypeScript SDK reference for HashQL",
  "license": "AGPL-3",
  "type": "module",
  "scripts": {
    "build": "next build --webpack",
    "codegen": "fumadocs-mdx",
    "dev": "next dev --webpack --hostname 127.0.0.1 --port ${PORT:-4398}",
    "doc:analyze": "tsx src/cli.ts analyze --lib ../typescript --include .generated/declarations/main.d.ts",
    "doc:declarations": "tsc --project tsconfig.api.json",
    "doc:transform": "tsx src/cli.ts transform --lib ../typescript && oxfmt content/docs/reference",
    "fix:oxlint": "oxlint --disable-nested-config -c oxlint.config.ts --fix",
    "lint:oxlint": "oxlint --disable-nested-config -c oxlint.config.ts",
    "lint:tsc": "tsc --noEmit",
    "start": "next start --hostname 127.0.0.1 --port ${PORT:-4398}",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@fumadocs/satteri": "0.5.1",
    "@local/hashql": "workspace:*",
    "fumadocs-core": "16.16.2",
    "fumadocs-mdx": "15.4.6",
    "fumadocs-twoslash": "4.0.1",
    "fumadocs-ui": "16.16.2",
    "next": "16.3.8",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "satteri": "0.10.5"
  },
  "devDependencies": {
    "@effect/platform-node": "4.0.0",
    "@effect/vitest": "4.0.0",
    "@local/oxlint": "workspace:*",
    "@local/tsconfig": "workspace:*",
    "@microsoft/api-documenter": "7.30.18",
    "@microsoft/api-extractor": "7.59.4",
    "@microsoft/api-extractor-model": "7.33.15",
    "@microsoft/tsdoc": "0.17.1",
    "@microsoft/tsdoc-config": "0.18.3",
    "@tailwindcss/postcss": "4.3.3",
    "@tsconfig/bases": "catalog:",
    "@types/hast": "3.0.5",
    "@types/mdast": "4.0.4",
    "@types/mdx": "2.0.14",
    "@types/node": "catalog:",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "effect": "4.0.0",
    "esrap": "2.4.0",
    "oxc-parser": "0.152.0",
    "oxc-resolver": "11.24.2",
    "oxfmt": "0.71.0",
    "oxlint": "catalog:",
    "remark-frontmatter": "5.0.0",
    "remark-mdx": "3.1.1",
    "remark-parse": "11.0.0",
    "remark-stringify": "11.0.0",
    "shiki": "4.5.0",
    "tailwindcss": "4.3.3",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "unified": "11.0.5",
    "vite": "catalog:",
    "vitest": "catalog:",
    "yaml": "2.9.1"
  }
}
