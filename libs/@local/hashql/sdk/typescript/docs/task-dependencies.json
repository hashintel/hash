{
  "package": "@local/hashql",
  "dependencies": [
    "@local/oxlint",
    "@local/tsconfig"
  ],
  "tasks": {
    "bench:unit": {
      "dependsOn": [],
      "cache": false
    },
    "build": {
      "dependsOn": [
        "@local/oxlint#build"
      ]
    },
    "lint:oxlint": {
      "dependsOn": [
        "@local/oxlint#build"
      ]
    },
    "lint:tsc": {
      "dependsOn": [
        "build"
      ]
    },
    "test:integration": {
      "dependsOn": [
        "@local/oxlint#build",
        "build",
        "hashql-syntax-jexpr#build:parse:debug"
      ],
      "env": [
        "TEST_COVERAGE"
      ],
      "affectedBy": [
        "darwin-kperf",
        "darwin-kperf-codegen",
        "darwin-kperf-criterion",
        "darwin-kperf-events",
        "darwin-kperf-sys",
        "error-stack",
        "error-stack-macros",
        "harpc-types",
        "harpc-wire-protocol",
        "hash-codec",
        "hash-codegen",
        "hashql-ast",
        "hashql-core",
        "hashql-diagnostics",
        "hashql-macros",
        "hashql-syntax-jexpr"
      ]
    },
    "test:unit": {
      "dependsOn": [
        "@local/oxlint#build",
        "build"
      ],
      "env": [
        "TEST_COVERAGE"
      ]
    }
  }
}
