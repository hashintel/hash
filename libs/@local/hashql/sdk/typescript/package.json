{
  "name": "@local/hashql",
  "version": "0.0.0-private",
  "private": true,
  "description": "TypeScript SDK for HashQL",
  "license": "AGPL-3",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/main.d.ts",
      "default": "./dist/main.js"
    }
  },
  "scripts": {
    "bench:unit": "tsdown benches/parser.bench.ts --no-config --out-dir dist/bench --no-dts --no-clean --deps.never-bundle vitest && vitest bench --run --experimental.viteModuleRunner=false --experimental.nodeLoader=false dist/bench",
    "build": "tsdown",
    "fix:oxlint": "oxlint --disable-nested-config -c oxlint.config.ts --fix",
    "lint:oxlint": "oxlint --disable-nested-config -c oxlint.config.ts",
    "lint:tsc": "tsc --noEmit",
    "test:unit": "vitest run --project unit --typecheck"
  },
  "dependencies": {
    "effect": "4.0.3"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.3",
    "@local/oxlint": "workspace:*",
    "@local/tsconfig": "workspace:*",
    "@tsconfig/bases": "catalog:",
    "oxlint": "catalog:",
    "tsdown": "0.23.0",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
