════ Initial HIR ═══════════════════════════════════════════════════════════════

let foo:0 = if $exists(x) 
            then ?x
            else 0 as Integer,
    bar:0 = $x
in
foo:0

════ HIR after type checking ═══════════════════════════════════════════════════

let foo:0 = if $exists(x) 
            then ?x
            else 0 as Integer,
    bar:0 = $x
in
foo:0

