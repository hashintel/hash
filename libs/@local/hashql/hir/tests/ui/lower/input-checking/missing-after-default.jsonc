{
  "#struct": {
    "query": [
      "let",
      "a",
      ["input", "x", "Integer", { "#literal": 0 }],
      [
        "let",
        "b",
        ["input", "x", "Integer"],
        //~^ ERROR missing value for input `x`
        [
          "let",
          "c",
          ["input", "x", "Integer"],
          ["let", "d", ["input", "x", "Integer", { "#literal": 1 }], "a"]
        ]
      ]
    ],
    "inputs": { "#struct": {} }
  }
}
