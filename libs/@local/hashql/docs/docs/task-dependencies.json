{
  "package": "@local/hashql-docs",
  "dependencies": [
    "@local/oxlint",
    "@local/tsconfig"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "codegen"
      ],
      "affectedBy": [
        "@local/hashql"
      ]
    },
    "build:reference": {
      "dependsOn": [
        "railroad-plugin#build:wasm"
      ],
      "affectedBy": [
        "railroad-plugin"
      ]
    },
    "codegen": {
      "dependsOn": [
        "@local/hashql#build"
      ],
      "affectedBy": [
        "@local/hashql"
      ]
    },
    "codegen:dev": {
      "dependsOn": []
    },
    "dev": {
      "dependsOn": [
        "codegen",
        "codegen:dev"
      ],
      "cache": false,
      "persistent": true,
      "env": [
        "PORT"
      ],
      "affectedBy": [
        "@local/hashql"
      ]
    },
    "dev:reference": {
      "dependsOn": [
        "railroad-plugin#build:wasm"
      ],
      "cache": false,
      "persistent": true,
      "affectedBy": [
        "railroad-plugin"
      ]
    },
    "lint:oxlint": {
      "dependsOn": [
        "@local/oxlint#build",
        "codegen"
      ],
      "affectedBy": [
        "@local/hashql"
      ]
    },
    "lint:tsc": {
      "dependsOn": [
        "build"
      ],
      "affectedBy": [
        "@local/hashql"
      ]
    },
    "test:integration": {
      "dependsOn": [],
      "env": [
        "TEST_COVERAGE"
      ]
    },
    "test:unit": {
      "dependsOn": [],
      "env": [
        "TEST_COVERAGE"
      ]
    }
  }
}
