{
  "$schema": "https://developer.microsoft.com/json-schemas/tsdoc/v0/tsdoc.schema.json",
  "tagDefinitions": [
    {
      "tagName": "@category",
      "syntaxKind": "block"
    },
    {
      "tagName": "@stability",
      "syntaxKind": "block"
    },
    {
      "tagName": "@since",
      "syntaxKind": "block"
    },
    {
      "tagName": "@module",
      "syntaxKind": "modifier"
    },
    {
      "tagName": "@trait",
      "syntaxKind": "modifier"
    },
    {
      "tagName": "@custom",
      "syntaxKind": "block"
    }
  ],
  "supportForTags": {
    "@category": true,
    "@stability": true,
    "@since": true,
    "@module": true,
    "@trait": true,
    "@custom": true,
    "@link": true,
    "@param": true,
    "@returns": true,
    "@throws": true,
    "@example": true,
    "@see": true,
    "@deprecated": true,
    "@internal": true,
    "@remarks": true,
    "@privateRemarks": true,
    "@typeParam": true
  },
  "supportedHtmlElements": ["caption", "code"],
  "reportUnsupportedHtmlElements": true
}
