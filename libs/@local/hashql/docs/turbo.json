{
  "extends": ["//"],
  "tasks": {
    "codegen": {
      "outputs": [
        "preview/.source/**",
        "preview/.next/types/**",
        "preview/next-env.d.ts"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "env": ["PORT"]
    },
    "manifest": {
      "dependsOn": ["^manifest", "railroad-plugin#manifest"]
    },
    "build:reference": {
      "dependsOn": ["railroad-plugin#build:wasm", "^manifest"],
      "outputs": ["reference/dist/**"],
      "inputs": ["reference/**"]
    },
    "dev:reference": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["railroad-plugin#build:wasm"],
      "inputs": ["reference/**"]
    }
  }
}
