{
  "name": "@local/hashql-docs",
  "version": "0.0.0-private",
  "private": true,
  "description": "HashQL documentation",
  "type": "module",
  "scripts": {
    "build:reference": "cd reference && typst compile --root ../../../../.. --features html,bundle --format bundle main.typ dist",
    "codegen": "node scripts/copy-dts.ts",
    "codegen:dev": "cd preview && next typegen",
    "dev": "cd preview && next dev --hostname 127.0.0.1 --port ${PORT:-4323}",
    "dev:reference": "cd reference && typst watch --root ../../../../.. --features html,bundle --format bundle --no-serve main.typ dist",
    "lint:oxlint": "oxlint --disable-nested-config -c oxlint.config.ts",
    "lint:tsc": "tsc --noEmit",
    "test:integration": "vitest run --project integration",
    "test:unit": "vitest run --project unit"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.3",
    "@jridgewell/trace-mapping": "0.3.31",
    "@microsoft/tsdoc": "0.16.0",
    "@microsoft/tsdoc-config": "0.18.1",
    "effect": "4.0.3",
    "mdast-util-to-markdown": "2.1.2",
    "oxfmt": "0.71.0"
  },
  "devDependencies": {
    "@base-ui/react": "1.9.0",
    "@effect/vitest": "4.0.3",
    "@fumadocs/base-ui": "16.17.8",
    "@local/oxlint": "workspace:*",
    "@local/tsconfig": "workspace:*",
    "@shikijs/themes": "4.5.0",
    "@tsconfig/bases": "catalog:",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/mdx": "2.0.13",
    "@types/node": "catalog:",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "beautiful-mermaid": "1.1.3",
    "fumadocs-core": "16.17.8",
    "fumadocs-mdx": "15.4.10",
    "next": "16.4.1",
    "oxlint": "catalog:",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "typescript": "catalog:beta",
    "vitest": "catalog:"
  }
}
