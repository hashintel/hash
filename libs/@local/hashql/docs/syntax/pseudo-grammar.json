{
  "Expression": "LetExpression | IfExpression | ClosureExpression | ThunkExpression | GraphReadExpression | OperationExpression",
  "Operand": "PrimaryExpression Postfix*",
  "PrimaryExpression": "LiteralExpression | ReferenceExpression | InputExpression | GroupedExpression | TupleExpression | StructExpression | ListExpression | DictionaryExpression",
  "GroupedExpression": "`(` Expression `)`",
  "LiteralExpression": "`null` | `true` | `false` | NUMBER_LITERAL | STRING_LITERAL",
  "ReferenceExpression": "Path TypeArguments?",
  "Path": "IDENTIFIER | `::` IDENTIFIER (`::` IDENTIFIER)*",
  "Postfix": "CallSuffix | FieldSuffix | IndexSuffix",
  "CallSuffix": "`(` ExpressionList? `)`",
  "FieldSuffix": "`.` IDENTIFIER",
  "IndexSuffix": "`[` Expression `]`",
  "ExpressionList": "Expression (`,` Expression)*",
  "TupleExpression": "`(` `)` | `(` Expression `,` ExpressionList? `)`",
  "StructExpression": "`(` (`:` | FieldInitializer (`,` FieldInitializer)*) `)`",
  "FieldInitializer": "IDENTIFIER `:` Expression",
  "ListExpression": "`[` ExpressionList? `]`",
  "DictionaryExpression": "`{` (DictionaryEntry (`,` DictionaryEntry)*)? `}`",
  "DictionaryEntry": "Expression `:` Expression",
  "LetExpression": "`let` Binding (`,` Binding)* `in` Expression",
  "Binding": "IDENTIFIER `=` Expression",
  "IfExpression": "`if` Expression `then` Expression `else` Expression",
  "ClosureExpression": "TypeParameters? `(` ParameterList? `)` `:` Type `->` Expression",
  "ParameterList": "Parameter (`,` Parameter)*",
  "Parameter": "IDENTIFIER `:` Type",
  "ThunkExpression": "`thunk` `->` Expression",
  "OperationExpression": "Operand | UnaryOperator Operand | Operand BinaryOperator Operand | Operand AssertionOperator Type",
  "UnaryOperator": "`!` | `-` | `~`",
  "BinaryOperator": "`&&` | `||` | `==` | `!=` | `<` | `<=` | `>` | `>=`",
  "AssertionOperator": "`as` | `as!`",
  "InputExpression": "`$` IDENTIFIER | `?` IDENTIFIER | `$exists` `(` IDENTIFIER `)`",
  "Type": "TypePrimary | UnionType | IntersectionType | ClosureType | GenericType",
  "TypePrimary": "TypeReference | TupleType | StructType | `(` Type `)` | `!` | `?`",
  "TypeReference": "Path TypeArguments?",
  "TypeList": "Type (`,` Type)*",
  "TupleType": "`(` `)` | `(` Type `,` TypeList? `)`",
  "StructType": "`(` (`:` | TypeField (`,` TypeField)*) `)`",
  "TypeField": "IDENTIFIER `:` Type",
  "UnionType": "TypePrimary `|` TypePrimary (`|` TypePrimary)*",
  "IntersectionType": "TypePrimary `&` TypePrimary (`&` TypePrimary)*",
  "ClosureType": "`(` TypeList? `)` `->` Type",
  "GenericType": "TypeParameters Type",
  "TypeParameters": "`<` TypeParameter (`,` TypeParameter)* `>`",
  "TypeParameter": "IDENTIFIER (`:` Type)?",
  "TypeArguments": "`<` TypeList `>`",
  "GraphReadExpression": "GraphHead GraphFilter* GraphTail",
  "GraphHead": "`::graph::head::entities` `(` Expression `)`",
  "GraphFilter": "`|>` `::graph::body::filter` `(` Expression `)`",
  "GraphTail": "`|>` `::graph::tail::collect`"
}
