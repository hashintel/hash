{
  "$schema": "https://turborepo.org/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "outputs": ["./dist/**"]
    },
    "test:unit": {
      "dependsOn": ["harpc-wire-protocol#build:cli"],
      "inputs": [
        "$TURBO_DEFAULT$",
        {
          "mode": "dependencyOutputs",
          "globs": ["./dist/release/codec"],
          "from": ["harpc-wire-protocol#build:cli"]
        }
      ]
    }
  }
}
