{
  "package": "@local/harpc-client",
  "dependencies": [
    "@local/eslint",
    "@local/tsconfig"
  ],
  "tasks": {
    "build": {
      "dependsOn": []
    },
    "fix:eslint": {
      "dependsOn": [
        "@local/eslint#build"
      ]
    },
    "lint:eslint": {
      "dependsOn": [
        "@local/eslint#build"
      ],
      "env": [
        "CHECK_TEMPORARILY_DISABLED_RULES"
      ]
    },
    "lint:tsc": {
      "dependsOn": [
        "@local/eslint#build"
      ]
    },
    "test:unit": {
      "dependsOn": [
        "@rust/harpc-wire-protocol#build:cli"
      ],
      "env": [
        "TEST_COVERAGE"
      ]
    }
  }
}
