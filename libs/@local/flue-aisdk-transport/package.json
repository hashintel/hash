{
  "name": "@local/flue-aisdk-transport",
  "version": "0.0.0-private",
  "private": true,
  "description": "AI SDK chat transport and UI projections over a Flue conversation, with a live tool-input side channel.",
  "license": "AGPL-3.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/client.ts",
      "@dev/source": "./src/client.ts",
      "import": "./dist/client.js"
    },
    "./server": {
      "types": "./src/server.ts",
      "@dev/source": "./src/server.ts",
      "import": "./dist/server.js"
    }
  },
  "scripts": {
    "build": "vite build",
    "fix:eslint": "oxlint --fix --type-aware --type-check --report-unused-disable-directives-severity=error .",
    "lint:eslint": "oxlint --type-aware --type-check --report-unused-disable-directives-severity=error .",
    "lint:tsc": "tsgo --noEmit",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@flue/runtime": "2.0.3",
    "@flue/sdk": "2.0.3",
    "ai": "6.0.286"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.83.0",
    "@types/node": "22.18.13",
    "@typescript/native-preview": "7.0.0-dev.20260511.1",
    "oxlint": "1.63.0",
    "oxlint-tsgolint": "0.22.1",
    "valibot": "1.4.2",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
