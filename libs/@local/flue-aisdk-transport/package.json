{
  "name": "@local/flue-aisdk-transport",
  "version": "0.0.0-private",
  "private": true,
  "description": "AI SDK chat transport and UI projections over a Flue conversation, with a live tool-input side channel.",
  "license": "AGPL-3.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/client.ts",
      "@dev/source": "./src/client.ts",
      "import": "./dist/client.js"
    },
    "./server": {
      "types": "./src/server.ts",
      "@dev/source": "./src/server.ts",
      "import": "./dist/server.js"
    }
  },
  "scripts": {
    "build": "vite build",
    "fix:eslint": "oxlint --fix --type-aware --type-check --report-unused-disable-directives-severity=error .",
    "lint:eslint": "oxlint --type-aware --type-check --report-unused-disable-directives-severity=error .",
    "lint:tsc": "tsc --noEmit",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@flue/runtime": "2.3.0",
    "@flue/sdk": "2.3.0",
    "ai": "6.0.286"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.2.0",
    "@local/tsconfig": "workspace:*",
    "@tsconfig/bases": "catalog:",
    "@types/node": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript": "catalog:",
    "valibot": "1.4.2",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
