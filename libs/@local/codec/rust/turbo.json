{
  "extends": ["//"],
  "tasks": {
    "build:types": {
      "command": [
        "env",
        "INSTA_UPDATE=always",
        "mise",
        "exec",
        "--env",
        "dev",
        "cargo:cargo-insta",
        "--",
        "cargo-insta",
        "test",
        "--features",
        "codegen,numeric",
        "--test",
        "codegen"
      ],
      "dependsOn": ["^manifest"],
      "outputs": ["types/**"]
    },
    "doc:dependency-diagram": {
      "command": [
        "cargo",
        "run",
        "-p",
        "hash-repo-chores",
        "--",
        "dependency-diagram",
        "--output",
        "docs/dependency-diagram.mmd",
        "--root",
        "hash-codec",
        "--root-deps-and-dependents",
        "--link-mode",
        "non-roots",
        "--include-dev-deps",
        "--include-build-deps",
        "--logging-console-level",
        "info"
      ]
    },
    "fix:clippy": {
      "command": ["just", "clippy", "--fix"]
    },
    "lint:clippy": {
      "command": ["just", "clippy"]
    },
    "test:unit": {
      "command": ["mise", "run", "test:unit", "@rust/hash-codec"]
    }
  }
}
