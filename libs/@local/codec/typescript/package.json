{
  "name": "@local/hash-codec",
  "version": "0.0.0-private",
  "private": true,
  "description": "TypeScript types generated by the hash-codec crate",
  "license": "AGPL-3",
  "type": "module",
  "typesVersions": {
    "*": {
      "types": [
        "./src/generated/types.d.ts"
      ]
    }
  },
  "exports": {
    "./types": "./src/generated/types.js"
  },
  "scripts": {
    "codegen": "node scripts/copy-generated.ts",
    "lint:tsc": "tsc --noEmit"
  },
  "dependencies": {
    "@rust/hash-codec": "workspace:*"
  },
  "devDependencies": {
    "@local/tsconfig": "workspace:*",
    "typescript": "5.9.3"
  }
}
