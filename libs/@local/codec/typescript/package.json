{
  "name": "@local/hash-codec",
  "version": "0.0.0-private",
  "private": true,
  "description": "TypeScript types generated by the hash-codec crate",
  "license": "AGPL-3",
  "type": "module",
  "typesVersions": {
    "*": {
      "*": [
        "./dist/*.d.ts"
      ]
    }
  },
  "exports": {
    "./*": "./dist/*.js"
  },
  "scripts": {
    "build": "rimraf dist && tsc --build tsconfig.build.json",
    "codegen": "mkdir -p src/generated && cp ../rust/types/index.snap.d.ts src/generated/types.ts",
    "lint:tsc": "tsc --noEmit"
  },
  "devDependencies": {
    "@local/tsconfig": "workspace:*",
    "rimraf": "6.1.3",
    "typescript": "5.9.3"
  }
}
