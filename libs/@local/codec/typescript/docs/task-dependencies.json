        "@rust/hash-codec",
        "@rust/hash-codegen"
      ]
    },
    "lint:tsc": {
      "dependsOn": [
        "codegen"
      ],
      "affectedBy": [
        "@rust/error-stack",
        "@rust/error-stack-macros",
        "@rust/harpc-types",
        "@rust/harpc-wire-protocol",
        "@rust/hash-codec",
        "@rust/hash-codegen"
