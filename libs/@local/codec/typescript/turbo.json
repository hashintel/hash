{
  "extends": ["//"],
  "tasks": {
    "codegen": {
      "dependsOn": ["^build", "@rust/hash-codec#build:types"],
      "inputs": [
        "$TURBO_DEFAULT$",
        {
          "mode": "dependencyOutputs",
          "globs": ["types/index.snap.d.ts"],
          "from": ["@rust/hash-codec#build:types"]
        }
      ],
      "outputs": ["src/generated/**"]
    },
    "build": {
      "outputs": ["dist/**"]
    }
  }
}
