{
  "extends": ["//"],
  "tasks": {
    "manifest": {
      "dependsOn": ["^manifest", "hash-codec#manifest"]
    },
    "codegen": {
      "dependsOn": ["hash-codec#build:types"],
      "inputs": [
        "$TURBO_DEFAULT$",
        {
          "mode": "dependencyOutputs",
          "globs": ["types/index.snap.d.ts"],
          "from": ["hash-codec#build:types"]
        }
      ],
      "outputs": ["src/generated/**"]
    },
    "build": {
      "dependsOn": ["codegen", "^manifest"],
      "outputs": ["dist/**"]
    }
  }
}
