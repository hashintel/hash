{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "extends": ["../../../.config/oxlint/brunch/base.json"],
  "categories": {
    "correctness": "error",
    "perf": "warn"
  },
  "env": {
    "builtin": true,
    "es2026": true,
    "node": true
  },
  "options": {
    "typeAware": true,
    "typeCheck": true
  },
  "rules": {
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": ["@apps/*", "@hashintel/*", "@local/*"],
            "message": "Faux providers stay independent of the products that use them."
          }
        ]
      }
    ]
  }
}
