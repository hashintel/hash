{
  "name": "@local/petrinaut-optimizer-client",
  "version": "0.0.0-private",
  "private": true,
  "description": "Isomorphic client utilities and generated types for Petrinaut Optimizer",
  "license": "AGPL-3.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "rimraf dist && tsc --build tsconfig.build.json",
    "codegen": "orval",
    "lint:tsc": "tsc --noEmit",
    "test:unit": "vitest --run src"
  },
  "dependencies": {
    "@hashintel/petrinaut-core": "workspace:*",
    "eventsource-parser": "3.0.8"
  },
  "devDependencies": {
    "@apps/petrinaut-opt": "workspace:*",
    "@local/tsconfig": "workspace:*",
    "@tsconfig/bases": "catalog:",
    "orval": "8.38.0",
    "oxfmt": "0.50.0",
    "rimraf": "6.1.3",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
