{
  "package": "@local/petrinaut-optimizer-client",
  "dependencies": [
    "@apps/petrinaut-opt",
    "@hashintel/petrinaut-core",
    "@local/tsconfig"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "@hashintel/petrinaut-core#build",
        "codegen"
      ]
    },
    "codegen": {
      "dependsOn": []
    },
    "lint:tsc": {
      "dependsOn": [
        "@hashintel/petrinaut-core#build",
        "codegen"
      ]
    },
    "test:unit": {
      "dependsOn": [
        "@hashintel/petrinaut-core#build",
        "codegen"
      ],
      "env": [
        "TEST_COVERAGE"
      ]
    }
  }
}
