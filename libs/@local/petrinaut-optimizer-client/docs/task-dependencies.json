{
  "package": "@local/petrinaut-optimizer-client",
  "dependencies": [
    "@hashintel/petrinaut-core",
    "@local/tsconfig"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "@hashintel/petrinaut-core#build",
        "codegen"
      ],
      "affectedBy": [
        "@hashintel/petrinaut-cli",
        "petrinaut-optimization",
        "petrinaut-optimizer-core",
        "petrinaut-python"
      ]
    },
    "codegen": {
      "dependsOn": [],
      "affectedBy": [
        "@hashintel/petrinaut-cli",
        "petrinaut-optimization",
        "petrinaut-optimizer-core",
        "petrinaut-python"
      ]
    },
    "lint:tsc": {
      "dependsOn": [
        "@hashintel/petrinaut-core#build",
        "codegen"
      ],
      "affectedBy": [
        "@hashintel/petrinaut-cli",
        "petrinaut-optimization",
        "petrinaut-optimizer-core",
        "petrinaut-python"
      ]
    },
    "test:unit": {
      "dependsOn": [
        "@hashintel/petrinaut-core#build",
        "codegen"
      ],
      "env": [
        "TEST_COVERAGE"
      ],
      "affectedBy": [
        "@hashintel/petrinaut-cli",
        "petrinaut-optimization",
        "petrinaut-optimizer-core",
        "petrinaut-python"
      ]
    }
  }
}
