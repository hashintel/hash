{
  "name": "@local/internal-api-client",
  "version": "0.0.0-private",
  "private": true,
  "description": "OpenAPI client for the HASH internal API",
  "license": "See LICENSE.md",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "rimraf dist && tsc --build tsconfig.build.json",
    "generate": "openapi-generator-cli generate && node ../../graph/client/typescript/scripts/patch-request-function.mjs common.ts && oxfmt --write --ignore-path /dev/null",
    "validate": "openapi-generator-cli validate"
  },
  "dependencies": {
    "axios": "1.20.0"
  },
  "devDependencies": {
    "@local/tsconfig": "workspace:*",
    "@openapitools/openapi-generator-cli": "2.40.1",
    "@tsconfig/bases": "catalog:",
    "@types/node": "catalog:",
    "rimraf": "6.1.3",
    "typescript": "catalog:"
  }
}
