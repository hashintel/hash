{
  "package": "@local/brunch-testing",
  "dependencies": [
    "@hashintel/brunch-agent",
    "@local/flue-aisdk-transport",
    "@local/pi-faux-providers"
  ],
  "tasks": {
    "fix:eslint": {
      "dependsOn": [
        "@hashintel/brunch-agent#build",
        "@local/eslint#build",
        "@local/flue-aisdk-transport#build"
      ]
    },
    "lint:eslint": {
      "dependsOn": [
        "@hashintel/brunch-agent#build",
        "@local/eslint#build",
        "@local/flue-aisdk-transport#build"
      ],
      "env": [
        "CHECK_TEMPORARILY_DISABLED_RULES"
      ]
    },
    "lint:tsc": {
      "dependsOn": [
        "@hashintel/brunch-agent#build",
        "@local/flue-aisdk-transport#build"
      ]
    }
  }
}
