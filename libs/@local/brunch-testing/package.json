{
  "name": "@local/brunch-testing",
  "version": "0.0.0-private",
  "private": true,
  "description": "Test harness for the built Brunch server: load it in-process, run its admission-controls probe, and spawn Node scripts.",
  "license": "AGPL-3.0",
  "type": "module",
  "exports": {
    "./admission-controls": {
      "types": "./src/run-admission-controls.ts",
      "default": "./src/run-admission-controls.ts"
    },
    "./admission-voice-evidence": {
      "types": "./src/admission-voice-evidence.ts",
      "default": "./src/admission-voice-evidence.ts"
    },
    "./load-built-application": {
      "types": "./src/load-built-application.ts",
      "default": "./src/load-built-application.ts"
    },
    "./run-node-script": {
      "types": "./src/run-node-script.ts",
      "default": "./src/run-node-script.ts"
    }
  },
  "scripts": {
    "fix:eslint": "oxlint --fix --type-aware --type-check --report-unused-disable-directives-severity=error .",
    "lint:eslint": "oxlint --type-aware --type-check --report-unused-disable-directives-severity=error .",
    "lint:tsc": "tsgo --noEmit"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.83.0",
    "@flue/runtime": "2.0.3",
    "@flue/sdk": "2.0.3",
    "@flue/vite": "2.0.3",
    "@hashintel/brunch-agent": "workspace:*",
    "@local/flue-aisdk-transport": "workspace:*",
    "@local/pi-faux-providers": "workspace:*",
    "ai": "6.0.286"
  },
  "devDependencies": {
    "@types/node": "22.18.13",
    "@typescript/native-preview": "7.0.0-dev.20260511.1",
    "oxlint": "1.86.0",
    "oxlint-tsgolint": "7.0.2003",
    "vite": "8.2.2"
  }
}
