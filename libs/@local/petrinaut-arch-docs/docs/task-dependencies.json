{
  "package": "@local/petrinaut-arch-docs",
  "dependencies": [
    "@apps/petrinaut-website",
    "@hashintel/petrinaut",
    "@hashintel/petrinaut-core",
    "@local/tsconfig"
  ],
  "tasks": {
    "doc:architecture": {
      "dependsOn": [],
      "cache": false,
      "env": [
        "GITHUB_HEAD_REF",
        "GITHUB_REF_NAME",
        "GITHUB_SHA",
        "PETRINAUT_ARCH_DOCS_CACHE_DIR",
        "PETRINAUT_ARCH_DOCS_DIFF_BASE",
        "PETRINAUT_ARCH_DOCS_SOURCE_REF",
        "VERCEL_GIT_COMMIT_REF",
        "VERCEL_GIT_COMMIT_SHA",
        "VERCEL_GIT_REPO_OWNER",
        "VERCEL_GIT_REPO_SLUG"
      ],
      "affectedBy": [
        "petrinaut-optimizer-core"
      ]
    },
    "fix:eslint": {
      "dependsOn": [
        "@apps/petrinaut-website#build",
        "@hashintel/petrinaut#build",
        "@hashintel/petrinaut-core#build",
        "@local/eslint#build"
      ],
      "affectedBy": [
        "petrinaut-optimizer-core"
      ]
    },
    "lint:arch-docs": {
      "dependsOn": [],
      "cache": false,
      "affectedBy": [
        "petrinaut-optimizer-core"
      ]
    },
    "lint:eslint": {
      "dependsOn": [
        "@apps/petrinaut-website#build",
        "@hashintel/petrinaut#build",
        "@hashintel/petrinaut-core#build",
        "@local/eslint#build"
      ],
      "env": [
        "CHECK_TEMPORARILY_DISABLED_RULES"
      ],
      "affectedBy": [
        "petrinaut-optimizer-core"
      ]
    },
    "lint:tsc": {
      "dependsOn": [
        "@apps/petrinaut-website#build",
        "@hashintel/petrinaut#build",
        "@hashintel/petrinaut-core#build"
      ],
      "affectedBy": [
        "petrinaut-optimizer-core"
      ]
    },
    "test:unit": {
      "dependsOn": [],
      "env": [
        "TEST_COVERAGE"
      ],
      "affectedBy": [
        "petrinaut-optimizer-core"
      ]
    }
  }
}
