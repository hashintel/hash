{
  "name": "@local/petrinaut-arch-docs",
  "version": "0.0.0-private",
  "private": true,
  "description": "The Petrinaut architecture docs: the archinaut config, the hand-written pages, and the site's identity",
  "license": "(MIT OR Apache-2.0)",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "doc:architecture": "archinaut bundle --config archinaut.config.ts",
    "lint:arch-docs": "archinaut check --config archinaut.config.ts",
    "lint:tsc": "tsc --noEmit"
  },
  "devDependencies": {
    "@apps/petrinaut-opt": "workspace:*",
    "@apps/petrinaut-website": "workspace:*",
    "@hashintel/petrinaut": "workspace:*",
    "@hashintel/petrinaut-cli": "workspace:*",
    "@hashintel/petrinaut-core": "workspace:*",
    "@local/archinaut": "workspace:*",
    "@local/petrinaut-optimizer-core": "workspace:*",
    "@local/petrinaut-python": "workspace:*",
    "@local/tsconfig": "workspace:*",
    "@tsconfig/bases": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:"
  }
}
