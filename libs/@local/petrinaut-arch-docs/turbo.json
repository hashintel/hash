{
  "extends": ["//"],
  "tasks": {
    "manifest": {
      "dependsOn": ["^manifest", "petrinaut-optimizer-core#manifest"]
    },
    "doc:architecture": {
      // The manifest includes source dependencies from both language workspaces.
      "dependsOn": ["manifest"],
      // Not cached: with `ARCHINAUT_DIFF_BASE` the build annotates the
      // difference to a git ref whose content the hash cannot see.
      "cache": false,
      "outputs": ["bundle/**"],
      // The ref the source links point at, and the diff and cache settings.
      // Declared because strict env mode hides anything unlisted.
      "env": [
        "ARCHINAUT_SOURCE_REF",
        "ARCHINAUT_DIFF_BASE",
        "ARCHINAUT_CACHE_DIR",
        "VERCEL_GIT_COMMIT_SHA",
        "GITHUB_SHA",
        "VERCEL_GIT_COMMIT_REF",
        "GITHUB_HEAD_REF",
        "GITHUB_REF_NAME",
        "VERCEL_GIT_REPO_OWNER",
        "VERCEL_GIT_REPO_SLUG"
      ]
    },
    "lint:arch-docs": {
      "dependsOn": ["manifest"],
      "cache": false
    }
  }
}
