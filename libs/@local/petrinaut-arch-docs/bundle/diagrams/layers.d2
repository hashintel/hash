# Generated by @local/petrinaut-arch-docs. Edit the annotations in the source, not this file.

direction: right

# layers

core: {class: core; label: "Headless core"; tooltip: "SDCPN document model, compiler, simulation runtimes and LSP, with no UI framework"}
core.actual-mode: {class: core; label: "Actual mode"; tooltip: "9 source files · Renders an execution supplied by an external source rather than by simulation"}
core.clipboard: {class: core; label: "Clipboard"; tooltip: "4 source files · Serialises a selection and pastes it back, resolving name collisions"}
core.examples: {class: core; label: "Example models"; tooltip: "7 source files · Ready-made SDCPN documents shipped for onboarding and demos"}
core.file-format: {class: core; label: "File format"; tooltip: "5 source files · Reads and writes the on-disk SDCPN document format, plus export converters"}
core.handle: {class: core; label: "Document handle"; tooltip: "4 source files · Stateful handle wrapping a document, emitting change events to subscribers"}
core.hir: {class: core; label: "HIR compiler"; tooltip: "11 source files · Lowers user-authored TypeScript to a source-spanned IR, then typechecks, lints and emits it"}
core.layout: {class: core; label: "Graph layout"; tooltip: "3 source files · Computes node positions for a net, so auto-layout does not require the canvas"}
core.lsp: {class: core; label: "LSP client"; tooltip: "Language-server client and transport for editing user code in the net"}
core.lsp.worker: {class: core; label: "LSP worker"; tooltip: "3 source files · Hosts the TypeScript language server off the main thread"}
core.playback: {class: core; label: "Playback"; tooltip: "2 source files · Picks the viewed frame over time and defines the per-play-mode backpressure profiles"}
core.schemas: {class: core; label: "Schemas"; tooltip: "3 source files · Zod schemas for document entities, metrics and scenarios, and the descriptions the AI tools read"}
core.simulation: {class: core; label: "Simulation"; tooltip: "Executes SDCPN nets — stepping, frames, workers and batch statistics"}
core.simulation.authoring: {class: core; label: "User-code authoring"; tooltip: "3 source files · Compiles and sandboxes the code users write inside a net"}
core.simulation.engine: {class: core; label: "Simulation engine"; tooltip: "20 source files · Builds an SDCPN definition into a runnable instance and computes frames"}
core.simulation.frames: {class: core; label: "Frames & metrics"; tooltip: "4 source files · The frame layout and the readers hosts use to inspect one frame"}
core.simulation.monte-carlo: {class: core; label: "Monte Carlo runtime"; tooltip: "21 source files · Runs many independent simulations with bounded frame memory, reporting metric aggregates"}
core.simulation.runtime: {class: core; label: "Simulation controller"; tooltip: "3 source files · Host-side controller for a run — owns the transport, the frame store and the status streams"}
core.simulation.worker: {class: core; label: "Simulation worker"; tooltip: "4 source files · Computes simulation frames off the main thread under host backpressure"}
core.store: {class: core; label: "Readable store"; tooltip: "2 source files · Minimal subscribable store primitive the core exposes instead of a framework dependency"}
core.types: {class: core; label: "Document types"; tooltip: "2 source files · The canonical TypeScript types describing an SDCPN document"}
core.validation: {class: core; label: "Validation"; tooltip: "3 source files · Structural integrity validators for SDCPN entities, enforcing naming conventions"}
core.workers: {class: core; label: "Worker entry points"; tooltip: "3 source files · The module entry points hosts instantiate as Web Workers"}
petrinaut: {class: petrinaut; label: "Package surface"; tooltip: "2 source files · The host-facing entry point: the contexts and types an embedder wires up"}
react: {class: react; label: "React bindings"; tooltip: "Contexts, hooks and providers that mirror core state into React"}
react.execution-frame: {class: react; label: "Execution frame source"; tooltip: "2 source files · Abstracts where frames come from, so canvas and timeline work for live runs and recordings alike"}
react.experiments: {class: react; label: "Experiments provider"; tooltip: "2 source files · Tracks Monte Carlo experiment handles and their streamed metric results"}
react.hooks: {class: react; label: "Shared hooks"; tooltip: "12 source files · Cross-cutting hooks over the providers — documents, parameters, window lifecycle"}
react.lsp: {class: react; label: "LSP provider"; tooltip: "2 source files · Exposes the core language client to the editor as React context"}
react.playback: {class: react; label: "Playback provider"; tooltip: "2 source files · Drives the viewed frame with a requestAnimationFrame loop and applies the per-mode ack policy"}
react.simulation: {class: react; label: "Simulation provider"; tooltip: "3 source files · Owns the run configuration and mirrors the core simulation handle into React"}
react.state: {class: react; label: "Editor state"; tooltip: "15 source files · Contexts owning editor-session state — active net, selection, settings, undo/redo, read-only mode"}
ui: {class: ui; label: "Editor UI"; tooltip: "The visual editor: canvas, panels, dialogs and the Monaco integration"}
ui.monaco: {class: ui; label: "Monaco integration"; tooltip: "8 source files · Wires the Monaco editor to the language server for authoring user code"}
ui.views: {class: ui; label: "Views"; tooltip: "The top-level screens the editor composes — the editor shell and the net canvas"}
ui.views.canvas: {class: ui; label: "Canvas"; tooltip: "22 source files · Renders the net as an interactive graph, with node and arc interaction"}
ui.views.editor: {class: ui; label: "Editor shell"; tooltip: "120 source files · Arranges the panels, toolbars and dialogs around the canvas"}

