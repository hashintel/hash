lsp: {class: core; label: "LSP client"; tooltip: "16 source files, 1 sub-layer · Language-server client and transport for editing user code in the net"}
playback: {class: core; label: "Playback"; tooltip: "2 source files · Picks the viewed frame over time and defines the per-play-mode backpressure profiles"}
schemas: {class: core; label: "Schemas"; tooltip: "3 source files · Zod schemas for document entities, metrics and scenarios, and the descriptions the AI tools read"}
simulation: {class: core; label: "Simulation"; tooltip: "58 source files, 6 sub-layers · Executes SDCPN nets — stepping, frames, workers and batch statistics"}
store: {class: core; label: "Readable store"; tooltip: "2 source files · Minimal subscribable store primitive the core exposes instead of a framework dependency"}
types: {class: core; label: "Document types"; tooltip: "2 source files · The canonical TypeScript types describing an SDCPN document"}
validation: {class: core; label: "Validation"; tooltip: "3 source files · Structural integrity validators for SDCPN entities, enforcing naming conventions"}
