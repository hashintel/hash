# Hand-written; rendered by the arch-docs build. Palette matches src/emit/d2.ts.
direction: right

inputs: "shader inputs" {
  style.stroke-dash: 4
  metrics: "metric count" {style.fill: "#dcecff"; style.stroke: "#3676b8"}
  ceiling: "sampled places'\ncount ceiling\n(or unbounded)" {style.fill: "#dcecff"; style.stroke: "#3676b8"}
}

sizing: "histogramBinCount\nbins = min(1024, 16 KB / (4 × metrics))\nthen min(bins, ceiling + 1)" {style.fill: "#dcecff"; style.stroke: "#3676b8"}

device: "GPU device" {
  style.stroke-dash: 4
  local: "local_hist\nbins × metrics workgroup atomics\n(fits 16 KB by construction)" {style.fill: "#f2f2f2"; style.stroke: "#777777"}
  global: "histogram buffer\nframes × bins × metrics u32" {style.fill: "#f2f2f2"; style.stroke: "#777777"}
}

decode: "host decode\n(zero bins omitted)" {style.fill: "#dcecff"; style.stroke: "#3676b8"}

inputs.metrics -> sizing
inputs.ceiling -> sizing
sizing -> device.local: baked into the WGSL
device.local -> device.global: "merged once per frame;\nempty slots skipped"
device.global -> decode: chunk + final readbacks
