{
  "package": "@local/eslint",
  "dependencies": [
    "@local/tsconfig"
  ],
  "tasks": {
    "build": {
      "dependsOn": []
    },
    "fix:eslint": {
      "dependsOn": [
        "build"
      ]
    },
    "lint:eslint": {
      "dependsOn": [
        "build"
      ],
      "env": [
        "CHECK_TEMPORARILY_DISABLED_RULES"
      ]
    }
  }
}
