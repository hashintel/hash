                                    version: OntologyTypeVersion {
                                        major: OntologyTypeMajorVersion(
                                            1,
                                        ),
                                        pre_release: None,
                                    },
                                },
                                entity_id: ColumnName(
                                    "ICAO",
                                ),
                                properties: Properties(
                                    {
                                        VersionedUrl {
                                            base_url: "https://example.com/@demo/types/property-type/name/",
                                            version: OntologyTypeVersion {
                                                major: OntologyTypeMajorVersion(
                                                    1,
                                                ),
                                                pre_release: None,
                                            },
                                        }: Column(
                                            ColumnName(
                                                "FIELD_NAME",
                                            ),
                                        ),
                                    },
                                ),
                            },
                        ),
                    ),
                },
            ],
        },
        EntityPipeline {
            source: SourceName(
                "aircraft",
            ),
            depends_on: [
                SourceName(
                    "airfields",
                ),
            ],
            inputs: {},
            steps: [
                Step {
                    id: StepId(
                        "sink-aircraft",
                    ),
                    kind: Action(
                        Sink(
                            EntitySink {
                                entity_type: VersionedUrl {
                                    base_url: "https://example.com/@demo/types/entity-type/aircraft/",
                                    version: OntologyTypeVersion {
                                        major: OntologyTypeMajorVersion(
                                            1,
                                        ),
                                        pre_release: None,
                                    },
                                },
                                entity_id: ColumnName(
                                    "TAIL",
                                ),
                                properties: Properties(
                                    {
                                        VersionedUrl {
                                            base_url: "https://example.com/@demo/types/property-type/empty-mass/",
                                            version: OntologyTypeVersion {
                                                major: OntologyTypeMajorVersion(
                                                    1,
                                                ),
                                                pre_release: None,
                                            },
                                        }: Measure {
                                            amount: ColumnName(
                                                "EMPTY_MASS",
                                            ),
                                            unit: ColumnName(
                                                "MASS_UNIT",
                                            ),
                                            unit_map: UnitMapName(
