                                        VersionedUrl {
                                            base_url: "https://example.com/@demo/types/property-type/first-flight/",
                                            version: OntologyTypeVersion {
                                                major: OntologyTypeMajorVersion(
                                                    1,
                                                ),
                                                pre_release: None,
                                            },
