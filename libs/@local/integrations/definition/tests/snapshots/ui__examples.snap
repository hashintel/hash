---
source: libs/@local/integrations/definition/tests/ui.rs
expression: render(&text)
input_file: libs/@local/integrations/definition/examples/aviation.yaml
---
Definition {
    connector: ConnectorId(
        "aviation",
    ),
    sources: {
        SourceName(
            "aircraft",
        ): Source {
            kind: Sql {
                query: SqlQuery(
                    "SELECT * FROM (VALUES\n  ('SE-XXX', 'DC-3', '1946-04-02', '8030', 'KG', 'ESSA'),\n  ('N100', 'L-1049', '1957-07-15', '69000', 'LB', 'ESSA')\n) t(TAIL, MODEL, FIRST_FLIGHT, EMPTY_MASS, MASS_UNIT, HOME_BASE)\n",
                ),
                primary_key: PrimaryKey(
                    [
                        ColumnName(
                            "TAIL",
                        ),
                    ],
                ),
            },
            coverage: Complete,
        },
        SourceName(
            "airfields",
        ): Source {
            kind: Sql {
                query: SqlQuery(
                    "SELECT * FROM (VALUES\n  ('ESSA', 'Arlanda'),\n  ('ESSB', 'Bromma')\n) t(ICAO, FIELD_NAME)\n",
                ),
                primary_key: PrimaryKey(
                    [
                        ColumnName(
                            "ICAO",
                        ),
                    ],
                ),
            },
            coverage: Complete,
        },
    },
    unit_maps: {
        UnitMapName(
            "masses",
        ): UnitMap {
            units: {
                UnitCode(
                    "KG",
                ): VersionedUrl {
                    base_url: "https://example.com/@demo/types/data-type/kilogram/",
                    version: OntologyTypeVersion {
                        major: OntologyTypeMajorVersion(
                            1,
                        ),
                        pre_release: None,
                    },
                },
                UnitCode(
                    "LB",
                ): VersionedUrl {
                    base_url: "https://example.com/@demo/types/data-type/pound/",
                    version: OntologyTypeVersion {
                        major: OntologyTypeMajorVersion(
                            1,
                        ),
                        pre_release: None,
                    },
                },
            },
            fallback: Some(
                VersionedUrl {
                    base_url: "https://example.com/@demo/types/data-type/mass/",
                    version: OntologyTypeVersion {
                        major: OntologyTypeMajorVersion(
                            1,
                        ),
                        pre_release: None,
                    },
                },
            ),
        },
    },
    entity_pipelines: [
        EntityPipeline {
            source: SourceName(
                "airfields",
            ),
            depends_on: [],
            inputs: {},
            steps: [
                Step {
                    id: StepId(
