                                            column: ColumnName(
                                                "FIRST_FLIGHT",
                                            ),
                                            coercion: Date,
                                        },
                                        VersionedUrl {
                                            base_url: "https://example.com/@demo/types/property-type/model/",
                                            version: OntologyTypeVersion {
                                                major: OntologyTypeMajorVersion(
