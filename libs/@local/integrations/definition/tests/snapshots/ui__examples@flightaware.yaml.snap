                    "SELECT * FROM (VALUES\n  (\n    'BAW115-1715000000-schedule-0001', 'BA115', 'BAW115', 'Airline',\n    '{\"code_icao\": \"KJFK\", \"name\": \"John F Kennedy Intl\", \"code_iata\": \"JFK\", \"timezone\": \"America/New_York\", \"city\": \"New York\"}'::JSON,\n    '{\"code_icao\": \"EGLL\", \"name\": \"Heathrow\", \"code_iata\": \"LHR\", \"timezone\": \"Europe/London\", \"city\": \"London\"}'::JSON,\n    'BAW', 'BA', 'British Airways',\n    false, false,\n    'A10', 'T5', 'A10', NULL,\n    '2024-05-06T22:00:00Z', '2024-05-06T22:05:00Z', '2024-05-06T22:10:00Z', '2024-05-06T22:15:00Z',\n    'B22', 'T5', 'B22', '5',\n    120, -300,\n    '2024-05-07T06:00:00Z', '2024-05-07T05:55:00Z', '2024-05-07T06:05:00Z', '2024-05-07T06:00:00Z'\n  ),\n  (\n    'DLH901-1715000000-schedule-0002', 'LH901', 'DLH901', 'Airline',\n    '{\"code_icao\": \"EDDF\", \"name\": \"Frankfurt am Main\", \"code_iata\": \"FRA\", \"timezone\": \"Europe/Berlin\", \"city\": \"Frankfurt\"}'::JSON,\n    '{\"code_icao\": \"EGLL\", \"name\": \"Heathrow\", \"code_iata\": \"LHR\", \"timezone\": \"Europe/London\", \"city\": \"London\"}'::JSON,\n    'DLH', 'LH', 'Lufthansa',\n    false, false,\n    NULL, 'T1', NULL, NULL,\n    '2024-05-07T07:00:00Z', '2024-05-07T07:10:00Z', '2024-05-07T07:15:00Z', NULL,\n    'C15', 'T2', NULL, '7',\n    NULL, 600,\n    '2024-05-07T08:30:00Z', '2024-05-07T08:40:00Z', '2024-05-07T08:35:00Z', NULL\n  ),\n  (\n    'UAE5-1715000000-schedule-0003', 'EK5', 'UAE5', 'Airline',\n    '{\"code_icao\": \"OMDB\", \"name\": \"Dubai Intl\", \"code_iata\": \"DXB\", \"timezone\": \"Asia/Dubai\", \"city\": \"Dubai\"}'::JSON,\n    '{\"code_icao\": \"EGLL\", \"name\": \"Heathrow\", \"code_iata\": \"LHR\", \"timezone\": \"Europe/London\", \"city\": \"London\"}'::JSON,\n    'UAE', 'EK', 'Emirates',\n    true, false,\n    NULL, NULL, NULL, NULL,\n    '2024-05-07T09:00:00Z', NULL, NULL, NULL,\n    NULL, NULL, NULL, NULL,\n    NULL, NULL,\n    '2024-05-07T14:00:00Z', NULL, NULL, NULL\n  )\n) AS t(\n  fa_flight_id, ident_iata, ident_icao, type,\n  origin, destination,\n  operator_icao, operator_iata, operator,\n  cancelled, diverted,\n  gate_origin, terminal_origin, actual_runway_off, departure_delay,\n  scheduled_out, actual_out, scheduled_off, actual_off,\n  gate_destination, terminal_destination, actual_runway_on, baggage_claim,\n  arrival_delay, departure_delay_secs,\n  scheduled_in, actual_in, scheduled_on, actual_on\n)\n",
                ),
                primary_key: PrimaryKey(
