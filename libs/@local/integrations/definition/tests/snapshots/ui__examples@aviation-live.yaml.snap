                Step {
                    id: StepId(
                        "extract",
                    ),
                    kind: Branch(
                        Branches(
                            [
                                [
                                    BranchStep {
                                        id: StepId(
                                            "norm-airports",
                                        ),
                                        action: Sql(
                                            SqlQuery(
                                                "SELECT DISTINCT ON (icaoCode)\n  _op, _key, icaoCode, name, iataCode, timezone, city\nFROM (\n  SELECT _op, _key,\n    origin->>'code_icao' AS icaoCode,\n    origin->>'name' AS name,\n    origin->>'code_iata' AS iataCode,\n    origin->>'timezone' AS timezone,\n    origin->>'city' AS city\n  FROM input WHERE origin->>'code_icao' IS NOT NULL\n  UNION ALL\n  SELECT _op, _key,\n    destination->>'code_icao' AS icaoCode,\n    destination->>'name' AS name,\n    destination->>'code_iata' AS iataCode,\n    destination->>'timezone' AS timezone,\n    destination->>'city' AS city\n  FROM input WHERE destination->>'code_icao' IS NOT NULL\n) airports\n",
                                            ),
                                        ),
                                    },
                                    BranchStep {
                                        id: StepId(
                                            "write-airports",
                                        ),
