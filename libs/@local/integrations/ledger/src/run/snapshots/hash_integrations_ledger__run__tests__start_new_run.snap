{
  "input": {
    "run": "00000000-0000-4000-8000-00000000000a",
    "web": "00000000-0000-4000-8000-000000000001",
    "connector": "aviation",
    "actor": "00000000-0000-4000-8000-000000000002",
    "definition": "# Loads aircraft and airfields, and links each aircraft to its home base.\nconnector: aviation\n\nvars:\n  TYPES: https://example.com/@demo/types\n\nunitMaps:\n  masses:\n    units:\n      KG: ${TYPES}/data-type/kilogram/v/1\n      LB: ${TYPES}/data-type/pound/v/1\n    fallback: ${TYPES}/data-type/mass/v/1\n\nsources:\n  aircraft:\n    primaryKey: [TAIL]\n    sql: |\n      SELECT * FROM (VALUES\n        ('SE-XXX', 'DC-3', '1946-04-02', '8030', 'KG', 'ESSA'),\n        ('N100', 'L-1049', '1957-07-15', '69000', 'LB', 'ESSA')\n      ) t(TAIL, MODEL, FIRST_FLIGHT, EMPTY_MASS, MASS_UNIT, HOME_BASE)\n  airfields:\n    primaryKey: [ICAO]\n    sql: |\n      SELECT * FROM (VALUES\n        ('ESSA', 'Arlanda'),\n        ('ESSB', 'Bromma')\n      ) t(ICAO, FIELD_NAME)\n\npipelines:\n  entities:\n    - source: airfields\n      steps:\n        - id: sink-airfields\n          sink:\n            entityType: ${TYPES}/entity-type/airfield/v/1\n            entityId: ICAO\n            properties:\n              ${TYPES}/property-type/name/v/1: FIELD_NAME\n\n    - source: aircraft\n      dependsOn: [airfields]\n      steps:\n        - id: sink-aircraft\n          sink:\n            entityType: ${TYPES}/entity-type/aircraft/v/1\n            entityId: TAIL\n            properties:\n              ${TYPES}/property-type/model/v/1: MODEL\n              ${TYPES}/property-type/first-flight/v/1:\n                { column: FIRST_FLIGHT, coerce: date }\n              ${TYPES}/property-type/empty-mass/v/1:\n                { amount: EMPTY_MASS, unit: MASS_UNIT, unitMap: masses }\n        - id: cp-aircraft\n          checkpoint: aviation/aircraft\n\n  links:\n    - id: aircraft-based-at\n      checkpoint: aviation/aircraft\n      from: { entityType: \"${TYPES}/entity-type/aircraft/v/1\", column: TAIL }\n      to: { entityType: \"${TYPES}/entity-type/airfield/v/1\", column: HOME_BASE }\n      linkType: ${TYPES}/entity-type/based-at/v/1\n",
    "id_namespace": "00000000-0000-4000-8000-000000000001/aviation",
    "submitted_at": "2026-07-22T10:00:00Z"
  },
  "batch": {
    "max_writes": 128,
    "max_bytes": 1500000
  },
