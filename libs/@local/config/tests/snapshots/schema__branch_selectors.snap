{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BranchSelectors",
  "type": "object",
  "properties": {
    "legacy": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "port": {
      "type": "integer",
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0
    },
