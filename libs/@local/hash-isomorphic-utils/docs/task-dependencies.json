{
  "package": "@local/hash-isomorphic-utils",
  "dependencies": [
    "@blockprotocol/graph",
    "@blockprotocol/type-system",
    "@local/advanced-types",
    "@local/eslint",
    "@local/hash-graph-client",
    "@local/hash-graph-sdk",
    "@local/hash-graph-store",
    "@local/status",
    "@local/tsconfig"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "@blockprotocol/graph#build",
        "@blockprotocol/type-system#build",
        "@local/advanced-types#build",
        "@local/eslint#build",
        "@local/hash-graph-client#build",
        "@local/hash-graph-sdk#build",
        "@local/hash-graph-store#build",
        "@local/status#build",
        "codegen"
      ]
    },
    "codegen": {
      "dependsOn": []
    },
    "fix:eslint": {
      "dependsOn": [
        "@blockprotocol/graph#build",
        "@blockprotocol/type-system#build",
        "@local/advanced-types#build",
        "@local/eslint#build",
        "@local/hash-graph-client#build",
        "@local/hash-graph-sdk#build",
        "@local/hash-graph-store#build",
        "@local/status#build",
        "codegen"
      ]
    },
    "lint:eslint": {
      "dependsOn": [
        "@blockprotocol/graph#build",
        "@blockprotocol/type-system#build",
        "@local/advanced-types#build",
        "@local/eslint#build",
        "@local/hash-graph-client#build",
        "@local/hash-graph-sdk#build",
        "@local/hash-graph-store#build",
        "@local/status#build",
        "codegen"
      ],
      "env": [
        "CHECK_TEMPORARILY_DISABLED_RULES"
      ]
    },
    "lint:tsc": {
      "dependsOn": [
        "@blockprotocol/graph#build",
        "@blockprotocol/type-system#build",
        "@local/advanced-types#build",
        "@local/eslint#build",
        "@local/hash-graph-client#build",
        "@local/hash-graph-sdk#build",
        "@local/hash-graph-store#build",
        "@local/status#build",
        "codegen"
      ]
    },
    "test:unit": {
      "dependsOn": [
        "@blockprotocol/graph#build",
        "@blockprotocol/type-system#build",
        "@local/advanced-types#build",
        "@local/eslint#build",
        "@local/hash-graph-client#build",
        "@local/hash-graph-sdk#build",
        "@local/hash-graph-store#build",
        "@local/status#build",
        "codegen"
      ],
      "env": [
        "TEST_COVERAGE"
      ]
    }
  }
}
