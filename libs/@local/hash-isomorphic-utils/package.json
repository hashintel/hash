{
  "name": "@local/hash-isomorphic-utils",
  "version": "0.0.0-private",
  "private": true,
  "description": "Temporary catchall place for shared code",
  "license": "AGPL-3.0",
  "type": "module",
  "typesVersions": {
    "*": {
      "*": [
        "./dist/*.d.ts"
      ]
    }
  },
  "exports": {
    "./*": "./dist/*.js"
  },
  "scripts": {
    "build": "rimraf dist && tsc --build tsconfig.build.json",
    "codegen": "rimraf './src/**/*.gen.*'; graphql-codegen --config codegen.config.ts",
    "fix:eslint": "eslint --fix .",
    "generate-system-types": "tsx ./src/generate-system-types.ts; echo 'Fixing import paths'; fix-esm-import-path ./src/system-types/; echo 'Fixing eslint'; yarn fix:eslint; echo 'Fixing formatting'; oxfmt --write --ignore-path /dev/null ./src/system-types/",
    "lint:eslint": "eslint --report-unused-disable-directives .",
    "lint:tsc": "tsc --noEmit",
    "test:unit": "vitest --run"
  },
  "dependencies": {
    "@apollo/client": "3.10.5",
    "@blockprotocol/core": "0.1.5",
    "@blockprotocol/graph": "workspace:*",
    "@local/advanced-types": "workspace:*",
    "@local/hash-graph-client": "workspace:*",
    "@local/hash-graph-sdk": "workspace:*",
    "@local/hash-graph-store": "workspace:*",
    "@local/status": "workspace:*",
    "@sentry/browser": "10.75.2",
    "@sindresorhus/slugify": "3.0.0",
    "big.js": "7.0.1",
    "express": "5.2.0",
    "fix-esm-import-path": "1.10.3",
    "fractional-indexing": "3.2.0",
    "graphql-tag": "2.12.6",
    "immer": "10.1.3",
    "jsonschema": "1.5.0",
    "lodash-es": "4.18.1",
    "pluralize": "8.0.0",
    "prosemirror-commands": "1.7.2",
    "prosemirror-dropcursor": "1.8.4",
    "prosemirror-keymap": "1.2.3",
    "prosemirror-model": "1.25.12",
    "prosemirror-state": "1.4.4",
    "prosemirror-transform": "1.12.2",
    "prosemirror-view": "1.42.6",
    "serialize-error": "12.0.0",
    "tsx": "catalog:",
    "uuid": "14.0.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@blockprotocol/type-system": "workspace:*",
    "@graphql-codegen/add": "7.1.1",
    "@graphql-codegen/cli": "^7.4.6",
    "@graphql-codegen/fragment-matcher": "7.1.0",
    "@graphql-codegen/typescript": "6.1.2",
    "@graphql-codegen/typescript-operations": "6.1.10",
    "@local/eslint": "workspace:*",
    "@local/tsconfig": "workspace:*",
    "@temporalio/workflow": "1.20.2",
    "@tsconfig/bases": "catalog:",
    "@types/big.js": "6.2.2",
    "@types/express": "5.0.5",
    "@types/lodash-es": "4.17.12",
    "@types/node": "catalog:",
    "@types/pluralize": "0.0.33",
    "@vitest/coverage-istanbul": "4.1.10",
    "eslint": "9.39.4",
    "graphql": "16.11.0",
    "next": "16.4.1",
    "react": "19.2.6",
    "rimraf": "6.1.3",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
