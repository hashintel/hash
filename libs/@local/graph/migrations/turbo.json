{
  "extends": ["//"],
  "tasks": {
    "start:migrate:up": {
      "command": [
        "cargo",
        "run",
        "--package",
        "hash-graph-migrations",
        "--bin",
        "cli",
        "--features",
        "cli",
        "--",
        "run",
        "--user",
        "postgres",
        "--password",
        "postgres"
      ],
      "cache": false
    },
    "start:migrate:down": {
      "command": [
        "cargo",
        "run",
        "--package",
        "hash-graph-migrations",
        "--bin",
        "cli",
        "--features",
        "cli",
        "--",
        "run",
        "--user",
        "postgres",
        "--password",
        "postgres",
        "--target",
        "0"
      ],
      "cache": false
    },
    "doc:dependency-diagram": {
      "command": [
        "cargo",
        "run",
        "-p",
        "hash-repo-chores",
        "--",
        "dependency-diagram",
        "--output",
        "docs/dependency-diagram.mmd",
        "--root",
        "hash-graph-migrations",
        "--root-deps-and-dependents",
        "--link-mode",
        "non-roots",
        "--include-dev-deps",
        "--include-build-deps",
        "--logging-console-level",
        "info"
      ]
    },
    "fix:clippy": {
      "command": ["just", "clippy", "--fix"]
    },
    "lint:clippy": {
      "command": ["just", "clippy"]
    }
  }
}
