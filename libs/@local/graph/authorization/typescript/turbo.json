{
  "extends": ["//"],
  "tasks": {
    "manifest": {
      "dependsOn": ["^manifest", "hash-graph-authorization#manifest"]
    },
    "codegen": {
      "dependsOn": ["hash-graph-authorization#build:types"],
      "outputs": ["src/generated/**"]
    },
    "build": {
      "dependsOn": ["codegen", "@blockprotocol/type-system#build", "^manifest"],
      "outputs": ["dist/**"]
    }
  }
}
