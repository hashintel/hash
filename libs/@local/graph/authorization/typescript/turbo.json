{
  "extends": ["//"],
  "tasks": {
    "manifest": {
      "dependsOn": ["^manifest", "@rust/hash-graph-authorization#manifest"]
    },
    "codegen": {
      "dependsOn": ["@rust/hash-graph-authorization#build:types"],
      "inputs": [
        "$TURBO_DEFAULT$",
        {
          "mode": "dependencyOutputs",
          "globs": ["types/index.snap.d.ts"],
          "from": ["@rust/hash-graph-authorization#build:types"]
        }
      ],
      "outputs": ["src/generated/**"]
    },
    "build": {
      "dependsOn": ["codegen", "@blockprotocol/type-system#build", "^manifest"],
      "outputs": ["dist/**"]
    }
  }
}
