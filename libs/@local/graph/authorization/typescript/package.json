{
  "name": "@local/hash-graph-authorization",
  "version": "0.0.0-private",
  "private": true,
  "description": "TypeScript types generated by the hash-graph-authorization crate",
  "license": "AGPL-3",
  "type": "module",
  "typesVersions": {
    "*": {
      "*": [
        "./dist/*.d.ts"
      ]
    }
  },
  "exports": {
    "./*": "./dist/*.js"
  },
  "scripts": {
    "build": "rimraf dist && tsc --build tsconfig.build.json",
    "codegen": "mkdir -p src/generated && cp ../rust/types/index.snap.d.ts src/generated/types.ts",
    "lint:tsc": "tsc --noEmit"
  },
  "dependencies": {
    "@blockprotocol/type-system": "workspace:*"
  },
  "devDependencies": {
    "@local/tsconfig": "workspace:*",
    "@types/node": "22.18.13",
    "rimraf": "6.1.3",
    "typescript": "catalog:"
  }
}
