{
  "package": "@local/hash-graph-store",
  "dependencies": [
    "@blockprotocol/type-system",
    "@local/hash-graph-authorization",
    "@local/tsconfig"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "@blockprotocol/type-system#build",
        "@local/hash-graph-authorization#build",
        "codegen"
      ]
    },
    "codegen": {
      "dependsOn": [
        "@rust/hash-graph-store#build:types"
      ]
    },
    "lint:tsc": {
      "dependsOn": [
        "@blockprotocol/type-system#build",
        "@local/hash-graph-authorization#build",
        "codegen"
      ]
    }
  }
}
