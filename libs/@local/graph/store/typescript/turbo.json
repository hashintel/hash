{
  "extends": ["//"],
  "tasks": {
    "manifest": {
      "dependsOn": ["^manifest", "hash-graph-store#manifest"]
    },
    "codegen": {
      "dependsOn": ["hash-graph-store#build:types"],
      "outputs": ["src/generated/**"]
    },
    "build": {
      "dependsOn": [
        "codegen",
        "@blockprotocol/type-system#build",
        "@local/hash-graph-authorization#build",
        "^manifest"
      ],
      "outputs": ["dist/**"]
    }
  }
}
