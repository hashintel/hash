{
  "package": "@rust/hash-graph-postgres-store",
  "dependencies": [
    "@blockprotocol/type-system-rs",
    "@rust/error-stack",
    "@rust/hash-codec",
    "@rust/hash-graph-authorization",
    "@rust/hash-graph-embeddings",
    "@rust/hash-graph-migrations",
    "@rust/hash-graph-store",
    "@rust/hash-graph-temporal-versioning",
    "@rust/hash-graph-test-data",
    "@rust/hash-graph-types",
    "@rust/hash-graph-validation",
    "@rust/hash-status",
    "@rust/hash-telemetry",
    "@rust/hash-temporal-client"
  ],
  "tasks": {
    "doc:dependency-diagram": {
      "dependsOn": [
        "@rust/hash-repo-chores#build"
      ],
      "cache": false,
      "affectedBy": [
        "@rust/hash-repo-chores"
      ]
    },
    "fix:clippy": {
      "dependsOn": []
    },
    "lint:clippy": {
      "dependsOn": [],
      "env": [
        "GITHUB_EVENT_NAME"
      ],
      "affectedBy": [
        "@rust/darwin-kperf-codegen"
      ]
    },
    "test:integration": {
      "dependsOn": [
        "@rust/hash-graph-migrations#start:migrate:up"
      ],
      "env": [
        "TEST_COVERAGE"
      ],
      "affectedBy": [
        "@rust/darwin-kperf-codegen"
      ]
    },
    "test:unit": {
      "dependsOn": [],
      "env": [
        "TEST_COVERAGE"
      ],
      "affectedBy": [
        "@rust/darwin-kperf-codegen"
      ]
    }
  }
}
