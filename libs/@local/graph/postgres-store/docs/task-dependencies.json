{
  "package": "hash-graph-postgres-store",
  "dependencies": [
    "error-stack",
    "hash-codec",
    "hash-graph-authorization",
    "hash-graph-embeddings",
    "hash-graph-migrations",
    "hash-graph-store",
    "hash-graph-temporal-versioning",
    "hash-graph-test-data",
    "hash-graph-types",
    "hash-graph-validation",
    "hash-status",
    "hash-telemetry",
    "hash-temporal-client",
    "type-system"
  ],
  "tasks": {
    "doc:dependency-diagram": {
      "dependsOn": [
        "hash-repo-chores#build"
      ],
      "cache": false,
      "affectedBy": [
        "error-stack-macros",
        "hash-repo-chores"
      ]
    },
    "fix:clippy": {
      "dependsOn": []
    },
    "lint:clippy": {
      "dependsOn": [],
      "env": [
        "GITHUB_EVENT_NAME"
      ],
      "affectedBy": [
        "darwin-kperf-codegen",
        "error-stack-macros"
      ]
    },
    "test:integration": {
      "dependsOn": [
        "hash-graph-migrations#start:migrate:up"
      ],
      "env": [
        "TEST_COVERAGE"
      ],
      "affectedBy": [
        "darwin-kperf-codegen",
        "error-stack-macros"
      ]
    },
    "test:unit": {
      "dependsOn": [],
      "env": [
        "TEST_COVERAGE"
      ],
      "affectedBy": [
        "darwin-kperf-codegen",
        "error-stack-macros"
      ]
    }
  }
}
