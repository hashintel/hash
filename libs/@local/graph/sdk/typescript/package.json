{
  "name": "@local/hash-graph-sdk",
  "version": "0.0.0-private",
  "private": true,
  "description": "SDK for the HASH Graph.",
  "license": "AGPL-3.0",
  "type": "module",
  "typesVersions": {
    "*": {
      "*": [
        "./dist/*.d.ts"
      ]
    }
  },
  "exports": {
    "./*": "./dist/*.js"
  },
  "scripts": {
    "build": "rimraf dist && tsc --build tsconfig.build.json",
    "fix:eslint": "eslint --fix .",
    "lint:eslint": "eslint --report-unused-disable-directives .",
    "lint:tsc": "tsc --noEmit",
    "test:unit": "vitest --run"
  },
  "dependencies": {
    "@blockprotocol/graph": "workspace:*",
    "@blockprotocol/type-system": "workspace:*",
    "@local/advanced-types": "workspace:*",
    "@local/harpc-client": "workspace:*",
    "@local/hash-graph-authorization": "workspace:*",
    "@local/hash-graph-client": "workspace:*",
    "@local/hash-graph-store": "workspace:*",
    "@temporalio/client": "1.20.2",
    "effect": "4.0.0-rc.118",
    "uuid": "14.0.0"
  },
  "devDependencies": {
    "@local/eslint": "workspace:*",
    "@local/tsconfig": "workspace:*",
    "@tsconfig/bases": "catalog:",
    "@vitest/coverage-istanbul": "catalog:",
    "eslint": "9.39.4",
    "rimraf": "6.1.3",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
