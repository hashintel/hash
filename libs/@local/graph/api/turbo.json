{
  "extends": ["//"],
  "tasks": {
    "build:openapi": {
      "command": ["cargo", "run", "--bin", "openapi-spec-generator"],
      "dependsOn": ["^manifest"],
      "outputs": ["openapi/openapi.json", "openapi/models/**"]
    },
    "doc:dependency-diagram": {
      "command": [
        "cargo",
        "run",
        "-p",
        "hash-repo-chores",
        "--",
        "dependency-diagram",
        "--output",
        "docs/dependency-diagram.mmd",
        "--root",
        "hash-graph-api",
        "--root-deps-and-dependents",
        "--link-mode",
        "non-roots",
        "--include-dev-deps",
        "--include-build-deps",
        "--logging-console-level",
        "info"
      ]
    },
    "fix:clippy": {
      "command": ["just", "clippy", "--fix"]
    },
    "lint:clippy": {
      "command": ["just", "clippy"]
    },
    "lint:openapi": {
      "command": [
        "git",
        "--no-pager",
        "diff",
        "--exit-code",
        "--color",
        "openapi"
      ],
      "dependsOn": ["build:openapi"],
      "cache": false
    },
    "test:unit": {
      "command": ["mise", "run", "test:unit", "@rust/hash-graph-api"],
      "dependsOn": ["^manifest", "lint:openapi"]
    }
  }
}
