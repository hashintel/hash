{
  "package": "hash-graph-api",
  "dependencies": [
    "error-stack",
    "harpc-client",
    "harpc-codec",
    "harpc-server",
    "harpc-system",
    "harpc-tower",
    "harpc-types",
    "hash-codec",
    "hash-graph-authentication",
    "hash-graph-authorization",
    "hash-graph-embeddings",
    "hash-graph-postgres-store",
    "hash-graph-store",
    "hash-graph-temporal-versioning",
    "hash-graph-type-fetcher",
    "hash-graph-types",
    "hash-graph-validation",
    "hash-middleware",
    "hash-status",
    "hash-temporal-client",
    "hashql-ast",
    "hashql-core",
    "hashql-diagnostics",
    "hashql-eval",
    "hashql-hir",
    "hashql-mir",
    "hashql-syntax-jexpr",
    "problematic",
    "type-system"
  ],
  "tasks": {
    "build:openapi": {
      "dependsOn": [],
      "affectedBy": [
        "darwin-kperf-codegen",
        "error-stack-macros"
      ]
    },
    "doc:dependency-diagram": {
      "dependsOn": [
        "hash-repo-chores#build"
      ],
      "cache": false,
      "affectedBy": [
        "error-stack-macros",
        "hash-repo-chores"
      ]
    },
    "fix:clippy": {
      "dependsOn": []
    },
    "lint:clippy": {
      "dependsOn": [],
      "env": [
        "GITHUB_EVENT_NAME"
      ],
      "affectedBy": [
        "darwin-kperf-codegen",
        "error-stack-macros"
      ]
    },
    "lint:openapi": {
      "dependsOn": [
        "build:openapi"
      ],
      "cache": false,
      "affectedBy": [
        "darwin-kperf-codegen",
        "error-stack-macros"
      ]
    },
    "test:unit": {
      "dependsOn": [
        "lint:openapi"
      ],
      "env": [
        "TEST_COVERAGE"
      ],
      "affectedBy": [
        "darwin-kperf-codegen",
        "error-stack-macros"
      ]
    }
  }
}
