{
  "components": {
    "responses": {
      "InternalServerError": {
        "content": {
          "application/problem+json": {
            "example": {
              "detail": "An internal error prevented the request from completing.",
              "status": 500,
              "title": "Internal Server Error",
              "type": "about:blank"
            },
            "schema": {
              "allOf": [
                {
                  "$ref": "#/components/schemas/ProblemDetails"
                },
                {
                  "properties": {
                    "status": {
                      "const": 500
                    },
                    "title": {
                      "const": "Internal Server Error"
                    },
                    "type": {
                      "const": "about:blank"
                    }
                  },
                  "required": [
                    "type"
                  ]
                }
              ],
              "title": "Internal Server Error"
            }
          }
        },
        "description": "An internal error prevented the request from completing."
      },
      "ServiceUnavailable": {
        "content": {
          "application/problem+json": {
            "example": {
              "detail": "authentication is temporarily unavailable",
              "status": 503,
              "title": "Service Unavailable",
              "type": "about:blank"
            },
            "schema": {
              "allOf": [
                {
                  "$ref": "#/components/schemas/ProblemDetails"
                },
                {
                  "properties": {
                    "status": {
                      "const": 503
                    },
                    "title": {
                      "const": "Service Unavailable"
                    },
                    "type": {
                      "const": "about:blank"
                    }
                  },
                  "required": [
                    "type"
                  ]
                }
              ],
              "title": "Service Unavailable"
            }
          }
        },
        "description": "Authentication is temporarily unavailable."
      },
      "TooManyRequests": {
        "content": {
          "application/problem+json": {
            "example": {
              "detail": "The request exceeded its rate-limit budget.",
              "status": 429,
              "title": "Too Many Requests",
              "type": "about:blank"
            },
            "schema": {
              "allOf": [
                {
                  "$ref": "#/components/schemas/ProblemDetails"
                },
                {
                  "properties": {
                    "status": {
                      "const": 429
                    },
                    "title": {
                      "const": "Too Many Requests"
                    },
                    "type": {
                      "const": "about:blank"
                    }
                  },
                  "required": [
                    "type"
                  ]
                }
              ],
              "title": "Too Many Requests"
            }
          }
        },
        "description": "The request exceeded its rate-limit budget.",
        "headers": {
          "Retry-After": {
            "description": "Whole seconds before retrying the request.",
            "required": true,
            "schema": {
              "format": "uint64",
              "minimum": 1,
              "type": "integer"
            },
            "style": "simple"
          }
        }
      },
      "Unauthorized": {
        "content": {
          "application/problem+json": {
            "example": {
              "detail": "no credentials provided",
              "status": 401,
              "title": "Unauthorized",
              "type": "about:blank"
            },
            "schema": {
              "allOf": [
                {
                  "$ref": "#/components/schemas/ProblemDetails"
                },
                {
                  "properties": {
                    "status": {
                      "const": 401
                    },
                    "title": {
                      "const": "Unauthorized"
                    },
                    "type": {
                      "const": "about:blank"
                    }
                  },
                  "required": [
                    "type"
                  ]
                }
              ],
              "title": "Unauthorized"
            }
          }
        },
        "description": "The request carries no credentials, or they do not identify a permitted caller.",
        "headers": {
          "WWW-Authenticate": {
            "description": "The scheme to authenticate with: `Session`, with `realm=\"HASH\"`.",
            "required": true,
            "schema": {
              "type": "string"
            },
            "style": "simple"
          }
        }
      }
    },
    "schemas": {
      "ActorId": {
        "description": "An actor's type and UUID.",
        "oneOf": [
          {
            "properties": {
              "actorType": {
                "const": "user",
                "type": "string"
              },
              "id": {
                "description": "The UUID of a user.",
                "format": "uuid",
                "type": "string"
              }
            },
            "required": [
              "actorType",
              "id"
            ],
            "title": "User",
            "type": "object"
          },
          {
            "properties": {
              "actorType": {
                "const": "machine",
                "type": "string"
              },
              "id": {
                "description": "The UUID of a machine actor.",
                "format": "uuid",
                "type": "string"
              }
            },
            "required": [
              "actorType",
              "id"
            ],
            "title": "Machine",
            "type": "object"
          },
          {
            "properties": {
              "actorType": {
                "const": "ai",
                "type": "string"
              },
              "id": {
                "description": "The UUID of an AI agent.",
                "format": "uuid",
                "type": "string"
              }
            },
            "required": [
              "actorType",
              "id"
            ],
            "title": "AI",
            "type": "object"
          }
        ]
      },
      "AuthenticatedCallerResponse": {
        "description": "The resolved caller.",
        "properties": {
          "actor": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ActorId"
              }
            ],
            "description": "The resolved actor."
          }
        },
        "required": [
          "actor"
        ],
        "type": "object"
      },
      "CallerResponse": {
        "description": "The resolved caller.",
        "properties": {
          "actor": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ActorId"
              },
              {
                "type": "null"
              }
            ],
            "description": "The resolved actor, or `null` for an anonymous request."
          }
        },
        "required": [
          "actor"
        ],
        "type": "object"
      },
      "ProblemDetails": {
        "properties": {
          "detail": {
            "description": "A human-readable explanation of this occurrence that helps the client correct the problem.",
            "type": "string"
          },
          "instance": {
            "description": "A URI reference identifying this occurrence.",
            "format": "uri-reference",
            "type": "string"
          },
          "status": {
            "description": "The HTTP status code sent with this occurrence.",
            "type": "integer"
          },
          "title": {
            "description": "A short, human-readable summary of the problem type.",
            "type": "string"
          },
          "type": {
            "default": "about:blank",
            "description": "A URI reference identifying the problem type.",
            "format": "uri-reference",
            "type": "string"
          }
        },
        "required": [
          "title",
          "status"
        ],
        "title": "Problem Details",
        "type": "object"
      }
    },
    "securitySchemes": {
      "sessionCookie": {
        "description": "Kratos browser session.",
        "in": "cookie",
        "name": "ory_kratos_session",
        "type": "apiKey"
      },
      "sessionToken": {
        "description": "Kratos session token.",
        "in": "header",
        "name": "X-Session-Token",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "description": "Errors use RFC 9457 Problem Details with the `application/problem+json` media type.\n\nReplacing `about:blank` with a specific problem type URI is a non-breaking change. Clients should handle unrecognized problem types using the HTTP status code.\n",
    "title": "Internal",
    "version": "unversioned"
  },
  "openapi": "3.1.0",
  "paths": {
    "/_api/authenticated-caller": {
      "get": {
        "operationId": "getAuthenticatedCaller",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthenticatedCallerResponse"
                }
              }
            },
            "description": "The resolved caller."
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          },
          "503": {
            "$ref": "#/components/responses/ServiceUnavailable"
          }
        },
        "security": [
          {
            "sessionToken": []
          },
          {
            "sessionCookie": []
          }
        ],
        "summary": "Get the authenticated caller",
        "tags": [
          "Caller"
        ]
      }
    },
    "/_api/caller": {
      "get": {
        "description": "Returns the resolved actor, or `actor: null` for an anonymous request.",
        "operationId": "getCaller",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CallerResponse"
                }
              }
            },
            "description": "The resolved caller."
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          },
          "503": {
            "$ref": "#/components/responses/ServiceUnavailable"
          }
        },
        "security": [
          {},
          {
            "sessionToken": []
          },
          {
            "sessionCookie": []
          }
        ],
        "summary": "Get the caller",
        "tags": [
          "Caller"
        ]
      }
    }
  }
}