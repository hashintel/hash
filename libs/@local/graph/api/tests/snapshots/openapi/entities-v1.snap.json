{
  "components": {
    "responses": {
      "BadRequest": {
        "content": {
          "application/problem+json": {
            "example": {
              "detail": "credentials are malformed",
              "status": 400,
              "title": "Bad Request",
              "type": "about:blank"
            },
            "schema": {
              "allOf": [
                {
                  "$ref": "#/components/schemas/ProblemDetails"
                },
                {
                  "properties": {
                    "status": {
                      "const": 400
                    },
                    "type": {
                      "const": "about:blank"
                    }
                  },
                  "required": [
                    "type"
                  ]
                }
              ]
            }
          }
        },
        "description": "The credentials are malformed."
      },
      "InternalServerError": {
        "content": {
          "application/problem+json": {
            "example": {
              "status": 500,
              "title": "Internal Server Error",
              "type": "about:blank"
            },
            "schema": {
              "allOf": [
                {
                  "$ref": "#/components/schemas/ProblemDetails"
                },
                {
                  "properties": {
                    "status": {
                      "const": 500
                    },
                    "type": {
                      "const": "about:blank"
                    }
                  },
                  "required": [
                    "type"
                  ]
                }
              ]
            }
          }
        },
        "description": "An internal error prevented the request from completing."
      },
      "ServiceUnavailable": {
        "content": {
          "application/problem+json": {
            "example": {
              "detail": "authentication is temporarily unavailable",
              "status": 503,
              "title": "Service Unavailable",
              "type": "about:blank"
            },
            "schema": {
              "allOf": [
                {
                  "$ref": "#/components/schemas/ProblemDetails"
                },
                {
                  "properties": {
                    "status": {
                      "const": 503
                    },
                    "type": {
                      "const": "about:blank"
                    }
                  },
                  "required": [
                    "type"
                  ]
                }
              ]
            }
          }
        },
        "description": "Authentication is temporarily unavailable. Retry later."
      },
      "TooManyRequests": {
        "content": {
          "application/problem+json": {
            "example": {
              "detail": "The request exceeded its rate-limit budget.",
              "status": 429,
              "title": "Too Many Requests",
              "type": "about:blank"
            },
            "schema": {
              "allOf": [
                {
                  "$ref": "#/components/schemas/ProblemDetails"
                },
                {
                  "properties": {
                    "status": {
                      "const": 429
                    },
                    "type": {
                      "const": "about:blank"
                    }
                  },
                  "required": [
                    "type"
                  ]
                }
              ]
            }
          }
        },
        "description": "The request exceeded its rate-limit budget.",
        "headers": {
          "Retry-After": {
            "description": "Whole seconds before retrying the request.",
            "required": true,
            "schema": {
              "format": "uint64",
              "minimum": 1,
              "type": "integer"
            },
            "style": "simple"
          }
        }
      },
      "Unauthorized": {
        "content": {
          "application/problem+json": {
            "example": {
              "detail": "no credentials provided",
              "status": 401,
              "title": "Unauthorized",
              "type": "about:blank"
            },
            "schema": {
              "allOf": [
                {
                  "$ref": "#/components/schemas/ProblemDetails"
                },
                {
                  "properties": {
                    "status": {
                      "const": 401
                    },
                    "type": {
                      "const": "about:blank"
                    }
                  },
                  "required": [
                    "type"
                  ]
                }
              ]
            }
          }
        },
        "description": "The request carries no credentials, or they do not identify a permitted caller."
      }
    },
    "schemas": {
      "ActorId": {
        "description": "An actor's type and UUID.",
        "oneOf": [
          {
            "properties": {
              "actorType": {
                "const": "user",
                "type": "string"
              },
              "id": {
                "description": "The UUID of a user.",
                "format": "uuid",
                "type": "string"
              }
            },
            "required": [
              "actorType",
              "id"
            ],
            "title": "User",
            "type": "object"
          },
          {
            "properties": {
              "actorType": {
                "const": "machine",
                "type": "string"
              },
              "id": {
                "description": "The UUID of a machine actor.",
                "format": "uuid",
                "type": "string"
              }
            },
            "required": [
              "actorType",
              "id"
            ],
            "title": "Machine",
            "type": "object"
          },
          {
            "properties": {
              "actorType": {
                "const": "ai",
                "type": "string"
              },
              "id": {
                "description": "The UUID of an AI agent.",
                "format": "uuid",
                "type": "string"
              }
            },
            "required": [
              "actorType",
              "id"
            ],
            "title": "AI",
            "type": "object"
          }
        ]
      },
      "AuthenticatedCallerResponse": {
        "description": "The resolved caller.",
        "properties": {
          "actor": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ActorId"
              }
            ],
            "description": "The resolved actor."
          }
        },
        "required": [
          "actor"
        ],
        "type": "object"
      },
      "CallerResponse": {
        "description": "The resolved caller.",
        "properties": {
          "actor": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ActorId"
              },
              {
                "type": "null"
              }
            ],
            "description": "The resolved actor, or `null` for an anonymous request."
          }
        },
        "required": [
          "actor"
        ],
        "type": "object"
      },
      "ProblemDetails": {
        "description": "An RFC 9457 problem details object with problem-specific extension members.\n\nSerialization includes `type`, `title`, and `status`, plus `detail` and `instance` when\nsupplied.",
        "properties": {
          "detail": {
            "description": "A human-readable explanation of this occurrence that helps the client correct the problem.\nUse extension members for structured information.",
            "type": "string"
          },
          "instance": {
            "description": "A URI reference identifying this occurrence. It may identify the occurrence without\nresolving to further information.",
            "format": "uri-reference",
            "type": "string"
          },
          "status": {
            "description": "The HTTP status code sent with this occurrence.",
            "type": "integer"
          },
          "title": {
            "description": "A short, human-readable summary of the problem type. Keep it the same across occurrences,\nexcept for localization.",
            "type": "string"
          },
          "type": {
            "default": "about:blank",
            "description": "A URI reference identifying the problem type. Use `about:blank` when the HTTP status code\nfully describes the problem type. If `type` is omitted during deserialization, it defaults\nto `about:blank`.",
            "format": "uri-reference",
            "type": "string"
          }
        },
        "required": [
          "title",
          "status"
        ],
        "title": "Problem Details",
        "type": "object"
      }
    },
    "securitySchemes": {
      "cloudflareAccess": {
        "description": "Cloudflare Access JWT, when configured.",
        "in": "header",
        "name": "Cf-Access-Jwt-Assertion",
        "type": "apiKey"
      },
      "delegatedActor": {
        "description": "Delegated actor UUID, used with the service credential. The nil UUID resolves as anonymous.",
        "in": "header",
        "name": "X-Authenticated-User-Actor-Id",
        "type": "apiKey"
      },
      "serviceSecret": {
        "description": "Enter the complete Authorization header value: `HASH-Service <secret>`. Include the `HASH-Service` prefix; the client sends this value unchanged. Requires the `X-Authenticated-User-Actor-Id` header to name the delegated actor.",
        "in": "header",
        "name": "authorization",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "description": "Errors use RFC 9457 Problem Details with the `application/problem+json` media type.\n\nReplacing `about:blank` with a specific problem type URI is a non-breaking change. Clients should handle unrecognized problem types using the HTTP status code.\n",
    "title": "Entities",
    "version": "1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/entities/v1/authenticated-caller": {
      "get": {
        "operationId": "getAuthenticatedCaller",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthenticatedCallerResponse"
                }
              }
            },
            "description": "The resolved caller."
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          },
          "503": {
            "$ref": "#/components/responses/ServiceUnavailable"
          }
        },
        "security": [
          {
            "cloudflareAccess": []
          },
          {
            "delegatedActor": [],
            "serviceSecret": []
          }
        ],
        "summary": "Get the authenticated caller",
        "tags": [
          "Caller"
        ]
      }
    },
    "/entities/v1/caller": {
      "get": {
        "description": "Returns the resolved actor, or `actor: null` for an anonymous request.",
        "operationId": "getCaller",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CallerResponse"
                }
              }
            },
            "description": "The resolved caller."
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          },
          "503": {
            "$ref": "#/components/responses/ServiceUnavailable"
          }
        },
        "security": [
          {},
          {
            "cloudflareAccess": []
          },
          {
            "delegatedActor": [],
            "serviceSecret": []
          }
        ],
        "summary": "Get the caller",
        "tags": [
          "Caller"
        ]
      }
    }
  }
}