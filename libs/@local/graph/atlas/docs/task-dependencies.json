{
  "package": "hash-graph-atlas",
  "dependencies": [
    "darwin-kperf-criterion",
    "darwin-kperf-events",
    "error-stack",
    "hash-graph-authorization",
    "hash-graph-embeddings",
    "hash-graph-postgres-store",
    "hash-graph-store",
    "hash-graph-temporal-versioning",
    "hash-graph-types",
    "hash-middleware",
    "hash-temporal-client",
    "hashql-core",
    "type-system"
