  "tasks": {
    "build:docker": {
      "dependsOn": [],
      "cache": false,
      "affectedBy": [
        "darwin-kperf-codegen",
        "error-stack-macros"
      ]
    },
    "doc:dependency-diagram": {
      "dependsOn": [
        "hash-repo-chores#build"
      ],
      "cache": false,
      "affectedBy": [
        "error-stack-macros",
        "hash-repo-chores"
      ]
    },
    "fix:clippy": {
      "dependsOn": []
    },
    "lint:clippy": {
      "dependsOn": [],
      "env": [
        "GITHUB_EVENT_NAME"
      ],
      "affectedBy": [
        "darwin-kperf-codegen",
        "error-stack-macros"
      ]
    },
    "test:integration": {
      "dependsOn": [],
      "env": [
        "TEST_COVERAGE"
      ],
      "affectedBy": [
        "darwin-kperf-codegen",
        "error-stack-macros"
      ]
    },
    "test:miri": {
      "dependsOn": [],
      "affectedBy": [
        "darwin-kperf-codegen",
        "error-stack-macros"
      ]
    },
    "test:unit": {
      "dependsOn": [],
      "env": [
        "TEST_COVERAGE"
      ],
      "affectedBy": [
        "darwin-kperf-codegen",
        "error-stack-macros"
      ]
    }
  }
}
