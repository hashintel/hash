---
source: libs/@local/graph/atlas/src/postgres/link_display.rs
expression: statement.sql
---
WITH "requests" AS (SELECT "meta"."web_id" AS "web_id", "meta"."entity_uuid" AS "entity_uuid", "meta"."entity_edition_id" AS "entity_edition_id"
FROM UNNEST(($3::uuid[]), ($4::uuid[])) AS "request"("web_id", "entity_uuid")
INNER JOIN "entity_temporal_metadata" AS "meta"
  ON "meta"."web_id" = "request"."web_id"
 AND "meta"."entity_uuid" = "request"."entity_uuid"
 AND "meta"."draft_id" IS NULL
 AND "meta"."transaction_time" @> $1::TIMESTAMPTZ
 AND "meta"."decision_time" @> $2::TIMESTAMPTZ
INNER JOIN "entity_editions" AS "edition"
  ON "edition"."entity_edition_id" = "meta"."entity_edition_id"
 AND NOT("edition"."archived"))
SELECT "requests"."web_id", "requests"."entity_uuid", ("cache"."labels")[1], ("cache"."versioned_urls")[1]
FROM "requests"
LEFT OUTER JOIN "entity_edition_cache" AS "cache"
  ON "cache"."entity_edition_id" = "requests"."entity_edition_id"
