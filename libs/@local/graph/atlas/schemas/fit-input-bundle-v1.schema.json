{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FitInputBundleV1",
  "description": "Externally maintained classifier, policy, governance, and companion inputs.",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "description": "Public bundle schema version.",
      "type": "integer",
      "format": "uint32",
      "minimum": 1,
      "maximum": 1
    },
    "manifest": {
      "description": "Non-generated claims that SALT cannot infer from artifacts.",
      "$ref": "#/$defs/FitManifestContractV1"
    },
    "relationPolicyInputs": {
      "description": "Per-relation policy matrix and card embeddings.",
      "$ref": "#/$defs/FitInputReferenceV1"
    },
    "classifier": {
      "description": "Complete serialized SALT relation classifier.",
      "$ref": "#/$defs/FitInputReferenceV1"
    },
    "strengthHead": {
      "description": "Optional fitted strength head; unsupported by `m0-local-v1`.",
      "anyOf": [
        {
          "$ref": "#/$defs/FitInputReferenceV1"
        },
        {
          "type": "null"
        }
      ]
    },
    "relationPolicyReport": {
      "description": "Independent relation-policy evaluation report.",
      "$ref": "#/$defs/FitInputReferenceV1"
    },
    "securityApprovalReport": {
      "description": "Operator-owned security approval report.",
      "$ref": "#/$defs/FitInputReferenceV1"
    },
    "companion": {
      "description": "Pinned legacy-canvas companion bytes.",
      "$ref": "#/$defs/FitInputReferenceV1"
    },
    "companionCompatibilityReport": {
      "description": "Independent compatibility report for the companion.",
      "$ref": "#/$defs/FitInputReferenceV1"
    }
  },
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "manifest",
    "relationPolicyInputs",
    "classifier",
    "relationPolicyReport",
    "securityApprovalReport",
    "companion",
    "companionCompatibilityReport"
  ],
  "$defs": {
    "FitManifestContractV1": {
      "description": "Non-generated manifest claims supplied by the fit input bundle.",
      "type": "object",
      "properties": {
        "embedding": {
          "description": "Embedding producer claims supplied by the embedding pipeline.",
          "$ref": "#/$defs/FitEmbeddingContractV1"
        },
        "relations": {
          "description": "Relation governance claims supplied by classifier evaluation.",
          "$ref": "#/$defs/FitRelationContractV1"
        },
        "serving": {
          "description": "Reader and companion compatibility claims.",
          "$ref": "#/$defs/FitServingContractV1"
        }
      },
      "additionalProperties": false,
      "required": ["embedding", "relations", "serving"]
    },
    "FitEmbeddingContractV1": {
      "description": "Embedding-producer provenance that cannot be inferred from pgvector rows.",
      "type": "object",
      "properties": {
        "model": {
          "description": "Stable provider/model identity for all selected entity embeddings.",
          "type": "string",
          "minLength": 1
        },
        "producerContractHash": {
          "description": "Content identity of the producer's dimensional and normalization contract.",
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false,
      "required": ["model", "producerContractHash"]
    },
    "FitRelationContractV1": {
      "description": "Externally governed relation-classifier and annotation provenance.",
      "type": "object",
      "properties": {
        "relationCardCorpusHash": {
          "description": "Content identity of the relation-card corpus used for fitting.",
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "annotationCorpusHash": {
          "description": "Content identity of the classifier annotation corpus.",
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "annotationPromptFamilyVersion": {
          "description": "Version of the prompt family used to collect annotations.",
          "type": "string",
          "minLength": 1
        },
        "annotationVoteSchedule": {
          "description": "Human-readable identity of the independent-vote schedule.",
          "type": "string",
          "minLength": 1
        },
        "reviewedHoldoutHash": {
          "description": "Content identity of the independently reviewed holdout.",
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "policyPrecedenceVersion": {
          "description": "Rule version governing policy/classifier precedence.",
          "type": "string",
          "minLength": 1
        },
        "classifierVersion": {
          "description": "Stable relation-classifier family version.",
          "type": "string",
          "minLength": 1
        },
        "classPrior": {
          "description": "Optional coincident/proximal/overlay class prior.",
          "type": ["array", "null"],
          "items": {
            "type": "number",
            "format": "double"
          },
          "minItems": 3,
          "maxItems": 3
        },
        "applicabilityMethodVersion": {
          "description": "Stable version of the applicability computation.",
          "type": "string",
          "minLength": 1
        },
        "applicabilityConfigHash": {
          "description": "Content identity of the applicability configuration.",
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "classifierOodEdgeVolumeFraction": {
          "description": "Fraction of relation-edge volume classified out of distribution.",
          "type": "number",
          "format": "double",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "reviewedEdgeVolumeFraction": {
          "description": "Fraction of relation-edge volume covered by reviewed examples.",
          "type": "number",
          "format": "double",
          "minimum": 0.0,
          "maximum": 1.0
        }
      },
      "additionalProperties": false,
      "required": [
        "relationCardCorpusHash",
        "annotationCorpusHash",
        "annotationPromptFamilyVersion",
        "annotationVoteSchedule",
        "reviewedHoldoutHash",
        "policyPrecedenceVersion",
        "classifierVersion",
        "applicabilityMethodVersion",
        "applicabilityConfigHash",
        "classifierOodEdgeVolumeFraction",
        "reviewedEdgeVolumeFraction"
      ]
    },
    "FitServingContractV1": {
      "description": "Wire and companion contracts required by verified readers.",
      "type": "object",
      "properties": {
        "authorizationAdapterVersion": {
          "description": "Version of the authorization adapter expected by external reports.",
          "type": "string",
          "minLength": 1
        },
        "wireVersions": {
          "description": "Sorted, unique wire versions accepted by serving clients.",
          "type": "array",
          "items": {
            "type": "integer",
            "format": "uint16",
            "minimum": 0,
            "maximum": 65535
          },
          "minItems": 1,
          "maxItems": 16
        },
        "styleVersion": {
          "description": "Stable style contract version.",
          "type": "string",
          "minLength": 1
        },
        "canvasCompanionVersion": {
          "description": "Version of the pinned legacy-canvas companion.",
          "type": "string",
          "minLength": 1
        },
        "shaderContractVersion": {
          "description": "Stable shader input/output contract version.",
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "authorizationAdapterVersion",
        "wireVersions",
        "styleVersion",
        "canvasCompanionVersion",
        "shaderContractVersion"
      ]
    },
    "FitInputReferenceV1": {
      "description": "Content-addressed path beneath the configured input root.",
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false,
      "required": ["path", "sha256"]
    }
  }
}
