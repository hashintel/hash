{
  "extends": ["//"],
  "tasks": {
    "build": {
      "outputs": ["./dist/**"]
    },
    // The spec is read from its checked-in copy. `@rust/hash-graph-api#build:openapi`
    // writes it and that package's `test:unit` diffs it, so depending on the task
    // here would only add a Graph API compile to every consumer's build.
    "codegen": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "../../api/openapi/openapi.json",
        "../../api/openapi/models/**"
      ],
      "outputs": [
        ".npmignore",
        "api.ts",
        "base.ts",
        "common.ts",
        "configuration.ts",
        "git_push.sh",
        "index.ts",
        "openapi.json"
      ]
    }
  }
}
