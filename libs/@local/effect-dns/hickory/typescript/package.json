{
  "name": "@local/effect-dns-hickory",
  "version": "0.0.0-private",
  "private": true,
  "description": "Hickory DNS implementation of DNS effect library",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "rimraf dist && yarn build:release && tsc --build tsconfig.build.json",
    "build:debug": "napi build --platform --manifest-path ../rust/Cargo.toml --js=impl.js --dts=impl.d.ts -o dist",
    "build:release": "napi build --platform --release --manifest-path ../rust/Cargo.toml --js=impl.js --dts=impl.d.ts -o dist",
    "fix:eslint": "eslint --fix .",
    "lint:eslint": "eslint --report-unused-disable-directives .",
    "lint:tsc": "tsc --noEmit",
    "regenerate-packages": "napi create-npm-dirs",
    "test:unit": "vitest --run"
  },
  "devDependencies": {
    "@local/eslint": "workspace:*",
    "@local/tsconfig": "workspace:*",
    "@tsconfig/bases": "catalog:",
    "@vitest/coverage-istanbul": "catalog:",
    "eslint": "9.39.4",
    "rimraf": "6.1.3",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "napi": {
    "binaryName": "effect-dns-hickory",
    "targets": [
      "x86_64-unknown-linux-gnu",
      "x86_64-pc-windows-msvc",
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "aarch64-unknown-linux-gnu",
      "aarch64-unknown-linux-musl",
      "aarch64-pc-windows-msvc"
    ]
  }
}
