{
  "$schema": "https://turborepo.org/schema.json",
  "extends": ["//"],
  "tasks": {
    "manifest": {
      "dependsOn": ["^manifest", "effect-dns-hickory#manifest"]
    },
    "build": {
      "dependsOn": ["^build", "effect-dns-hickory#manifest"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "../rust/src/**",
        "../rust/build.rs",
        "../rust/Cargo.toml"
      ],
      "outputs": ["./dist/**"]
    },
    "test:unit": {
      "dependsOn": ["build"]
    },
    "lint:eslint": {
      "dependsOn": ["build"]
    },
    "lint:tsc": {
      "dependsOn": ["build"]
    }
  }
}
