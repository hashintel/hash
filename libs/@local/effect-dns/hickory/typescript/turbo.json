{
  "$schema": "https://turborepo.org/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "inputs": ["$TURBO_DEFAULT$", "../rust/src/**", "../rust/Cargo.toml"],
      "outputs": ["./dist/**"]
    },
    "test:unit": {
      "dependsOn": ["build"]
    },
    "lint:eslint": {
      "dependsOn": ["build"]
    },
    "lint:tsc": {
      "dependsOn": ["build"]
    }
  }
}
