{
  "package": "@rust/hash-repo-chores",
  "dependencies": [
    "@rust/error-stack",
    "@rust/hash-telemetry"
  ],
  "tasks": {
    "analyze-benchmarks": {
      "dependsOn": [
        "build"
      ],
      "cache": false
    },
    "build": {
      "dependsOn": [],
      "cache": false
    },
    "doc:dependency-diagram": {
      "dependsOn": [
        "build"
      ],
      "cache": false
    },
    "fix:clippy": {
      "dependsOn": []
    },
    "lint:clippy": {
      "dependsOn": [],
      "env": [
        "GITHUB_EVENT_NAME"
      ]
    },
    "upload-benchmarks": {
      "dependsOn": [
        "build"
      ],
      "cache": false
    }
  }
}
