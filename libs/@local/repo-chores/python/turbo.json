{
  "extends": ["//"],
  "tasks": {
    "lint:tach": {
      "passThroughEnv": ["UV_CACHE_DIR"],
      "command": [
        "uv",
        "run",
        "--active",
        "--frozen",
        "--all-packages",
        "tach",
        "check"
      ]
    },
    "lint:deptry": {
      "command": [
        "uv",
        "run",
        "--active",
        "--frozen",
        "--all-packages",
        "deptry",
        "src"
      ],
      "passThroughEnv": ["UV_CACHE_DIR"]
    },
    "lint:constraints": {
      "command": [
        "uv",
        "run",
        "--frozen",
        "--isolated",
        "--no-dev",
        "--package",
        "repo-chores",
        "python",
        "-m",
        "repo_chores",
        "constraints"
      ],
      "cache": false,
      // Workspace policies also inspect other members' manifests and the presence of
      // their source, test and license files.
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/**/pyproject.toml",
        "$TURBO_ROOT$/uv.lock",
        "$TURBO_ROOT$/**/LICENSE*.md",
        "$TURBO_ROOT$/.github/licenses/**",
        "$TURBO_ROOT$/**/src/**",
        "$TURBO_ROOT$/**/tests/**"
      ],
      "passThroughEnv": ["UV_CACHE_DIR"]
    },
    "fix:constraints": {
      "command": [
        "uv",
        "run",
        "--frozen",
        "--isolated",
        "--no-dev",
        "--package",
        "repo-chores",
        "python",
        "-m",
        "repo_chores",
        "constraints",
        "--fix"
      ],
      "cache": false,
      "passThroughEnv": ["UV_CACHE_DIR"]
    },
    "test:unit": {
      "dependsOn": ["^manifest"],
      "env": [
        "$TURBO_EXTENDS$",
        "PYTHONHOME",
        "PYTHONPATH",
        "UV_BUILD_CONSTRAINT",
        "UV_COMPILE_BYTECODE",
        "UV_CONFIG_FILE",
        "UV_CONSTRAINT",
        "UV_ENV_FILE",
        "UV_EXCLUDE",
        "UV_FORK_STRATEGY",
        "UV_GIT_LFS",
        "UV_ISOLATED",
        "UV_LINK_MODE",
        "UV_NO_BINARY",
        "UV_NO_BINARY_PACKAGE",
        "UV_NO_BUILD",
        "UV_NO_BUILD_ISOLATION",
        "UV_NO_BUILD_ISOLATION_PACKAGE",
        "UV_NO_BUILD_PACKAGE",
        "UV_NO_CONFIG",
        "UV_NO_DEFAULT_GROUPS",
        "UV_NO_DEV",
        "UV_NO_EDITABLE",
        "UV_NO_ENV_FILE",
        "UV_NO_GROUP",
        "UV_NO_PROJECT",
        "UV_NO_SOURCES",
        "UV_NO_SOURCES_PACKAGE",
        "UV_NO_SYNC",
        "UV_NO_SYSTEM_CONFIG",
        "UV_OFFLINE",
        "UV_OVERRIDE",
        "UV_PROJECT",
        "UV_PROJECT_ENVIRONMENT",
        "UV_WORKING_DIR",
        "VIRTUAL_ENV"
      ],
      "passThroughEnv": [
        "$TURBO_EXTENDS$",
        "PIP_EXTRA_INDEX_URL",
        "PIP_INDEX_URL",
        "UV_CACHE_DIR",
        "UV_DEFAULT_INDEX",
        "UV_EXCLUDE_NEWER",
        "UV_EXTRA_INDEX_URL",
        "UV_FIND_LINKS",
        "UV_INDEX",
        "UV_INDEX_STRATEGY",
        "UV_INDEX_URL",
        "UV_INSECURE_HOST",
        "UV_MANAGED_PYTHON",
        "UV_NO_MANAGED_PYTHON",
        "UV_PRERELEASE",
        "UV_PYTHON",
        "UV_PYTHON_DOWNLOADS",
        "UV_PYTHON_PREFERENCE",
        "UV_RESOLUTION",
        "UV_SYSTEM_CERTS",
        "XDG_CONFIG_HOME"
      ],
      "command": [
        "uv",
        "run",
        "--active",
        "--frozen",
        "--all-packages",
        "pytest",
        "."
      ]
    }
  }
}
