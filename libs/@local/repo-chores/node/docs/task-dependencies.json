{
  "package": "@local/repo-chores",
  "dependencies": [
    "@local/eslint",
    "@local/hash-backend-utils",
    "@local/hash-isomorphic-utils",
    "@local/tsconfig"
  ],
  "tasks": {
    "fix:eslint": {
      "dependsOn": [
        "@local/eslint#build",
        "@local/hash-backend-utils#build",
        "@local/hash-isomorphic-utils#build"
      ],
      "affectedBy": [
        "error-stack",
        "error-stack-macros",
        "harpc-types",
        "harpc-wire-protocol",
        "hash-codec",
        "hash-codegen",
        "hash-graph-api",
        "hash-graph-authorization",
        "hash-graph-store",
        "hash-graph-temporal-versioning",
        "hash-graph-types",
        "hash-temporal-client",
        "type-system"
      ]
    },
    "lint:eslint": {
      "dependsOn": [
        "@local/eslint#build",
        "@local/hash-backend-utils#build",
        "@local/hash-isomorphic-utils#build"
      ],
      "env": [
        "CHECK_TEMPORARILY_DISABLED_RULES"
      ],
      "affectedBy": [
        "error-stack",
        "error-stack-macros",
        "harpc-types",
        "harpc-wire-protocol",
        "hash-codec",
        "hash-codegen",
        "hash-graph-api",
        "hash-graph-authorization",
        "hash-graph-store",
        "hash-graph-temporal-versioning",
        "hash-graph-types",
        "hash-temporal-client",
        "type-system"
      ]
    },
    "lint:tsc": {
      "dependsOn": [
        "@local/eslint#build",
        "@local/hash-backend-utils#build",
        "@local/hash-isomorphic-utils#build"
      ],
      "affectedBy": [
        "error-stack",
        "error-stack-macros",
        "harpc-types",
        "harpc-wire-protocol",
        "hash-codec",
        "hash-codegen",
        "hash-graph-api",
        "hash-graph-authorization",
        "hash-graph-store",
        "hash-graph-temporal-versioning",
        "hash-graph-types",
        "hash-temporal-client",
        "type-system"
      ]
    },
    "test:unit": {
      "dependsOn": [
        "@local/eslint#build",
        "@local/hash-backend-utils#build",
        "@local/hash-isomorphic-utils#build"
      ],
      "env": [
        "TEST_COVERAGE"
      ],
      "affectedBy": [
        "error-stack",
        "error-stack-macros",
        "harpc-types",
        "harpc-wire-protocol",
        "hash-codec",
        "hash-codegen",
        "hash-graph-api",
        "hash-graph-authorization",
        "hash-graph-store",
        "hash-graph-temporal-versioning",
        "hash-graph-types",
        "hash-temporal-client",
        "type-system"
      ]
    }
  }
}
