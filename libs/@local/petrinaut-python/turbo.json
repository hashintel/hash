{
  "extends": ["//"],
  "tasks": {
    "lint:types": {
      "command": [
        "uv",
        "run",
        "--active",
        "--frozen",
        "--all-packages",
        "basedpyright"
      ],
      "passThroughEnv": ["UV_CACHE_DIR"],
      "dependsOn": ["codegen"]
    },
    "lint:ruff": {
      "command": [
        "uv",
        "run",
        "--active",
        "--frozen",
        "--all-packages",
        "ruff",
        "check",
        "."
      ],
      "passThroughEnv": ["UV_CACHE_DIR"]
    },
    "format:ruff": {
      "command": [
        "uv",
        "run",
        "--active",
        "--frozen",
        "--all-packages",
        "ruff",
        "format",
        "."
      ],
      "passThroughEnv": ["UV_CACHE_DIR"]
    },
    "manifest": {
      "dependsOn": ["^manifest", "@hashintel/petrinaut-cli#manifest"]
    },
    "codegen": {
      "command": ["./scripts/generate-models.sh"],
      "dependsOn": [
        "manifest",
        "@hashintel/petrinaut-cli#codegen",
        "@hashintel/petrinaut-cli#manifest"
      ],
      "inputs": ["scripts/generate-models.sh"],
      "outputs": ["src/petrinaut/models.py"],
      "passThroughEnv": ["UV_CACHE_DIR"]
    },
    "test": {
      "dependsOn": ["codegen", "manifest", "@hashintel/petrinaut-cli#build"]
    },
    "test:unit": {
      "dependsOn": ["codegen", "manifest", "@hashintel/petrinaut-cli#build"],
      "passThroughEnv": ["UV_CACHE_DIR"],
      "command": [
        "uv",
        "run",
        "--active",
        "--frozen",
        "--all-packages",
        "pytest",
        "."
      ]
    }
  }
}
