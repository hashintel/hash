{
  "extends": ["@tsconfig/bases/recommended", "./policy.json"],
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "lib": ["dom", "ESNext"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "target": "ES2021"
  }
}
