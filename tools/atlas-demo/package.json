{
  "name": "atlas-demo",
  "version": "0.0.0-private",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "fix:format": "oxfmt --write .",
    "lint": "yarn lint:format && yarn lint:eslint && yarn lint:tsc",
    "lint:eslint": "oxlint --type-aware --report-unused-disable-directives-severity=error .",
    "lint:format": "oxfmt --check .",
    "lint:tsc": "tsc --noEmit",
    "preview": "vite preview",
    "test:unit": "vitest run",
    "verify": "yarn lint && yarn test:unit && yarn build"
  },
  "dependencies": {
    "@deck.gl/core": "9.3.4",
    "@deck.gl/layers": "9.3.4",
    "@deck.gl/react": "9.3.4",
    "@luma.gl/core": "9.3.5",
    "@luma.gl/engine": "9.3.5",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.1",
    "oxfmt": "0.50.0",
    "oxlint": "1.63.0",
    "oxlint-tsgolint": "0.22.1",
    "typescript": "6.0.3",
    "vite": "8.1.0",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=22.21.0"
  },
  "packageManager": "yarn@4.16.0"
}
