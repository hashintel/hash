{
  "name": "salt-adjudicator",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.ts",
    "test": "yarn test:unit && yarn test:ui",
    "test:ui": "vitest run --passWithNoTests",
    "test:unit": "node --test test/*.test.ts",
    "typecheck": "tsc --project tsconfig.json",
    "verify": "yarn build && yarn typecheck && yarn test"
  },
  "dependencies": {
    "preact": "10.29.6",
    "typescript": "6.0.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@testing-library/preact": "3.2.4",
    "@types/node": "26.1.1",
    "esbuild": "0.28.1",
    "happy-dom": "20.10.6",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=22.21.0"
  },
  "packageManager": "yarn@4.16.0"
}
